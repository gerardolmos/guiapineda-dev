                        {text.prototype}
                    </div>
                </div>
            </section>
        </div>
    </section>
</div>

<script>
    import { initMilloraSubmissionFlow } from "../lib/milloraSubmissionFlow";

    initMilloraSubmissionFlow();
</script>
