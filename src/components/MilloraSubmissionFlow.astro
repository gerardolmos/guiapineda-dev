                        class="aspect-[16/9] overflow-hidden bg-slate-100"
                    >
                        <img
                            id="millora-live-image"
                            alt=""
                            class="size-full object-cover"
                        />
                    </div>

                    <div class="p-5">
                        <div class="flex flex-wrap gap-2">
                            <span
                                id="millora-live-category"
                                class="rounded-full bg-amber-50 px-3 py-1 text-xs font-black text-amber-800"
                            ></span>

                            <span
                                id="millora-live-zone"
                                class="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-600"
                            ></span>
                        </div>

                        <p
                            id="millora-live-author"
                            class="mt-4 text-xs font-black uppercase tracking-[0.12em] text-sky-700"
                        ></p>

                        <h2
                            id="millora-live-title"
                            class="mt-2 text-2xl font-black leading-tight text-slate-950"
                        >
                            {text.previewEmptyTitle}
                        </h2>

                        <p
                            id="millora-live-summary"
                            class="mt-3 text-sm leading-6 text-slate-600"
                        >
                            {text.previewEmptySummary}
                        </p>

                        <p class="mt-5 text-xs font-bold text-slate-400">
                            <span id="millora-live-reading">1</span>
                            {" "}
                            {text.readingSuffix}
                        </p>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <!-- ====================================================
         PASO 3
         ==================================================== -->

    <section
        id="millora-step-review"
        hidden
        class="px-5 py-10 sm:px-8 sm:py-14"
    >
        <div class="mx-auto max-w-5xl">
            <div class="mb-8 flex items-center justify-between gap-5">
                <div>
                    <p
                        class="text-sm font-black uppercase tracking-[0.18em] text-emerald-700"
                    >
                        {text.eyebrow}
                    </p>

                    <p class="mt-2 font-bold text-slate-500">
                        {text.section3}
                    </p>
                </div>

                <div class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="h-2 w-5 rounded-full bg-sky-500"></span>
                    <span class="h-2 w-5 rounded-full bg-fuchsia-500"></span>
                    <span class="h-2 w-10 rounded-full bg-emerald-500"></span>
                </div>
            </div>

            <div
