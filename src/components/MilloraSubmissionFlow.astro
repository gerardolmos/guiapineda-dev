                                    class="rounded-full bg-amber-50 px-3 py-1 text-xs font-black text-amber-800"
                                ></span>

                                <span
                                    id="millora-review-zone"
                                    class="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-600"
                                ></span>
                            </div>

                            <p
                                id="millora-review-author"
                                class="mt-3 font-black text-sky-800"
                            ></p>
                        </div>

                        <button
                            type="button"
                            data-millora-edit="context"
                            class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:bg-slate-50"
                        >
                            {text.editContext}
                        </button>
                    </div>

                    <div class="mt-8 border-t border-slate-200 pt-8">
                        <div
                            class="flex flex-wrap items-start justify-between gap-4"
                        >
                            <div class="max-w-3xl">
                                <h1
                                    id="millora-review-heading"
                                    tabindex="-1"
                                    class="text-3xl font-black leading-tight tracking-tight sm:text-4xl"
                                >
                                    {text.step3Title}
                                </h1>

                                <p class="mt-2 text-slate-500">
                                    {text.step3Intro}
                                </p>

                                <h2
                                    id="millora-review-title"
                                    class="mt-8 text-3xl font-black leading-tight tracking-tight"
                                ></h2>

                                <p
                                    id="millora-review-summary"
                                    class="mt-4 text-lg leading-8 text-slate-600"
                                ></p>
                            </div>

                            <button
                                type="button"
                                data-millora-edit="content"
                                class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 transition hover:bg-slate-50"
                            >
                                {text.editContent}
                            </button>
                        </div>

                        <div
                            id="millora-review-content"
                            class="mt-8 whitespace-pre-line border-t border-slate-200 pt-7 leading-8 text-slate-700"
                        ></div>

                        <p class="mt-6 text-sm font-bold text-slate-500">
                            <span id="millora-review-reading">1</span>
                            {" "}
                            {text.readingSuffix}
                        </p>
                    </div>
                </div>
            </div>

            <section
                class="mt-8 overflow-hidden rounded-[2rem] border border-amber-300 bg-white shadow-md"
            >
                <div
                    class="border-b border-amber-200 bg-gradient-to-r from-amber-100 via-orange-50 to-amber-50 px-6 py-5 sm:px-8 sm:py-6"
                >
                    <div class="flex items-start gap-4">
                        <div
                            aria-hidden="true"
                            class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-amber-500 text-xl font-black text-white shadow-sm"
                        >
                            !
                        </div>

                        <div>
                            <h2 class="text-2xl font-black tracking-tight text-amber-950 sm:text-3xl">
                                {text.rulesTitle}
                            </h2>

                            <p class="mt-1.5 max-w-3xl text-base font-semibold leading-7 text-amber-900 sm:text-lg">
                                {text.rulesIntro}
                            </p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-5 sm:px-8 sm:py-6">
                    <ul class="grid gap-2.5">
                        {
                            text.rules.map((rule, index) => (
                                <li
                                    class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-stone-50 px-4 py-3.5 sm:px-5 sm:py-4"
                                >
                                    <span
                                        aria-hidden="true"
                                        class="flex size-8 shrink-0 items-center justify-center rounded-full bg-amber-500 text-xs font-black text-white"
                                    >
                                        {String(index + 1).padStart(2, "0")}
                                    </span>

                                    <span class="text-base font-semibold leading-6 text-slate-800">
                                        {rule}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div
                    class="border-t border-slate-200 bg-slate-950 px-6 py-5 sm:px-8"
                >
                    <div
                        class="flex flex-wrap items-center justify-between gap-4"
                    >
                        <button
                            id="millora-review-back"
                            type="button"
                            class="rounded-full border border-white/20 bg-white px-6 py-3 font-bold text-slate-800 transition hover:border-amber-300 hover:bg-amber-50 hover:text-slate-950"
                        >
                            ← {text.back}
                        </button>

                        <button
                            id="millora-review-send"
                            type="button"
                            class="inline-flex min-h-12 items-center justify-center rounded-full bg-white px-8 py-3 font-bold text-slate-950 transition hover:bg-amber-300"
                        >
                            {text.send}
                            <span aria-hidden="true" class="ml-3">→</span>
                        </button>
                    </div>

                    <div
                        id="millora-prototype-note"
                        hidden
                        class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold leading-relaxed text-emerald-950"
