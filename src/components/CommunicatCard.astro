---
import { formatDate } from "../lib/formatDate";
import { getReadingTime } from "../lib/readingTime";
import { getStrapiMediaUrl } from "../lib/strapi";

const {
    item,
    href,
    lang = "ca",
    readingSuffix = "",
} = Astro.props as {
    item: any;
    href: string;
    lang?: "ca" | "es" | "en";
    readingSuffix?: string;
};

const hasImage = Boolean(item.imatge?.url);
---

<article
    class="group h-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:border-sky-200 hover:shadow-md"
>
    <a
        href={href}
        class="block h-full focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-300 sm:grid sm:grid-cols-[10.5rem_minmax(0,1fr)]"
    >
        {
            hasImage ? (
                <div class="aspect-[16/8] overflow-hidden bg-slate-100 sm:aspect-auto sm:min-h-[13rem]">
                    <img
                        src={getStrapiMediaUrl(item.imatge.url)}
                        alt=""
                        width="500"
                        height="400"
                        loading="lazy"
                        class="size-full object-cover transition duration-300 group-hover:scale-[1.025]"
                    />
                </div>
            ) : (
                <div
                    class="flex aspect-[16/8] items-end bg-gradient-to-br from-sky-100 via-white to-amber-100 p-5 sm:aspect-auto sm:min-h-[13rem]"
                    aria-hidden="true"
                >
                    <span
                        class="text-[0.65rem] font-black uppercase tracking-[0.18em] text-sky-800"
                    >
                        GUIAPINEDA
                    </span>
                </div>
            )
        }

        <div class="flex min-w-0 flex-col p-5">
            <div
                class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold text-slate-500"
            >
                <span class="truncate text-sky-700">
                    {item.autor}
                </span>

                <span aria-hidden="true">·</span>

                <span>
                    {formatDate(item.data_publicacio, lang)}
                </span>
            </div>

            <h2
                class="mt-2 line-clamp-2 text-xl font-black leading-tight tracking-tight text-slate-950 transition group-hover:text-sky-800"
            >
                {item.titol}
            </h2>

            <p
                class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600"
            >
                {item.resum}
            </p>

            <div
                class="mt-auto flex items-center justify-between gap-4 pt-4"
            >
                <span class="text-xs font-bold text-slate-400">
                    {getReadingTime(item.contingut)} {readingSuffix}
                </span>

                <span
                    aria-hidden="true"
                    class="flex size-8 shrink-0 items-center justify-center rounded-full bg-sky-950 text-sm font-bold text-white transition group-hover:bg-sky-700"
                >
                    →
                </span>
            </div>
        </div>
    </a>
</article>
