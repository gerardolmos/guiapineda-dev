---
interface Props {
    title: string;
    text: string;
    note: string;
    button: string;
    href: string;
    variant: "millorem" | "comunicats";
}

const {
    title,
    text,
    note,
    button,
    href,
    variant,
} = Astro.props;

const backgroundClass =
    variant === "comunicats"
        ? "bg-violet-950"
        : "bg-sky-950";
---

<aside
    class:list={[
        "mt-12 overflow-hidden rounded-[2rem] p-7 text-white sm:p-9",
        backgroundClass,
    ]}
>
    <div
        class="flex flex-col gap-7 md:flex-row md:items-center md:justify-between"
    >
        <div class="max-w-2xl">
            <h2
                class="text-2xl font-black tracking-tight sm:text-3xl"
            >
                {title}
            </h2>

            <p
                class="mt-3 max-w-2xl text-lg leading-8 text-sky-100 sm:text-xl sm:leading-9"
            >
                {text}
            </p>

            <p
                class="mt-5 max-w-2xl border-t border-white/20 pt-4 text-sm font-medium leading-6 text-white/65"
            >
                {note}
            </p>
        </div>

        <a
            href={href}
            class="inline-flex min-h-12 shrink-0 items-center justify-center self-start rounded-full bg-white px-6 py-3 font-black text-sky-950 transition hover:bg-amber-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-amber-300 md:self-auto"
        >
            {button}
            <span aria-hidden="true" class="ml-3">→</span>
        </a>
    </div>
</aside>
