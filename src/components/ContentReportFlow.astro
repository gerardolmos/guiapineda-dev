---
import EmailVerificationBlock from "./EmailVerificationBlock.astro";

interface Props {
    lang: "ca" | "es" | "en";
    contentType: "agenda" | "veu" | "millora" | "comercio";
    documentId: string;
}

const { lang, contentType, documentId } = Astro.props;
const stableId = documentId?.trim();
if (!stableId || stableId.length > 128) {
    throw new Error("ContentReportFlow requires a documentId of 1–128 characters.");
}

const reasonValues = [
    "informacion_falsa",
    "spam_fraude",
    "contenido_inapropiado_ilegal",
    "privacidad_datos",
    "otro",
] as const;

const copy = {
    ca: {
        action: "Denunciar aquest contingut", title: "Envia una denúncia privada",
        intro: "Avisa l'equip editorial d'un problema en aquest contingut. La denúncia és privada, es revisarà manualment i no provocarà cap retirada automàtica.",
        types: { agenda: "activitat de l'agenda", veu: "article de Veus", millora: "proposta de Millorem", comercio: "fitxa de comerç" },
        item: "Contingut denunciat", reason: "Motiu de la denúncia", choose: "Selecciona un motiu",
        reasons: ["Informació falsa o enganyosa", "Contingut brossa o frau", "Contingut inadequat o possiblement il·legal", "Privacitat o dades personals", "Un altre motiu"],
        explanation: "Context privat", optional: "opcional", help: "Afegeix context per a l'equip editorial. És obligatori si tries «Un altre motiu».", chars: "caràcters",
        email: "Email de contacte", emailHelp: "Només s'utilitza per verificar aquest enviament. No es guardarà a la denúncia.",
        privacy: "No demanem ni guardem el teu nom, IP, navegador, sessió, perfil ni historial. La denúncia no mostra comptadors públics ni avisa automàticament l'autoria.",
        send: "Enviar denúncia", sending: "Enviant...", close: "Tancar", retry: "Tornar-ho a provar", back: "Tornar al contingut",
        requiredReason: "Selecciona un motiu.", requiredExplanation: "Explica breument el motiu quan selecciones «Un altre motiu».", tooLong: "El context no pot superar els 1.000 caràcters.", invalidEmail: "Introdueix un email vàlid de 180 caràcters com a màxim.", verificationRequired: "Verifica l'email abans d'enviar la denúncia.",
        invalidReference: "No podem validar aquesta referència. Recarrega la pàgina i torna-ho a provar.", limited: "S'ha assolit temporalment el límit d'enviaments. Torna-ho a provar més tard.", unavailable: "No hem pogut rebre la denúncia. Conservem només el motiu i el context; verifica de nou l'email i torna-ho a provar.",
        successTitle: "Denúncia rebuda", success: "L'equip editorial la revisarà de manera privada i humana. El contingut no s'ha modificat ni retirat automàticament.",
    },
    es: {
        action: "Denunciar este contenido", title: "Envía una denuncia privada",
        intro: "Avisa al equipo editorial de un problema en este contenido. La denuncia es privada, se revisará manualmente y no provocará ninguna retirada automática.",
        types: { agenda: "actividad de la agenda", veu: "artículo de Veus", millora: "propuesta de Mejoremos", comercio: "ficha de comercio" },
        item: "Contenido denunciado", reason: "Motivo de la denuncia", choose: "Selecciona un motivo",
        reasons: ["Información falsa o engañosa", "Spam o fraude", "Contenido inapropiado o posiblemente ilegal", "Privacidad o datos personales", "Otro motivo"],
        explanation: "Contexto privado", optional: "opcional", help: "Añade contexto para el equipo editorial. Es obligatorio si eliges «Otro motivo».", chars: "caracteres",
        email: "Email de contacto", emailHelp: "Solo se utiliza para verificar este envío. No se guardará en la denuncia.",
        privacy: "No solicitamos ni guardamos tu nombre, IP, navegador, sesión, perfil ni historial. La denuncia no muestra contadores públicos ni avisa automáticamente a la autoría.",
        send: "Enviar denuncia", sending: "Enviando...", close: "Cerrar", retry: "Volver a intentarlo", back: "Volver al contenido",
        requiredReason: "Selecciona un motivo.", requiredExplanation: "Explica brevemente el motivo cuando selecciones «Otro motivo».", tooLong: "El contexto no puede superar los 1.000 caracteres.", invalidEmail: "Introduce un email válido de 180 caracteres como máximo.", verificationRequired: "Verifica el email antes de enviar la denuncia.",
        invalidReference: "No podemos validar esta referencia. Recarga la página e inténtalo de nuevo.", limited: "Se ha alcanzado temporalmente el límite de envíos. Inténtalo más tarde.", unavailable: "No hemos podido recibir la denuncia. Conservamos solo el motivo y el contexto; verifica de nuevo el email e inténtalo otra vez.",
        successTitle: "Denuncia recibida", success: "El equipo editorial la revisará de forma privada y humana. El contenido no se ha modificado ni retirado automáticamente.",
    },
    en: {
        action: "Report this content", title: "Send a private report",
        intro: "Alert the editorial team to a problem with this content. The report is private, will be reviewed by a person, and will not trigger automatic removal.",
        types: { agenda: "agenda event", veu: "Voices article", millora: "Improve proposal", comercio: "business listing" },
        item: "Content being reported", reason: "Reason for reporting", choose: "Select a reason",
        reasons: ["False or misleading information", "Spam or fraud", "Inappropriate or potentially illegal content", "Privacy or personal data", "Another reason"],
        explanation: "Private context", optional: "optional", help: "Add context for the editorial team. This is required if you select “Another reason”.", chars: "characters",
        email: "Contact email", emailHelp: "It is used only to verify this submission. It will not be stored in the report.",
        privacy: "We do not request or store your name, IP address, browser, session, profile, or history. Reports show no public count and do not automatically notify the author.",
        send: "Send report", sending: "Sending...", close: "Close", retry: "Try again", back: "Return to content",
        requiredReason: "Select a reason.", requiredExplanation: "Briefly explain the reason when selecting “Another reason”.", tooLong: "The context cannot exceed 1,000 characters.", invalidEmail: "Enter a valid email no longer than 180 characters.", verificationRequired: "Verify your email before sending the report.",
        invalidReference: "We cannot validate this reference. Reload the page and try again.", limited: "The submission limit has temporarily been reached. Please try again later.", unavailable: "We could not receive the report. We kept only the reason and context; verify your email again and retry.",
        successTitle: "Report received", success: "The editorial team will review it privately and personally. The content has not been automatically changed or removed.",
    },
} as const;

const text = copy[lang];
const idPrefix = `content-report-${contentType}-${stableId}`;
---

<section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby={`${idPrefix}-title`}>
    <details data-content-report-details class="rounded-2xl border border-slate-200 bg-slate-50">
        <summary class="cursor-pointer list-none px-5 py-4 font-black text-slate-700 transition hover:text-rose-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 sm:px-6">
            <span class="inline-flex items-center gap-2"><span aria-hidden="true">⚑</span>{text.action}</span>
        </summary>
        <div class="border-t border-slate-200 px-5 py-6 sm:px-6 sm:py-8">
            <div data-content-report-form-wrap>
                <h2 id={`${idPrefix}-title`} class="text-2xl font-black tracking-tight text-slate-950">{text.title}</h2>
                <p class="mt-3 max-w-3xl leading-7 text-slate-600">{text.intro}</p>
                <p class="mt-3 font-bold text-slate-700"><span>{text.item}:</span> {text.types[contentType]}</p>
                <form class="mt-7 max-w-3xl" data-content-report-form data-content-type={contentType} data-document-id={stableId}
                    data-invalid-reference={text.invalidReference} data-required-reason={text.requiredReason}
                    data-required-explanation={text.requiredExplanation} data-too-long={text.tooLong}
                    data-invalid-email={text.invalidEmail} data-verification-required={text.verificationRequired}
                    data-limited={text.limited} data-unavailable={text.unavailable} data-sending-label={text.sending} novalidate>
                    <input type="hidden" name="tipo_contenido" value={contentType} />
                    <input type="hidden" name="contenido_document_id" value={stableId} />
                    <input type="hidden" name="idioma_solicitud" value={lang} />
                    <div aria-hidden="true" class="absolute -left-[10000px] size-px overflow-hidden">
                        <label>Leave this field empty<input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label>
                    </div>
                    <fieldset>
                        <legend class="font-bold text-slate-950">{text.reason}</legend>
                        <select name="motivo" required data-report-reason aria-describedby={`${idPrefix}-error`}
                            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100">
                            <option value="">{text.choose}</option>
                            {reasonValues.map((value, index) => <option value={value}>{text.reasons[index]}</option>)}
                        </select>
                    </fieldset>
                    <label class="mt-6 block" for={`${idPrefix}-explanation`}>
                        <span class="font-bold text-slate-950">{text.explanation} <span data-report-optional class="font-medium text-slate-400">({text.optional})</span></span>
                        <textarea id={`${idPrefix}-explanation`} name="explicacion" rows="6" maxlength="1000" data-report-explanation aria-describedby={`${idPrefix}-explanation-help ${idPrefix}-error`}
                            class="mt-2 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100"></textarea>
                    </label>
                    <div id={`${idPrefix}-explanation-help`} class="mt-2 flex flex-wrap justify-between gap-3 text-sm text-slate-500">
                        <p>{text.help}</p><p aria-live="polite"><span data-report-explanation-count>0</span>/1000 {text.chars}</p>
                    </div>
                    <label class="mt-6 block" for={`${idPrefix}-email`}><span class="font-bold text-slate-950">{text.email}</span>
                        <input id={`${idPrefix}-email`} name="email_contacto" type="email" maxlength="180" autocomplete="email" required data-report-email aria-describedby={`${idPrefix}-email-help ${idPrefix}-error`}
                            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100" />
                    </label>
                    <p id={`${idPrefix}-email-help`} class="mt-2 text-sm text-slate-500">{text.emailHelp}</p>
                    <EmailVerificationBlock lang={lang} scope="content-report" />
                    <p class="mt-6 rounded-xl bg-white p-4 text-sm leading-6 text-slate-600">{text.privacy}</p>
                    <p id={`${idPrefix}-error`} hidden data-content-report-error class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 font-bold text-red-800" role="alert" tabindex="-1"></p>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <button type="submit" disabled data-report-submit data-default-label={text.send} class="inline-flex min-h-11 items-center justify-center rounded-full bg-rose-700 px-7 py-3 font-black text-white transition hover:bg-rose-800 disabled:cursor-not-allowed disabled:opacity-50">{text.send}</button>
                        <button type="button" hidden data-report-retry class="inline-flex min-h-11 items-center justify-center rounded-full border border-rose-300 bg-white px-6 py-3 font-bold text-rose-800">{text.retry}</button>
                        <button type="button" onclick="this.closest('details')?.removeAttribute('open')" class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700">{text.close}</button>
                    </div>
                </form>
            </div>
            <div hidden data-content-report-success class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6" role="status" tabindex="-1">
                <h2 class="text-2xl font-black text-emerald-950">{text.successTitle}</h2>
                <p class="mt-3 leading-7 text-emerald-900">{text.success}</p>
                <button type="button" onclick="this.closest('details')?.removeAttribute('open')" class="mt-5 inline-flex min-h-11 items-center justify-center rounded-full border border-emerald-400 bg-white px-6 py-3 font-bold text-emerald-900">{text.back}</button>
            </div>
        </div>
    </details>
</section>

<script>
    import { initContentReportFlow } from "../lib/contentReportFlow";
    initContentReportFlow();
</script>
