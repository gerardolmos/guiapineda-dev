---
import type { Lang } from "../lib/languageSwitcher";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import SiteBrand from "./SiteBrand.astro";

interface Props {
    lang: Lang;
    pathname: string;
    currentLang: Lang;
    links: Record<Lang, string>;
    showLanguageSwitcher?: boolean;
    t: any;
}

const {
    lang,
    pathname,
    currentLang,
    links,
    showLanguageSwitcher = true,
    t,
} = Astro.props;

const homeUrl = lang === "ca" ? "/" : `/${lang}`;
const taulerUrl =
    lang === "ca" ? "/tauler" : `/${lang}/tauler`;
const communicatsUrl =
    lang === "ca" ? "/comunicats" : `/${lang}/comunicats`;
const milloresUrl =
    lang === "ca" ? "/millorem-pineda" : `/${lang}/millorem-pineda`;

const normalizedPath = pathname.replace(/\/+$/, "") || "/";
const pathWithoutLanguage =
    normalizedPath.replace(/^\/(?:es|en)(?=\/|$)/, "") || "/";

const activeSection = pathWithoutLanguage.startsWith("/tauler")
    ? "tauler"
    : pathWithoutLanguage.startsWith("/comunicats")
      ? "comunicats"
      : pathWithoutLanguage.startsWith("/millorem-pineda")
        ? "millores"
        : pathWithoutLanguage.startsWith("/foto-del-mes") ||
            pathWithoutLanguage === "/404"
          ? null
          : "guide";

const navigationItems = [
    {
        id: "tauler",
        label: t.nav.tauler,
        href: taulerUrl,
    },
    {
        id: "guide",
        label: t.nav.guide,
        href: `${homeUrl}#categories`,
    },
    {
        id: "comunicats",
        label: t.comunicats.title,
        href: communicatsUrl,
    },
    {
        id: "millores",
        label: t.millores.title,
        href: milloresUrl,
    },
];

const desktopLinkClasses = (active: boolean) => [
    "inline-flex min-h-11 items-center rounded-xl px-4 text-sm font-semibold outline-none transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600",
    active
        ? "bg-sky-50 text-sky-800"
        : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
];

const mobileLinkClasses = (active: boolean) => [
    "flex min-h-13 items-center justify-between rounded-xl px-4 py-3 text-base font-semibold outline-none transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600",
    active
        ? "bg-sky-50 text-sky-900 ring-1 ring-inset ring-sky-100"
        : "text-slate-800 hover:bg-slate-100",
];
---

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-slate-200 bg-white shadow-sm transition-transform duration-300 ease-out motion-reduce:transition-none"
>
    <div
        class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:min-h-20 lg:px-8"
    >
        <SiteBrand href={homeUrl} />

        <div class="hidden items-center gap-3 lg:flex">
            <nav aria-label={t.nav.mainLabel}>
                <ul class="flex items-center gap-1">
                    {
                        navigationItems.map((item) => {
                            const active = activeSection === item.id;

                            return (
                                <li>
                                    <a
                                        href={item.href}
                                        aria-current={
                                            active ? "page" : undefined
                                        }
                                        class:list={desktopLinkClasses(active)}
                                    >
                                        {item.label}
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>
            </nav>

            {
                showLanguageSwitcher && (
                    <LanguageSwitcher
                        currentLang={currentLang}
                        links={links}
                        label={t.nav.languageLabel}
                    />
                )
            }
        </div>

        <button
            id="site-menu-button"
            type="button"
            aria-controls="site-mobile-menu"
            aria-expanded="false"
            aria-label={t.nav.openMenu}
            class="inline-flex size-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-800 shadow-sm outline-none transition-colors duration-200 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 lg:hidden"
        >
            <svg
                data-menu-open-icon
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="size-6"
            >
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
            </svg>

            <svg
                data-menu-close-icon
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="size-6"
                hidden
            >
                <path d="M6 6l12 12"></path>
                <path d="M18 6L6 18"></path>
            </svg>
        </button>
    </div>

    <div
        id="site-mobile-menu"
        class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-slate-200 bg-white shadow-xl lg:hidden"
        hidden
    >
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6">
            <nav aria-label={t.nav.mainLabel}>
                <ul class="space-y-2">
                    {
                        navigationItems.map((item) => {
                            const active = activeSection === item.id;

                            return (
                                <li>
                                    <a
                                        href={item.href}
                                        data-mobile-menu-link
                                        aria-current={
                                            active ? "page" : undefined
                                        }
                                        class:list={mobileLinkClasses(active)}
                                    >
                                        <span>{item.label}</span>

                                        <svg
                                            aria-hidden="true"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="size-5"
                                        >
                                            <path d="M9 18l6-6-6-6"></path>
                                        </svg>
                                    </a>
                                </li>
                            );
                        })
                    }
                </ul>
            </nav>

            {
                showLanguageSwitcher && (
                    <div class="mt-4 border-t border-slate-200 pt-4">
                        <p class="mb-3 text-sm font-semibold text-slate-600">
                            {t.nav.languageLabel}
                        </p>

                        <LanguageSwitcher
                            currentLang={currentLang}
                            links={links}
                            label={t.nav.languageLabel}
                        />
                    </div>
                )
            }
        </div>
    </div>
</header>

<script
    define:vars={{
        openMenuLabel: t.nav.openMenu,
        closeMenuLabel: t.nav.closeMenu,
    }}
>
    const header = document.getElementById("site-header");
    const button = document.getElementById("site-menu-button");
    const panel = document.getElementById("site-mobile-menu");
    const openIcon = button?.querySelector("[data-menu-open-icon]");
    const closeIcon = button?.querySelector("[data-menu-close-icon]");

    if (
        header instanceof HTMLElement &&
        button instanceof HTMLButtonElement &&
        panel instanceof HTMLElement &&
        openIcon instanceof SVGElement &&
        closeIcon instanceof SVGElement
    ) {
        const menuLinks = panel.querySelectorAll("a[href]");
        const desktopMediaQuery = window.matchMedia(
            "(min-width: 1024px)",
        );

        let lastScrollY = Math.max(window.scrollY, 0);
        let ticking = false;

        const menuIsOpen = () =>
            button.getAttribute("aria-expanded") === "true";

        const showHeader = () => {
            header.classList.remove("-translate-y-full");
        };

        const hideHeader = () => {
            header.classList.add("-translate-y-full");
        };

        const updateHeader = () => {
            const currentScrollY = Math.max(window.scrollY, 0);
            const difference = currentScrollY - lastScrollY;

            if (
                desktopMediaQuery.matches ||
                currentScrollY <= 16 ||
                menuIsOpen()
            ) {
                showHeader();
                lastScrollY = currentScrollY;
                ticking = false;
                return;
            }

            if (Math.abs(difference) >= 8) {
                if (
                    difference > 0 &&
                    currentScrollY > header.offsetHeight
                ) {
                    hideHeader();
                } else if (difference < 0) {
                    showHeader();
                }

                lastScrollY = currentScrollY;
            }

            ticking = false;
        };

        const requestHeaderUpdate = () => {
            if (ticking) return;

            ticking = true;
            requestAnimationFrame(updateHeader);
        };

        const setMenuOpen = (open, restoreFocus = false) => {
            panel.hidden = !open;
            openIcon.hidden = open;
            closeIcon.hidden = !open;

            button.setAttribute("aria-expanded", String(open));
            button.setAttribute(
                "aria-label",
                open ? closeMenuLabel : openMenuLabel,
            );

            if (open) {
                showHeader();

                requestAnimationFrame(() => {
                    menuLinks[0]?.focus();
                });
            }

            if (!open && restoreFocus) {
                button.focus();
            }
        };

        button.addEventListener("click", () => {
            setMenuOpen(!menuIsOpen());
        });

        menuLinks.forEach((link) => {
            link.addEventListener("click", () => {
                setMenuOpen(false);
            });
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && menuIsOpen()) {
                setMenuOpen(false, true);
            }
        });

        document.addEventListener("click", (event) => {
            const target = event.target;

            if (
                target instanceof Node &&
                menuIsOpen() &&
                !header.contains(target)
            ) {
                setMenuOpen(false);
            }
        });

        header.addEventListener("focusin", showHeader);

        window.addEventListener(
            "scroll",
            requestHeaderUpdate,
            { passive: true },
        );

        desktopMediaQuery.addEventListener("change", (event) => {
            showHeader();
            lastScrollY = Math.max(window.scrollY, 0);

            if (event.matches) {
                setMenuOpen(false);
            }
        });
    }
</script>
