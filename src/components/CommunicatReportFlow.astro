    },
    en: {
        action: "Report this announcement",
        title: "Send a private report",
        intro:
            "If you notice a problem with this announcement, alert the editorial team. The report will not be published or automatically remove the content.",
        reason: "Reason for reporting",
        chooseReason: "Select a reason",
        reasons: [
            "False or misleading information",
            "Spam or fraud",
            "Inappropriate or potentially illegal content",
