    },
} as const;

const text = copy[lang];
---

<section
    class="mt-12 border-t border-slate-200 pt-8"
    aria-labelledby={`communicat-report-title-${slug}`}
>
    <details
        data-communicat-report-details
        class="rounded-2xl border border-slate-200 bg-slate-50"
    >
        <summary
            class="cursor-pointer list-none px-5 py-4 font-black text-slate-700 transition hover:text-rose-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 sm:px-6"
        >
            <span class="inline-flex items-center gap-2">
                <span aria-hidden="true">⚑</span>
                {text.action}
            </span>
        </summary>

        <div class="border-t border-slate-200 px-5 py-6 sm:px-6 sm:py-8">
            <div data-communicat-report-form-wrap>
                <h2
                    id={`communicat-report-title-${slug}`}
                    class="text-2xl font-black tracking-tight text-slate-950"
                >
                    {text.title}
                </h2>

                <p class="mt-3 max-w-3xl leading-7 text-slate-600">
                    {text.intro}
                </p>

                <form
                    class="mt-7 max-w-3xl"
                    data-communicat-report-flow
                    data-required-reason={text.requiredReason}
                    data-required-explanation={text.requiredExplanation}
                    data-too-long={text.tooLong}
                    data-verification-required={text.verificationRequired}
                    data-unavailable={text.unavailable}
                    data-sending-label={text.sending}
                    novalidate
                >
                    <input
                        type="hidden"
                        name="comunicat_document_id"
                        value={documentId}
                    />
                    <input
                        type="hidden"
                        name="comunicat_slug"
                        value={slug}
                    />
                    <input
                        type="hidden"
                        name="idioma_solicitud"
                        value={lang}
                    />

                    <div
                        aria-hidden="true"
                        class="absolute -left-[10000px] size-px overflow-hidden"
                    >
                        <label>
                            Leave this field empty
                            <input
                                type="text"
                                name="bot-field"
                                tabindex="-1"
                                autocomplete="off"
                            />
                        </label>
                    </div>

                    <label class="block" for={`communicat-report-reason-${slug}`}>
                        <span class="font-bold text-slate-950">
                            {text.reason}
                        </span>
                        <select
                            id={`communicat-report-reason-${slug}`}
                            name="motivo"
                            required
                            data-report-reason
                            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100"
                        >
                            <option value="">{text.chooseReason}</option>
                            {
                                reasonValues.map((value, index) => (
                                    <option value={value}>
                                        {text.reasons[index]}
                                    </option>
                                ))
                            }
                        </select>
                    </label>

                    <label
                        class="mt-6 block"
                        for={`communicat-report-explanation-${slug}`}
                    >
                        <span class="font-bold text-slate-950">
                            {text.explanation}
                            <span
                                data-report-optional
                                class="font-medium text-slate-400"
                            >
                                ({text.optional})
                            </span>
                        </span>
                        <textarea
                            id={`communicat-report-explanation-${slug}`}
                            name="explicacion"
                            rows="6"
                            maxlength="1000"
                            data-report-explanation
                            class="mt-2 block w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100"
                        ></textarea>
                    </label>

                    <div class="mt-2 flex flex-wrap justify-between gap-3 text-sm text-slate-500">
                        <p>{text.explanationHelp}</p>
                        <p aria-live="polite">
                            <span data-report-explanation-count>0</span>/1000 {text.characters}
                        </p>
                    </div>

                    <label
                        class="mt-6 block"
                        for={`communicat-report-email-${slug}`}
                    >
                        <span class="font-bold text-slate-950">
                            {text.email}
                        </span>
                        <input
                            id={`communicat-report-email-${slug}`}
                            name="email_contacto"
                            type="email"
                            maxlength="180"
                            autocomplete="email"
                            required
                            data-report-email
                            class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-950 outline-none transition focus:border-rose-500 focus:ring-4 focus:ring-rose-100"
                        />
                    </label>

                    <p class="mt-2 text-sm text-slate-500">
                        {text.emailHelp}
                    </p>

                    <EmailVerificationBlock
                        lang={lang}
                        scope="communicat-report"
                    />

                    <p class="mt-6 rounded-xl bg-white p-4 text-sm leading-6 text-slate-600">
                        {text.privacy}
                    </p>

                    <p
                        hidden
                        data-report-error
                        class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 font-bold text-red-800"
                        role="alert"
                    ></p>

                    <button
                        type="submit"
                        disabled
                        data-report-submit
                        data-default-label={text.send}
                        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-rose-700 px-7 py-3 font-black text-white transition hover:bg-rose-800 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                        {text.send}
                    </button>
                </form>
            </div>

            <div
                hidden
                data-communicat-report-success
                class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6"
                role="status"
                tabindex="-1"
            >
                <h2 class="text-2xl font-black text-emerald-950">
                    {text.successTitle}
                </h2>
                <p class="mt-3 leading-7 text-emerald-900">
                    {text.success}
                </p>
            </div>
        </div>
    </details>
</section>

<script>
    import { initCommunicatReportFlow } from "../lib/communicatReportFlow";

    initCommunicatReportFlow();
</script>
