        email: "Email de contacto",
        emailHelp:
            "Solo se utiliza para verificar este envío. No se guardará en la denuncia.",
        privacy:
            "La denuncia será privada. No solicitamos ni guardamos tu nombre, tu IP ni otros identificadores personales.",
        send: "Enviar denuncia",
        sending: "Enviando...",
        requiredReason: "Selecciona un motivo.",
        requiredExplanation:
            "Explica brevemente el motivo cuando selecciones «Otro».",
