---
import EmailVerificationBlock from "./EmailVerificationBlock.astro";

interface Props {
    lang: "ca" | "es" | "en";
    documentId: string;
    slug: string;
}

const {
    lang,
    documentId,
    slug,
} = Astro.props;

const reasonValues = [
    "informacion_falsa",
    "spam_fraude",
    "contenido_inapropiado_ilegal",
    "privacidad_datos",
    "otro",
