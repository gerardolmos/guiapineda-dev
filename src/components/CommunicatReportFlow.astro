        reasons: [
            "Información falsa o engañosa",
            "Spam o fraude",
            "Contenido inapropiado o posiblemente ilegal",
            "Privacidad o datos personales",
            "Otro",
        ],
        explanation: "Explicación privada",
        optional: "opcional",
        explanationHelp:
            "Añade contexto para el equipo editorial. Es obligatorio si eliges «Otro».",
