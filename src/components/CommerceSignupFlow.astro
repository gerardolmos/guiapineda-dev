---
interface Category {
    id: string;
    label: string;
}

interface Subcategory {
    id: string;
    categoriaId: string;
    label: string;
}

interface Props {
    lang: "ca" | "es";
    categorias: Category[];
    subcategorias: Subcategory[];
}

const { lang, categorias, subcategorias } = Astro.props;

const text =
