    function formatScheduleTime(value: string) {
        if (!value) return "";

        return value.endsWith(":00")
            ? value.slice(0, -3)
            : value;
    }

    function updateHours() {
        let allDaysResolved = true;
        let hasOpenDay = false;

        scheduleRows.forEach((row) => {
            const closed = row.querySelector<HTMLInputElement>(
                ".schedule-closed",
            );
            const open1 = row.querySelector<HTMLInputElement>(
                ".schedule-open-1",
            );
            const close1 = row.querySelector<HTMLInputElement>(
                ".schedule-close-1",
            );
            const open2 = row.querySelector<HTMLInputElement>(
                ".schedule-open-2",
            );
            const close2 = row.querySelector<HTMLInputElement>(
                ".schedule-close-2",
            );
            const second =
                row.querySelector<HTMLElement>(".schedule-second");

            const day = row.dataset.day ?? "";

            const preview = document.querySelector<HTMLElement>(
                `[data-preview-day="${day}"] .preview-day-value`,
            );

            if (closed?.checked) {
                if (preview) {
                    preview.textContent =
                        document.documentElement.lang === "ca"
                            ? "Tancat"
                            : "Cerrado";
                    preview.className =
                        "preview-day-value text-right text-sm font-semibold text-slate-500";
                }

                return;
            }

            const firstComplete = Boolean(
                open1?.value && close1?.value,
            );

            const secondVisible = second && !second.hidden;

            const secondComplete =
                !secondVisible ||
                Boolean(open2?.value && close2?.value);

            if (!firstComplete || !secondComplete) {
                allDaysResolved = false;

                if (preview) {
                    preview.textContent =
                        document.documentElement.lang === "ca"
                            ? "Per completar"
                            : "Por completar";
                    preview.className =
                        "preview-day-value text-right text-sm text-slate-400";
                }

                return;
            }

            hasOpenDay = true;

            const firstText =
                `${formatScheduleTime(open1?.value ?? "")}–${formatScheduleTime(close1?.value ?? "")}`;

            const secondText =
                secondVisible
                    ? ` · ${formatScheduleTime(open2?.value ?? "")}–${formatScheduleTime(close2?.value ?? "")}`
                    : "";

            if (preview) {
                preview.textContent = firstText + secondText;
                preview.className =
                    "preview-day-value text-right text-sm font-semibold text-slate-700";
            }
        });

        const hasAttention = attentionButtons.some(
            (button) =>
                button.getAttribute("aria-pressed") === "true",
        );

        hoursContinueButton?.toggleAttribute(
            "disabled",
            !(allDaysResolved && hasOpenDay && hasAttention),
        );
    }

    function setClosedState(row: HTMLElement) {
        const closed = row.querySelector<HTMLInputElement>(
            ".schedule-closed",
        );

        const times =
            row.querySelector<HTMLElement>(".schedule-times");

        if (!closed || !times) return;

        const disabled = closed.checked;

        times.classList.toggle("opacity-35", disabled);

        times.querySelectorAll<HTMLInputElement>("input").forEach(
            (input) => {
                input.disabled = disabled;
            },
        );

        times.querySelectorAll<HTMLButtonElement>("button").forEach(
            (button) => {
                button.disabled = disabled;
            },
        );

        updateHours();
    }

    function copyMonday(targetRows: HTMLElement[]) {
        const monday = scheduleRows.find(
            (row) => row.dataset.day === "lunes",
        );

        if (!monday) return;

        const mondayClosed =
            monday.querySelector<HTMLInputElement>(
                ".schedule-closed",
            )?.checked ?? false;

        const mondayOpen1 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-open-1",
            )?.value ?? "";

        const mondayClose1 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-close-1",
            )?.value ?? "";

        const mondayOpen2 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-open-2",
            )?.value ?? "";

        const mondayClose2 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-close-2",
            )?.value ?? "";

        const mondaySecond =
            monday.querySelector<HTMLElement>(
                ".schedule-second",
            );

        const secondVisible =
            mondaySecond && !mondaySecond.hidden;

        targetRows.forEach((row) => {
            if (row === monday) return;

            const closed =
                row.querySelector<HTMLInputElement>(
                    ".schedule-closed",
                );
            const open1 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-open-1",
                );
            const close1 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-close-1",
                );
            const open2 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-open-2",
                );
            const close2 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-close-2",
                );
            const second =
                row.querySelector<HTMLElement>(
                    ".schedule-second",
                );
            const toggle =
                row.querySelector<HTMLButtonElement>(
                    ".schedule-second-toggle",
                );

            if (closed) closed.checked = mondayClosed;
            if (open1) open1.value = mondayOpen1;
            if (close1) close1.value = mondayClose1;
            if (open2) open2.value = mondayOpen2;
            if (close2) close2.value = mondayClose2;

            if (second) {
                second.hidden = !secondVisible;
            }

            if (toggle) {
                toggle.textContent = secondVisible
                    ? toggle.dataset.removeLabel ?? ""
                    : toggle.dataset.addLabel ?? "";
            }

            setClosedState(row);
        });

        updateHours();
    }

    function updateContactPreview() {
        if (contactPreviewName && nameInput) {
            contactPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (contactPreviewCategory && categoryText) {
            contactPreviewCategory.textContent = categoryText;
        }

        if (contactPreviewShort && shortDescription) {
            contactPreviewShort.textContent =
                shortDescription.value.trim() ||
                shortDescription.placeholder ||
                "";
        }

        if (contactPreviewAddress && addressInput) {
            contactPreviewAddress.textContent =
                addressInput.value.trim() ||
                addressInput.placeholder ||
                "";
        }

        if (contactPreviewMethods && contactPreviewEmpty) {
            contactPreviewMethods
                .querySelectorAll("[data-contact-chip]")
                .forEach((item) => item.remove());

            const methods = [
                {
                    label: "☎",
                    value: phoneInput?.value.trim() || "",
                    className:
                        "bg-sky-50 text-sky-900 border-sky-200",
                },
                {
                    label: "WhatsApp",
                    value: whatsappInput?.value.trim() || "",
                    className:
                        "bg-emerald-50 text-emerald-900 border-emerald-200",
                },
                {
                    label: "@",
                    value: emailInput?.value.trim() || "",
                    className:
                        "bg-violet-50 text-violet-900 border-violet-200",
                },
                {
                    label: "Web",
                    value: webInput?.value.trim() || "",
                    className:
                        "bg-fuchsia-50 text-fuchsia-900 border-fuchsia-200",
                },
            ].filter((item) => item.value);

            contactPreviewEmpty.hidden = methods.length > 0;

            methods.forEach((method) => {
                const chip = document.createElement("span");

                chip.dataset.contactChip = "true";
                chip.className =
                    `inline-flex max-w-full items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-bold ${method.className}`;

                const label = document.createElement("span");
                label.textContent = method.label;

                const value = document.createElement("span");
                value.className = "truncate";
                value.textContent = method.value;

                chip.append(label, value);
                contactPreviewMethods.appendChild(chip);
            });
        }

        const hasContact = Boolean(
            phoneInput?.value.trim() ||
            whatsappInput?.value.trim() ||
            emailInput?.value.trim() ||
            webInput?.value.trim(),
        );

        const emailValid =
            !emailInput?.value.trim() || emailInput.checkValidity();

        if (contactContinueButton) {
            contactContinueButton.toggleAttribute(
                "disabled",
                !(
                    addressInput?.value.trim() &&
                    hasContact &&
                    emailValid
                ),
            );
        }
    }

    function updateDescriptionPreview() {
        if (shortDescriptionCount && shortDescription) {
            shortDescriptionCount.textContent =
                `${shortDescription.value.length} / 160`;
        }

        if (longDescriptionCount && longDescription) {
            longDescriptionCount.textContent =
                `${longDescription.value.length} / 900`;
        }

        if (descriptionPreviewShort && shortDescription) {
            descriptionPreviewShort.textContent =
                shortDescription.value.trim() ||
                shortDescription.placeholder ||
                "";
        }

        if (descriptionPreviewLong && longDescription) {
            descriptionPreviewLong.textContent =
                longDescription.value.trim() ||
                longDescription.placeholder ||
                "";
        }

        if (descriptionContinueButton) {
            descriptionContinueButton.toggleAttribute(
                "disabled",
                !(
                    shortDescription?.value.trim() &&
                    longDescription?.value.trim()
                ),
            );
        }
    }

