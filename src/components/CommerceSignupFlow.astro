        document.getElementById("description-preview-name");
    const descriptionPreviewCategory =
        document.getElementById("description-preview-category");
    const descriptionPreviewShort =
        document.getElementById("description-preview-short");
    const descriptionPreviewLong =
        document.getElementById("description-preview-long");

    const nameInput = document.getElementById(
        "business-name",
    ) as HTMLInputElement | null;

    const categoryInput = document.getElementById(
        "selected-category",
    ) as HTMLInputElement | null;

    const subcategoryInput = document.getElementById(
        "selected-subcategory",
    ) as HTMLInputElement | null;

    const categoryButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-category-id]",
        ),
    );

    const subcategoryButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-subcategory-id]",
        ),
    );

    const subcategoryBlock =
        document.getElementById("subcategory-block");

    const previewName = document.getElementById("preview-name");
    const previewCategory =
        document.getElementById("preview-category");

    let categoryLabel = "";
    let subcategoryLabel = "";

    function showScreen(
        target: HTMLElement | null,
        ...others: Array<HTMLElement | null>
    ) {
        others.forEach((item) => {
            if (item) item.hidden = true;
        });

        if (target) {
            target.hidden = false;
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    }

    function updateContinueState() {
        if (!continueButton || !nameInput) return;

        continueButton.toggleAttribute(
            "disabled",
            !(
                nameInput.value.trim() &&
                categoryInput?.value &&
                subcategoryInput?.value
            ),
        );
    }

    function updatePreview() {
        if (previewName && nameInput) {
            previewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (previewCategory && categoryText) {
            previewCategory.textContent = categoryText;
        }

        if (descriptionPreviewName && nameInput) {
            descriptionPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        if (descriptionPreviewCategory && categoryText) {
            descriptionPreviewCategory.textContent = categoryText;
        }

        updateContinueState();
    }

    let mainPhotoUrl = "";
    let logoUrl = "";
    let galleryFiles: File[] = [];
    let galleryUrls: string[] = [];

    function revokeUrl(url: string) {
        if (url) {
            URL.revokeObjectURL(url);
        }
    }

    function updatePhotosPreviewIdentity() {
        if (photosPreviewName && nameInput) {
            photosPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (photosPreviewCategory && categoryText) {
            photosPreviewCategory.textContent = categoryText;
        }

        if (photosPreviewDescription && shortDescription) {
            photosPreviewDescription.textContent =
                shortDescription.value.trim() ||
                shortDescription.placeholder ||
                "";
        }
    }

    function updateMainPhoto(file?: File) {
        if (!file) return;

        revokeUrl(mainPhotoUrl);
        mainPhotoUrl = URL.createObjectURL(file);

        if (mainPhotoImage) {
            mainPhotoImage.src = mainPhotoUrl;
        }

        if (photosPreviewMainImage) {
            photosPreviewMainImage.src = mainPhotoUrl;
            photosPreviewMainImage.hidden = false;
        }

        if (mainPhotoEmpty) {
            mainPhotoEmpty.hidden = true;
        }

        if (mainPhotoSelected) {
            mainPhotoSelected.hidden = false;
        }

        if (photosPreviewPlaceholder) {
            photosPreviewPlaceholder.hidden = true;
        }

        photosContinueButton?.removeAttribute("disabled");
    }

    function updateLogo(file?: File) {
        if (!file) return;

        revokeUrl(logoUrl);
        logoUrl = URL.createObjectURL(file);

        if (logoImage) {
            logoImage.src = logoUrl;
            logoImage.hidden = false;
        }

        if (logoPlaceholder) {
            logoPlaceholder.hidden = true;
        }

        if (photosPreviewLogo) {
            photosPreviewLogo.src = logoUrl;
            photosPreviewLogo.hidden = false;
        }

        if (photosPreviewLogoPlaceholder) {
            photosPreviewLogoPlaceholder.hidden = true;
        }

        if (logoButton) {
            logoButton.textContent =
                document.documentElement.lang === "ca"
                    ? "Canviar logo"
                    : "Cambiar logo";
        }
    }

    function renderGallery() {
        galleryUrls.forEach(revokeUrl);

        galleryUrls = galleryFiles.map((file) =>
            URL.createObjectURL(file),
        );

        document
            .querySelectorAll<HTMLElement>("[data-gallery-slot]")
            .forEach((slot, index) => {
                slot.replaceChildren();

                const url = galleryUrls[index];

                if (!url) {
                    const plus = document.createElement("span");
                    plus.className =
                        "text-2xl font-light text-slate-300";
                    plus.textContent = "+";
                    plus.setAttribute("aria-hidden", "true");
                    slot.appendChild(plus);
                    return;
                }

                slot.className =
                    "gallery-slot relative aspect-square overflow-hidden rounded-2xl border border-slate-200 bg-stone-50";

                const image = document.createElement("img");
                image.src = url;
                image.alt = "";
                image.className =
                    "h-full w-full object-cover";

                const remove = document.createElement("button");
                remove.type = "button";
                remove.dataset.galleryRemove =
                    String(index);
                remove.className =
                    "absolute right-2 top-2 flex size-8 items-center justify-center rounded-full bg-white/95 text-lg font-bold text-slate-950 shadow";
                remove.textContent = "×";
                remove.setAttribute(
                    "aria-label",
                    document.documentElement.lang === "ca"
                        ? "Eliminar foto"
                        : "Eliminar foto",
                );

                slot.append(image, remove);
            });

        if (photosPreviewGallery) {
            photosPreviewGallery.replaceChildren();

            galleryUrls.forEach((url) => {
                const image = document.createElement("img");
                image.src = url;
                image.alt = "";
                image.className =
                    "aspect-square w-full rounded-lg object-cover";
                photosPreviewGallery.appendChild(image);
            });
        }

        if (galleryCount) {
            galleryCount.textContent =
                String(galleryFiles.length);
        }

        if (galleryButton) {
            const full = galleryFiles.length >= 4;

            galleryButton.classList.toggle(
                "pointer-events-none",
                full,
            );
            galleryButton.classList.toggle(
                "opacity-40",
                full,
            );
        }
    }

    function getServiceRows() {
        return Array.from(
            document.querySelectorAll<HTMLElement>(".service-row"),
        );
    }

    function updateServiceNumbers() {
        const rows = getServiceRows();

        rows.forEach((row, index) => {
            const number =
                row.querySelector<HTMLElement>(".service-number");
            const remove =
                row.querySelector<HTMLButtonElement>(
                    ".service-remove",
                );

            if (number) {
                number.textContent = String(index + 1);
            }

            if (remove) {
                remove.classList.toggle(
                    "hidden",
                    rows.length === 1,
                );
            }
        });

        if (addServiceButton) {
            addServiceButton.toggleAttribute(
                "disabled",
                rows.length >= 6,
            );

            addServiceButton.classList.toggle(
                "opacity-40",
                rows.length >= 6,
            );
        }
    }

    function updateOfferPreview() {
        const rows = getServiceRows();

        const services = rows
            .map((row) => ({
                name:
                    row.querySelector<HTMLInputElement>(
                        ".service-name",
                    )?.value.trim() ?? "",
                description:
                    row.querySelector<HTMLTextAreaElement>(
                        ".service-description",
                    )?.value.trim() ?? "",
            }))
            .filter((service) => service.name);

        if (offerPreviewName && nameInput) {
            offerPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (offerPreviewCategory && categoryText) {
            offerPreviewCategory.textContent = categoryText;
        }

        if (servicesPreview && servicesPreviewEmpty) {
            servicesPreview
                .querySelectorAll("[data-service-preview]")
                .forEach((item) => item.remove());

            servicesPreviewEmpty.hidden = services.length > 0;

            services.forEach((service) => {
                const item = document.createElement("div");
                item.dataset.servicePreview = "true";

                const title = document.createElement("p");
                title.className =
                    "text-sm font-black text-slate-950";
                title.textContent = service.name;

                item.appendChild(title);

                if (service.description) {
                    const description =
                        document.createElement("p");
                    description.className =
                        "mt-0.5 text-sm leading-relaxed text-slate-500";
                    description.textContent =
                        service.description;
                    item.appendChild(description);
                }

                servicesPreview.appendChild(item);
            });
        }

        if (socialPreview) {
            socialPreview.replaceChildren();

            document
                .querySelectorAll<HTMLElement>(".social-row")
                .forEach((row) => {
                    const toggle =
                        row.querySelector<HTMLButtonElement>(
                            ".social-toggle",
                        );

                    const url =
                        row.querySelector<HTMLInputElement>(
                            ".social-url",
                        );

                    if (
                        toggle?.getAttribute("aria-pressed") !==
                            "true" ||
                        !url?.value.trim()
                    ) {
                        return;
                    }

                    const chip =
                        document.createElement("span");

                    chip.className =
                        "rounded-full bg-violet-50 px-3 py-1.5 text-xs font-bold text-violet-800";
                    chip.textContent =
                        toggle.textContent?.trim() ?? "";

                    socialPreview.appendChild(chip);
                });
        }

        offerContinueButton?.toggleAttribute(
            "disabled",
            services.length === 0,
        );
    }

    function bindServiceRow(row: HTMLElement) {
        row.querySelectorAll<
            HTMLInputElement | HTMLTextAreaElement
        >("input, textarea").forEach((input) => {
            input.addEventListener(
                "input",
                updateOfferPreview,
            );
        });

        row.querySelector<HTMLButtonElement>(
            ".service-remove",
        )?.addEventListener("click", () => {
