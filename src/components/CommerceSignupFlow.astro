            >
                <button
                    id="description-checkpoint-back"
                    type="button"
                    class="rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700 transition hover:border-slate-950 hover:text-slate-950"
                >
                    ← {text.back}
                </button>

                <button
                    id="description-checkpoint-next"
                    type="button"
                    class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-sky-700"
