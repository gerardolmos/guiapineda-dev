              previewShort:
                  "Aquí apareixerà la presentació curta del teu negoci.",
              previewLong:
                  "I aquí, una mica més sobre tot el que oferiu.",
              descriptionDoneTitle: "Molt bé. Ara ja us coneixem una mica més.",
              descriptionDoneText:
                  "El següent serà molt fàcil: on sou i com pot contactar la gent amb vosaltres.",
              contactNext: "Seguim",
              contactSection: "On trobar-vos",
              contactProgress: "Posem-vos al mapa",
              contactTitle: "On us trobem?",
              contactIntro:
                  "Adreça i contacte, tot en un sol lloc. No cal omplir-ho tot: només el que realment utilitzeu.",
              addressLabel: "Quina és la vostra adreça?",
              addressPlaceholder: "Carrer, número, local...",
              contactWaysTitle: "Com pot contactar la gent amb vosaltres?",
              contactWaysHelp:
                  "Necessitem com a mínim una forma de contacte.",
              phoneLabel: "Telèfon",
              phonePlaceholder: "93 000 00 00",
              whatsappSame: "Aquest número també té WhatsApp",
              whatsappLabel: "WhatsApp",
              whatsappPlaceholder: "600 000 000",
              emailLabel: "Correu electrònic",
              emailPlaceholder: "hola@elteunegoci.cat",
              webLabel: "Web",
              webPlaceholder: "www.elteunegoci.cat",
              optional: "Opcional",
              contactContinue: "Ja ho tenim",
              contactPreview: "Cada vegada sembla més una fitxa real",
              previewAddress: "Aquí apareixerà la vostra adreça",
              previewContactEmpty:
                  "Quan afegiu una forma de contacte, la veureu aquí.",
              contactDoneTitle: "Perfecte. Ja sabem com trobar-vos.",
              contactDoneText:
                  "Ara arriba una de les parts més útils: explicar quan obriu i com ateneu els vostres clients.",
          }
        : {
              eyebrow: "Forma parte de GUIAPINEDA",
              welcomeTitle: "Haz crecer tu comercio.",
              welcomeText:
                  "En pocos minutos prepararemos juntos tu ficha. Sin formularios eternos.",
              start: "Empezamos",
              languageCa: "Català",
              languageEs: "Español",
              section: "Tu comercio",
              progress: "Empecemos por lo más fácil",
              title: "Háblanos de tu negocio",
              intro:
                  "Con tres datos ya podemos empezar a dar forma a tu ficha.",
              nameLabel: "¿Cómo se llama tu negocio?",
              namePlaceholder: "Nombre del comercio",
              categoryLabel: "¿A qué os dedicáis?",
              categoryHelp: "Elige la categoría que mejor os representa.",
              subcategoryLabel: "Concretemos un poco más",
              subcategoryHelp:
                  "Ahora elige la opción que describe mejor vuestra actividad.",
              continue: "Continuar",
              previewLabel: "Así empieza tu ficha",
              previewName: "Tu negocio",
              previewCategory: "Categoría · Subcategoría",
              doneTitle: "Perfecto. Ya tenemos la base.",
              doneText:
                  "Lo siguiente será explicar, de forma muy sencilla, qué hacéis y qué os hace especiales.",
              back: "Volver",
              next: "Seguimos",
              descriptionSection: "Qué hacéis",
              descriptionProgress: "Ahora contamos qué os hace especiales",
              descriptionTitle: "Cuéntanos qué hacéis",
              descriptionIntro:
                  "No hace falta escribir como una empresa. Cuéntalo como se lo explicarías a alguien que entra por primera vez en tu negocio.",
              shortLabel: "En una frase, ¿qué encontrará la gente?",
              shortHelp:
                  "Esta será la presentación rápida de tu comercio.",
              shortPlaceholder:
                  "Por ejemplo: Pan artesano, bollería y pasteles hechos cada día en nuestro obrador.",
              longLabel: "¿Y si quieren conoceros un poco mejor?",
              longHelp:
                  "Cuenta qué hacéis, qué os diferencia, especialidades o cualquier cosa que ayude a conoceros mejor.",
              longPlaceholder:
                  "Háblanos de vuestro negocio con tus propias palabras...",
              descriptionContinue: "Ya lo tenemos",
              descriptionPreview: "Tu ficha va tomando forma",
              previewShort:
                  "Aquí aparecerá la presentación corta de tu negocio.",
              previewLong:
                  "Y aquí, un poco más sobre todo lo que ofrecéis.",
              descriptionDoneTitle: "Muy bien. Ahora ya os conocemos un poco más.",
              descriptionDoneText:
                  "Lo siguiente será muy fácil: dónde estáis y cómo puede contactar la gente con vosotros.",
              contactNext: "Seguimos",
              contactSection: "Dónde encontraros",
              contactProgress: "Vamos a poneros en el mapa",
              contactTitle: "¿Dónde os encontramos?",
              contactIntro:
                  "Dirección y contacto, todo en un mismo sitio. No hace falta rellenarlo todo: solo lo que realmente utilizáis.",
              addressLabel: "¿Cuál es vuestra dirección?",
              addressPlaceholder: "Calle, número, local...",
              contactWaysTitle: "¿Cómo puede contactar la gente con vosotros?",
              contactWaysHelp:
                  "Necesitamos al menos una forma de contacto.",
              phoneLabel: "Teléfono",
              phonePlaceholder: "93 000 00 00",
              whatsappSame: "Este número también tiene WhatsApp",
              whatsappLabel: "WhatsApp",
              whatsappPlaceholder: "600 000 000",
              emailLabel: "Correo electrónico",
              emailPlaceholder: "hola@tunegocio.es",
              webLabel: "Web",
              webPlaceholder: "www.tunegocio.es",
              optional: "Opcional",
              contactContinue: "Ya lo tenemos",
              contactPreview: "Cada vez se parece más a una ficha real",
              previewAddress: "Aquí aparecerá vuestra dirección",
              previewContactEmpty:
                  "Cuando añadas una forma de contacto, la verás aquí.",
              contactDoneTitle: "Perfecto. Ya sabemos cómo encontraros.",
              contactDoneText:
                  "Ahora llega una de las partes más útiles: explicar cuándo abrís y cómo atendéis a vuestros clientes.",
          };

const caHref = "/alta-comerc";
const esHref = "/es/alta-comercio";
---

<div class="bg-stone-50">
    <section
        id="signup-welcome"
        class="flex min-h-[72vh] items-center px-5 py-16 sm:px-8"
    >
        <div class="mx-auto w-full max-w-5xl">
            <div class="mb-8 flex justify-end">
                <div
                    class="inline-flex rounded-full border border-slate-200 bg-white p-1 text-sm shadow-sm"
                    aria-label="Idioma"
                >
                    <a
                        href={caHref}
                        class:list={[
                            "rounded-full px-4 py-2 font-semibold transition",
                            lang === "ca"
                                ? "bg-slate-950 text-white"
                                : "text-slate-600 hover:text-slate-950",
                        ]}
                    >
                        {text.languageCa}
                    </a>

                    <a
                        href={esHref}
                        class:list={[
                            "rounded-full px-4 py-2 font-semibold transition",
                            lang === "es"
                                ? "bg-slate-950 text-white"
                                : "text-slate-600 hover:text-slate-950",
                        ]}
                    >
                        {text.languageEs}
                    </a>
                </div>
            </div>

            <div
                class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm"
            >
                <div
                    class="grid gap-0 lg:grid-cols-[1.15fr_0.85fr]"
                >
                    <div class="px-7 py-10 sm:px-12 sm:py-14">
                        <p
                            class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-sky-700"
                        >
                            {text.eyebrow}
                        </p>

                        <h1
                            class="max-w-2xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"
                        >
                            {text.welcomeTitle}
                        </h1>

                        <p
                            class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600"
                        >
                            {text.welcomeText}
                        </p>

                        <button
                            id="signup-start"
                            type="button"
                            class="mt-9 inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500"
                        >
                            {text.start}
                            <span aria-hidden="true" class="ml-3">→</span>
                        </button>
                    </div>

                    <div
                        class="relative min-h-72 overflow-hidden bg-sky-100 p-8 sm:p-12"
                        aria-hidden="true"
                    >
                        <div
                            class="absolute -right-12 -top-16 size-52 rounded-full bg-amber-300/70"
                        >
                        </div>
                        <div
                            class="absolute -bottom-20 -left-12 size-64 rounded-full bg-fuchsia-300/50"
                        >
                        </div>

                        <div
                            class="relative flex h-full min-h-64 items-center justify-center"
                        >
                            <div
                                class="w-full max-w-xs -rotate-2 rounded-3xl bg-white p-5 shadow-xl"
                            >
                                <div
                                    class="mb-4 aspect-[4/3] rounded-2xl bg-slate-200"
                                >
                                </div>
                                <div
                                    class="h-4 w-2/3 rounded-full bg-slate-950"
                                >
                                </div>
                                <div
                                    class="mt-3 h-3 w-1/2 rounded-full bg-slate-200"
                                >
                                </div>
                                <div
                                    class="mt-6 h-10 rounded-xl bg-cyan-400"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section
        id="signup-business"
        hidden
        class="px-5 py-10 sm:px-8 sm:py-14"
    >
        <div class="mx-auto max-w-6xl">
            <div class="mb-8">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <p class="font-bold text-slate-950">
                        {text.section}
                    </p>

                    <div class="flex items-center gap-1.5" aria-hidden="true">
                        <span class="h-2 w-10 rounded-full bg-sky-500"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                    </div>
                </div>

                <p class="text-sm font-semibold text-sky-700">
                    {text.progress}
                </p>
            </div>

            <div
                class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"
            >
                <div
                    class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
                >
                    <h2
                        class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
                    >
                        {text.title}
                    </h2>

                    <p class="mt-3 max-w-2xl text-slate-600">
                        {text.intro}
                    </p>

                    <div class="mt-9">
                        <label
                            for="business-name"
                            class="block text-lg font-bold text-slate-950"
                        >
                            {text.nameLabel}
                        </label>

                        <input
                            id="business-name"
                            name="nombre"
                            type="text"
                            autocomplete="organization"
                            maxlength="100"
                            placeholder={text.namePlaceholder}
                            class="mt-3 w-full rounded-2xl border border-slate-300 bg-white px-5 py-4 text-lg font-semibold text-slate-950 outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-sky-500 focus:ring-4 focus:ring-sky-100"
                        />
                    </div>

                    <fieldset class="mt-9">
                        <legend
                            class="text-lg font-bold text-slate-950"
                        >
                            {text.categoryLabel}
                        </legend>

                        <p class="mt-1 text-sm text-slate-500">
                            {text.categoryHelp}
                        </p>

                        <div
                            id="category-options"
                            class="mt-4 flex flex-wrap gap-2"
                        >
                            {
                                categorias.map((categoria) => (
                                    <button
                                        type="button"
                                        data-category-id={categoria.id}
                                        data-category-label={categoria.label}
                                        aria-pressed="false"
                                        class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-sky-400 hover:bg-sky-50 aria-pressed:border-sky-500 aria-pressed:bg-sky-100 aria-pressed:text-sky-950"
                                    >
                                        {categoria.label}
                                    </button>
                                ))
                            }
                        </div>
                    </fieldset>

                    <fieldset id="subcategory-block" hidden class="mt-9">
                        <legend
                            class="text-lg font-bold text-slate-950"
                        >
                            {text.subcategoryLabel}
                        </legend>

                        <p class="mt-1 text-sm text-slate-500">
                            {text.subcategoryHelp}
                        </p>

                        <div
                            id="subcategory-options"
                            class="mt-4 flex flex-wrap gap-2"
                        >
                            {
                                subcategorias.map((subcategoria) => (
                                    <button
                                        type="button"
                                        data-subcategory-id={subcategoria.id}
                                        data-parent-id={subcategoria.categoriaId}
                                        data-subcategory-label={subcategoria.label}
                                        aria-pressed="false"
                                        hidden
                                        class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-amber-400 hover:bg-amber-50 aria-pressed:border-amber-500 aria-pressed:bg-amber-100 aria-pressed:text-amber-950"
                                    >
                                        {subcategoria.label}
                                    </button>
                                ))
                            }
                        </div>
                    </fieldset>

                    <input id="selected-category" type="hidden" />
                    <input id="selected-subcategory" type="hidden" />

                    <div
                        class="mt-10 flex justify-end border-t border-slate-100 pt-6"
                    >
                        <button
                            id="business-continue"
                            type="button"
                            disabled
                            class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-sky-700 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400"
                        >
                            {text.continue}
                            <span aria-hidden="true" class="ml-3">→</span>
                        </button>
                    </div>
                </div>

                <aside
                    class="lg:sticky lg:top-28"
                    aria-live="polite"
                    aria-atomic="true"
                >
                    <p
                        class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
                    >
                        {text.previewLabel}
                    </p>

                    <div
                        class="overflow-hidden rounded-[1.7rem] border border-slate-200 bg-white shadow-sm"
                    >
                        <div class="relative aspect-[4/3] bg-slate-200">
                            <div
                                class="absolute bottom-4 left-4 flex size-16 items-center justify-center rounded-2xl border-4 border-white bg-amber-300 text-xl font-black text-slate-950 shadow"
                            >
                                GP
                            </div>
                        </div>

                        <div class="p-5">
                            <p
                                id="preview-category"
                                class="text-sm font-bold text-sky-700"
                            >
                                {text.previewCategory}
                            </p>

                            <h3
                                id="preview-name"
                                class="mt-2 text-2xl font-black tracking-tight text-slate-950"
                            >
                                {text.previewName}
                            </h3>

                            <div
                                class="mt-5 h-2 w-full rounded-full bg-slate-100"
                            >
                                <div
                                    class="h-2 w-1/3 rounded-full bg-amber-400"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <section
        id="signup-checkpoint"
        hidden
        class="flex min-h-[65vh] items-center px-5 py-16 sm:px-8"
    >
        <div
            class="mx-auto w-full max-w-3xl rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12"
        >
            <div
                class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-100 text-2xl font-black text-emerald-700"
                aria-hidden="true"
            >
                ✓
            </div>

            <h2
                class="mt-6 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
            >
                {text.doneTitle}
            </h2>

            <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
                {text.doneText}
            </p>

            <div
                class="mt-8 flex flex-wrap items-center justify-center gap-3"
            >
                <button
                    id="checkpoint-back"
                    type="button"
                    class="rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700 transition hover:border-slate-950 hover:text-slate-950"
                >
                    ← {text.back}
                </button>

                <button
                    id="checkpoint-next"
                    type="button"
                    class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-sky-700"
                >
                    {text.next}
                    <span aria-hidden="true" class="ml-3">→</span>
                </button>
            </div>
        </div>
    </section>

    <section
        id="signup-description"
        hidden
        class="px-5 py-10 sm:px-8 sm:py-14"
    >
        <div class="mx-auto max-w-6xl">
            <div class="mb-8">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <p class="font-bold text-slate-950">
                        {text.descriptionSection}
                    </p>

                    <div class="flex items-center gap-1.5" aria-hidden="true">
                        <span class="h-2 w-5 rounded-full bg-sky-500"></span>
                        <span class="h-2 w-10 rounded-full bg-fuchsia-500"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                    </div>
                </div>

                <p class="text-sm font-semibold text-fuchsia-700">
                    {text.descriptionProgress}
                </p>
            </div>

            <div
                class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"
            >
                <div
                    class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
                >
                    <h2
                        class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
                    >
                        {text.descriptionTitle}
                    </h2>

                    <p class="mt-3 max-w-2xl text-slate-600">
                        {text.descriptionIntro}
                    </p>

                    <div class="mt-9">
                        <div
                            class="flex items-end justify-between gap-4"
                        >
                            <div>
                                <label
                                    for="business-short-description"
                                    class="block text-lg font-bold text-slate-950"
                                >
                                    {text.shortLabel}
                                </label>

                                <p class="mt-1 text-sm text-slate-500">
                                    {text.shortHelp}
                                </p>
                            </div>

                            <span
                                id="short-description-count"
                                class="shrink-0 text-xs font-semibold text-slate-400"
                            >
                                0 / 160
                            </span>
                        </div>

                        <textarea
                            id="business-short-description"
                            name="descripcion_corta"
                            rows="3"
                            maxlength="160"
                            placeholder={text.shortPlaceholder}
                            class="mt-3 w-full resize-none rounded-2xl border border-slate-300 bg-white px-5 py-4 text-base leading-relaxed text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-100"
                        ></textarea>
                    </div>

                    <div
                        class="my-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"
                    >
                    </div>

                    <div>
                        <div
                            class="flex items-end justify-between gap-4"
                        >
                            <div>
                                <label
                                    for="business-long-description"
                                    class="block text-lg font-bold text-slate-950"
                                >
                                    {text.longLabel}
                                </label>

                                <p class="mt-1 max-w-2xl text-sm text-slate-500">
                                    {text.longHelp}
                                </p>
                            </div>

                            <span
                                id="long-description-count"
                                class="shrink-0 text-xs font-semibold text-slate-400"
                            >
                                0 / 900
                            </span>
                        </div>

                        <textarea
                            id="business-long-description"
                            name="descripcion_completa"
                            rows="7"
                            maxlength="900"
                            placeholder={text.longPlaceholder}
                            class="mt-3 w-full resize-y rounded-2xl border border-slate-300 bg-white px-5 py-4 text-base leading-relaxed text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-100"
                        ></textarea>
                    </div>

                    <div
                        class="mt-10 flex items-center justify-between gap-4 border-t border-slate-100 pt-6"
                    >
                        <button
                            id="description-back"
                            type="button"
