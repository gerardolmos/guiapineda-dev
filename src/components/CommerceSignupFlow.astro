            </div>

            <div
                class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"
            >
                <div
                    class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
                >
                    <h2
                        class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
                    >
