    </section>

    <section
        id="signup-contact"
        hidden
        class="px-5 py-10 sm:px-8 sm:py-14"
    >
        <div class="mx-auto max-w-6xl">
            <div class="mb-8">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <p class="font-bold text-slate-950">
                        {text.contactSection}
                    </p>

                    <div class="flex items-center gap-1.5" aria-hidden="true">
                        <span class="h-2 w-5 rounded-full bg-sky-500"></span>
                        <span class="h-2 w-5 rounded-full bg-fuchsia-500"></span>
                        <span class="h-2 w-10 rounded-full bg-amber-500"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                    </div>
                </div>

                <p class="text-sm font-semibold text-amber-700">
                    {text.contactProgress}
