const days =
    lang === "ca"
        ? [
              ["lunes", "Dilluns"],
              ["martes", "Dimarts"],
              ["miercoles", "Dimecres"],
              ["jueves", "Dijous"],
              ["viernes", "Divendres"],
              ["sabado", "Dissabte"],
              ["domingo", "Diumenge"],
          ]
        : [
              ["lunes", "Lunes"],
              ["martes", "Martes"],
              ["miercoles", "Miércoles"],
              ["jueves", "Jueves"],
              ["viernes", "Viernes"],
              ["sabado", "Sábado"],
              ["domingo", "Domingo"],
          ];

const caHref = "/alta-comerc";
const esHref = "/es/alta-comercio";
---

<div class="bg-stone-50">
    <section
        id="signup-welcome"
        class="flex min-h-[72vh] items-center px-5 py-16 sm:px-8"
    >
        <div class="mx-auto w-full max-w-5xl">
            <div class="mb-8 flex justify-end">
                <div
                    class="inline-flex rounded-full border border-slate-200 bg-white p-1 text-sm shadow-sm"
                    aria-label="Idioma"
                >
                    <a
                        href={caHref}
                        class:list={[
                            "rounded-full px-4 py-2 font-semibold transition",
                            lang === "ca"
                                ? "bg-slate-950 text-white"
                                : "text-slate-600 hover:text-slate-950",
                        ]}
                    >
                        {text.languageCa}
                    </a>

                    <a
                        href={esHref}
                        class:list={[
                            "rounded-full px-4 py-2 font-semibold transition",
                            lang === "es"
                                ? "bg-slate-950 text-white"
                                : "text-slate-600 hover:text-slate-950",
                        ]}
                    >
                        {text.languageEs}
                    </a>
                </div>
            </div>

            <div
                class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm"
            >
                <div
                    class="grid gap-0 lg:grid-cols-[1.15fr_0.85fr]"
                >
                    <div class="px-7 py-10 sm:px-12 sm:py-14">
                        <p
                            class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-sky-700"
                        >
                            {text.eyebrow}
                        </p>

                        <h1
                            class="max-w-2xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"
                        >
                            {text.welcomeTitle}
                        </h1>

                        <p
                            class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600"
                        >
                            {text.welcomeText}
                        </p>

                        <button
                            id="signup-start"
                            type="button"
                            class="mt-9 inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-sky-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500"
                        >
                            {text.start}
                            <span aria-hidden="true" class="ml-3">→</span>
                        </button>
                    </div>

                    <div
                        class="relative min-h-72 overflow-hidden bg-sky-100 p-8 sm:p-12"
                        aria-hidden="true"
                    >
                        <div
                            class="absolute -right-12 -top-16 size-52 rounded-full bg-amber-300/70"
                        >
                        </div>
                        <div
                            class="absolute -bottom-20 -left-12 size-64 rounded-full bg-fuchsia-300/50"
                        >
                        </div>

                        <div
                            class="relative flex h-full min-h-64 items-center justify-center"
                        >
                            <div
                                class="w-full max-w-xs -rotate-2 rounded-3xl bg-white p-5 shadow-xl"
                            >
                                <div
                                    class="mb-4 aspect-[4/3] rounded-2xl bg-slate-200"
                                >
                                </div>
                                <div
                                    class="h-4 w-2/3 rounded-full bg-slate-950"
                                >
                                </div>
                                <div
                                    class="mt-3 h-3 w-1/2 rounded-full bg-slate-200"
                                >
                                </div>
                                <div
                                    class="mt-6 h-10 rounded-xl bg-cyan-400"
                                >
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section
        id="signup-business"
        hidden
        class="px-5 py-10 sm:px-8 sm:py-14"
    >
        <div class="mx-auto max-w-6xl">
            <div class="mb-8">
                <div class="mb-4 flex items-center justify-between gap-4">
                    <p class="font-bold text-slate-950">
                        {text.section}
                    </p>

                    <div class="flex items-center gap-1.5" aria-hidden="true">
                        <span class="h-2 w-10 rounded-full bg-sky-500"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                        <span class="h-2 w-5 rounded-full bg-slate-200"></span>
                    </div>
                </div>

                <p class="text-sm font-semibold text-sky-700">
                    {text.progress}
                </p>
            </div>

            <div
                class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"
            >
                <div
                    class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-9"
                >
                    <h2
                        class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
                    >
                        {text.title}
                    </h2>

                    <p class="mt-3 max-w-2xl text-slate-600">
                        {text.intro}
                    </p>

                    <div class="mt-9">
                        <label
                            for="business-name"
                            class="block text-lg font-bold text-slate-950"
                        >
                            {text.nameLabel}
                        </label>

                        <input
                            id="business-name"
                            name="nombre"
                            type="text"
                            autocomplete="organization"
                            maxlength="100"
                            placeholder={text.namePlaceholder}
                            class="mt-3 w-full rounded-2xl border border-slate-300 bg-white px-5 py-4 text-lg font-semibold text-slate-950 outline-none transition placeholder:font-normal placeholder:text-slate-400 focus:border-sky-500 focus:ring-4 focus:ring-sky-100"
                        />
                    </div>

                    <fieldset class="mt-9">
                        <legend
                            class="text-lg font-bold text-slate-950"
                        >
                            {text.categoryLabel}
                        </legend>

                        <p class="mt-1 text-sm text-slate-500">
                            {text.categoryHelp}
                        </p>

                        <div
                            id="category-options"
                            class="mt-4 flex flex-wrap gap-2"
                        >
                            {
                                categorias.map((categoria) => (
                                    <button
                                        type="button"
                                        data-category-id={categoria.id}
                                        data-category-label={categoria.label}
                                        aria-pressed="false"
                                        class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-sky-400 hover:bg-sky-50 aria-pressed:border-sky-500 aria-pressed:bg-sky-100 aria-pressed:text-sky-950"
                                    >
                                        {categoria.label}
                                    </button>
                                ))
                            }
                        </div>
                    </fieldset>

                    <fieldset id="subcategory-block" hidden class="mt-9">
                        <legend
                            class="text-lg font-bold text-slate-950"
                        >
                            {text.subcategoryLabel}
                        </legend>

