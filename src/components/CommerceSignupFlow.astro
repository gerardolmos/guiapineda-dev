                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            {text.attentionHelp}
                        </p>

                        <div
                            id="attention-options"
                            class="mt-4 flex flex-wrap gap-2"
                        >
                            {
                                [
                                    ["presencial", text.presencial],
                                    ["domicilio", text.domicilio],
                                    ["online", text.online],
                                    ["recogida", text.recogida],
                                    ["reparto", text.reparto],
                                ].map(([value, label]) => (
                                    <button
                                        type="button"
                                        data-attention={value}
                                        aria-pressed="false"
                                        class="rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:border-emerald-400 hover:bg-emerald-50 aria-pressed:border-emerald-500 aria-pressed:bg-emerald-100 aria-pressed:text-emerald-950"
                                    >
                                        {label}
                                    </button>
                                ))
                            }
                        </div>
                    </div>

                    <div
                        class="mt-10 flex items-center justify-between gap-4 border-t border-slate-100 pt-6"
                    >
                        <button
                            id="hours-back"
                            type="button"
                            class="rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700 transition hover:border-slate-950 hover:text-slate-950"
                        >
                            ← {text.back}
                        </button>

                        <button
                            id="hours-continue"
                            type="button"
                            disabled
                            class="inline-flex min-h-12 items-center justify-center rounded-full bg-slate-950 px-7 py-3 font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-400"
                        >
                            {text.hoursContinue}
                            <span aria-hidden="true" class="ml-3">→</span>
                        </button>
                    </div>
                </div>

                <aside class="lg:sticky lg:top-28">
                    <p
                        class="mb-3 text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
                    >
                        {text.hoursPreview}
                    </p>

                    <div
                        class="rounded-[1.7rem] border border-slate-200 bg-cyan-50 p-5 shadow-sm"
                    >
                        <div
                            id="hours-preview-list"
                            class="space-y-2"
                        >
                            {
                                days.map(([value, label]) => (
                                    <div
                                        class="flex items-start justify-between gap-4 border-b border-cyan-100 py-2 last:border-0"
                                        data-preview-day={value}
                                    >
                                        <span
                                            class="text-sm font-bold text-slate-950"
                                        >
                                            {label}
                                        </span>

                                        <span
                                            class="preview-day-value text-right text-sm text-slate-400"
                                        >
                                            {text.unresolvedDay}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <section
        id="signup-hours-checkpoint"
        hidden
        class="flex min-h-[65vh] items-center px-5 py-16 sm:px-8"
    >
        <div
            class="mx-auto w-full max-w-3xl rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12"
        >
            <div
                class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-100 text-2xl font-black text-emerald-700"
                aria-hidden="true"
            >
                ✓
            </div>

            <h2
                class="mt-6 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
            >
                {text.hoursDoneTitle}
            </h2>

            <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
                {text.hoursDoneText}
            </p>

            <button
                id="hours-checkpoint-back"
                type="button"
                class="mt-8 rounded-full border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700 transition hover:border-slate-950 hover:text-slate-950"
            >
                ← {text.back}
            </button>
        </div>
    </section>
</div>

<script>
    const welcome = document.getElementById("signup-welcome");
    const business = document.getElementById("signup-business");
    const checkpoint = document.getElementById("signup-checkpoint");
    const description = document.getElementById("signup-description");
    const descriptionCheckpoint = document.getElementById(
        "signup-description-checkpoint",
    );
    const contact = document.getElementById("signup-contact");
    const contactCheckpoint = document.getElementById(
        "signup-contact-checkpoint",
    );
    const hours = document.getElementById("signup-hours");
    const hoursCheckpoint = document.getElementById(
        "signup-hours-checkpoint",
    );

    const startButton = document.getElementById("signup-start");
    const backButton = document.getElementById("checkpoint-back");
    const checkpointNextButton =
        document.getElementById("checkpoint-next");
    const continueButton = document.getElementById("business-continue");
    const descriptionBackButton =
        document.getElementById("description-back");
    const descriptionContinueButton =
        document.getElementById("description-continue");
    const descriptionCheckpointBackButton =
        document.getElementById("description-checkpoint-back");
    const descriptionCheckpointNextButton =
        document.getElementById("description-checkpoint-next");

    const contactBackButton =
        document.getElementById("contact-back");
    const contactContinueButton =
        document.getElementById("contact-continue");
    const contactCheckpointBackButton =
        document.getElementById("contact-checkpoint-back");
    const contactCheckpointNextButton =
        document.getElementById("contact-checkpoint-next");

    const hoursBackButton =
        document.getElementById("hours-back");
    const hoursContinueButton =
        document.getElementById("hours-continue");
    const hoursCheckpointBackButton =
        document.getElementById("hours-checkpoint-back");

    const copyMondayWeekdays =
        document.getElementById("copy-monday-weekdays");
    const copyMondayAll =
        document.getElementById("copy-monday-all");

    const scheduleRows = Array.from(
        document.querySelectorAll<HTMLElement>(".schedule-day"),
    );

    const attentionButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-attention]",
        ),
    );

    const addressInput = document.getElementById(
        "business-address",
    ) as HTMLInputElement | null;

    const phoneInput = document.getElementById(
        "business-phone",
    ) as HTMLInputElement | null;

    const whatsappInput = document.getElementById(
        "business-whatsapp",
    ) as HTMLInputElement | null;

    const emailInput = document.getElementById(
        "business-email",
    ) as HTMLInputElement | null;

    const webInput = document.getElementById(
        "business-web",
    ) as HTMLInputElement | null;

    const whatsappSamePhone = document.getElementById(
        "whatsapp-same-phone",
    ) as HTMLInputElement | null;

    const contactPreviewName =
        document.getElementById("contact-preview-name");
    const contactPreviewCategory =
        document.getElementById("contact-preview-category");
    const contactPreviewShort =
        document.getElementById("contact-preview-short");
    const contactPreviewAddress =
        document.getElementById("contact-preview-address");
    const contactPreviewMethods =
        document.getElementById("contact-preview-methods");
    const contactPreviewEmpty =
        document.getElementById("contact-preview-empty");

    const shortDescription = document.getElementById(
        "business-short-description",
    ) as HTMLTextAreaElement | null;

    const longDescription = document.getElementById(
        "business-long-description",
    ) as HTMLTextAreaElement | null;

    const shortDescriptionCount =
        document.getElementById("short-description-count");
    const longDescriptionCount =
        document.getElementById("long-description-count");

    const descriptionPreviewName =
        document.getElementById("description-preview-name");
    const descriptionPreviewCategory =
        document.getElementById("description-preview-category");
    const descriptionPreviewShort =
        document.getElementById("description-preview-short");
    const descriptionPreviewLong =
        document.getElementById("description-preview-long");

    const nameInput = document.getElementById(
        "business-name",
    ) as HTMLInputElement | null;

    const categoryInput = document.getElementById(
        "selected-category",
    ) as HTMLInputElement | null;

    const subcategoryInput = document.getElementById(
        "selected-subcategory",
    ) as HTMLInputElement | null;

    const categoryButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-category-id]",
        ),
    );

    const subcategoryButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-subcategory-id]",
        ),
    );

    const subcategoryBlock =
        document.getElementById("subcategory-block");

    const previewName = document.getElementById("preview-name");
    const previewCategory =
        document.getElementById("preview-category");

    let categoryLabel = "";
    let subcategoryLabel = "";

    function showScreen(
        target: HTMLElement | null,
        ...others: Array<HTMLElement | null>
    ) {
        others.forEach((item) => {
            if (item) item.hidden = true;
        });

        if (target) {
            target.hidden = false;
            window.scrollTo({ top: 0, behavior: "smooth" });
        }
    }

    function updateContinueState() {
        if (!continueButton || !nameInput) return;

        continueButton.toggleAttribute(
            "disabled",
            !(
                nameInput.value.trim() &&
                categoryInput?.value &&
                subcategoryInput?.value
            ),
        );
    }

    function updatePreview() {
        if (previewName && nameInput) {
            previewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (previewCategory && categoryText) {
            previewCategory.textContent = categoryText;
        }

        if (descriptionPreviewName && nameInput) {
            descriptionPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        if (descriptionPreviewCategory && categoryText) {
            descriptionPreviewCategory.textContent = categoryText;
        }

        updateContinueState();
    }

    function formatScheduleTime(value: string) {
        if (!value) return "";

        return value.endsWith(":00")
            ? value.slice(0, -3)
            : value;
    }

    function updateHours() {
        let allDaysResolved = true;
        let hasOpenDay = false;

        scheduleRows.forEach((row) => {
            const closed = row.querySelector<HTMLInputElement>(
                ".schedule-closed",
            );
            const open1 = row.querySelector<HTMLInputElement>(
                ".schedule-open-1",
            );
            const close1 = row.querySelector<HTMLInputElement>(
                ".schedule-close-1",
            );
            const open2 = row.querySelector<HTMLInputElement>(
                ".schedule-open-2",
            );
            const close2 = row.querySelector<HTMLInputElement>(
                ".schedule-close-2",
            );
            const second =
                row.querySelector<HTMLElement>(".schedule-second");

            const day = row.dataset.day ?? "";

            const preview = document.querySelector<HTMLElement>(
                `[data-preview-day="${day}"] .preview-day-value`,
            );

            if (closed?.checked) {
                if (preview) {
                    preview.textContent =
                        document.documentElement.lang === "ca"
                            ? "Tancat"
                            : "Cerrado";
                    preview.className =
                        "preview-day-value text-right text-sm font-semibold text-slate-500";
                }

                return;
            }

            const firstComplete = Boolean(
                open1?.value && close1?.value,
            );

            const secondVisible = second && !second.hidden;

            const secondComplete =
                !secondVisible ||
                Boolean(open2?.value && close2?.value);

            if (!firstComplete || !secondComplete) {
                allDaysResolved = false;

                if (preview) {
                    preview.textContent =
                        document.documentElement.lang === "ca"
                            ? "Per completar"
                            : "Por completar";
                    preview.className =
                        "preview-day-value text-right text-sm text-slate-400";
                }

                return;
            }

            hasOpenDay = true;

            const firstText =
                `${formatScheduleTime(open1?.value ?? "")}–${formatScheduleTime(close1?.value ?? "")}`;

            const secondText =
                secondVisible
                    ? ` · ${formatScheduleTime(open2?.value ?? "")}–${formatScheduleTime(close2?.value ?? "")}`
                    : "";

            if (preview) {
                preview.textContent = firstText + secondText;
                preview.className =
                    "preview-day-value text-right text-sm font-semibold text-slate-700";
            }
        });

        const hasAttention = attentionButtons.some(
            (button) =>
                button.getAttribute("aria-pressed") === "true",
        );

        hoursContinueButton?.toggleAttribute(
            "disabled",
            !(allDaysResolved && hasOpenDay && hasAttention),
        );
    }

    function setClosedState(row: HTMLElement) {
        const closed = row.querySelector<HTMLInputElement>(
            ".schedule-closed",
        );

        const times =
            row.querySelector<HTMLElement>(".schedule-times");

        if (!closed || !times) return;

        const disabled = closed.checked;

        times.classList.toggle("opacity-35", disabled);

        times.querySelectorAll<HTMLInputElement>("input").forEach(
            (input) => {
                input.disabled = disabled;
            },
        );

        times.querySelectorAll<HTMLButtonElement>("button").forEach(
            (button) => {
                button.disabled = disabled;
            },
        );

        updateHours();
    }

    function copyMonday(targetRows: HTMLElement[]) {
        const monday = scheduleRows.find(
            (row) => row.dataset.day === "lunes",
        );

        if (!monday) return;

        const mondayClosed =
            monday.querySelector<HTMLInputElement>(
                ".schedule-closed",
            )?.checked ?? false;

        const mondayOpen1 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-open-1",
            )?.value ?? "";

        const mondayClose1 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-close-1",
            )?.value ?? "";

        const mondayOpen2 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-open-2",
            )?.value ?? "";

        const mondayClose2 =
            monday.querySelector<HTMLInputElement>(
                ".schedule-close-2",
            )?.value ?? "";

        const mondaySecond =
            monday.querySelector<HTMLElement>(
                ".schedule-second",
            );

        const secondVisible =
            mondaySecond && !mondaySecond.hidden;

        targetRows.forEach((row) => {
            if (row === monday) return;

            const closed =
                row.querySelector<HTMLInputElement>(
                    ".schedule-closed",
                );
            const open1 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-open-1",
                );
            const close1 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-close-1",
                );
            const open2 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-open-2",
                );
            const close2 =
                row.querySelector<HTMLInputElement>(
                    ".schedule-close-2",
                );
            const second =
                row.querySelector<HTMLElement>(
                    ".schedule-second",
                );
            const toggle =
                row.querySelector<HTMLButtonElement>(
                    ".schedule-second-toggle",
                );

            if (closed) closed.checked = mondayClosed;
            if (open1) open1.value = mondayOpen1;
            if (close1) close1.value = mondayClose1;
            if (open2) open2.value = mondayOpen2;
            if (close2) close2.value = mondayClose2;

            if (second) {
                second.hidden = !secondVisible;
            }

            if (toggle) {
                toggle.textContent = secondVisible
                    ? toggle.dataset.removeLabel ?? ""
                    : toggle.dataset.addLabel ?? "";
            }

            setClosedState(row);
        });

        updateHours();
    }

    function updateContactPreview() {
        if (contactPreviewName && nameInput) {
            contactPreviewName.textContent =
                nameInput.value.trim() ||
                nameInput.placeholder ||
                "";
        }

        const categoryText =
            categoryLabel && subcategoryLabel
                ? `${categoryLabel} · ${subcategoryLabel}`
                : categoryLabel;

        if (contactPreviewCategory && categoryText) {
            contactPreviewCategory.textContent = categoryText;
        }

        if (contactPreviewShort && shortDescription) {
            contactPreviewShort.textContent =
                shortDescription.value.trim() ||
                shortDescription.placeholder ||
                "";
        }

        if (contactPreviewAddress && addressInput) {
            contactPreviewAddress.textContent =
                addressInput.value.trim() ||
                addressInput.placeholder ||
                "";
        }

        if (contactPreviewMethods && contactPreviewEmpty) {
            contactPreviewMethods
                .querySelectorAll("[data-contact-chip]")
                .forEach((item) => item.remove());

            const methods = [
                {
                    label: "☎",
                    value: phoneInput?.value.trim() || "",
                    className:
                        "bg-sky-50 text-sky-900 border-sky-200",
                },
                {
                    label: "WhatsApp",
                    value: whatsappInput?.value.trim() || "",
                    className:
                        "bg-emerald-50 text-emerald-900 border-emerald-200",
                },
                {
                    label: "@",
                    value: emailInput?.value.trim() || "",
                    className:
                        "bg-violet-50 text-violet-900 border-violet-200",
                },
                {
                    label: "Web",
                    value: webInput?.value.trim() || "",
                    className:
                        "bg-fuchsia-50 text-fuchsia-900 border-fuchsia-200",
                },
            ].filter((item) => item.value);

            contactPreviewEmpty.hidden = methods.length > 0;

            methods.forEach((method) => {
                const chip = document.createElement("span");

                chip.dataset.contactChip = "true";
                chip.className =
                    `inline-flex max-w-full items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-bold ${method.className}`;

                const label = document.createElement("span");
                label.textContent = method.label;

                const value = document.createElement("span");
                value.className = "truncate";
                value.textContent = method.value;

                chip.append(label, value);
                contactPreviewMethods.appendChild(chip);
            });
        }

        const hasContact = Boolean(
            phoneInput?.value.trim() ||
            whatsappInput?.value.trim() ||
            emailInput?.value.trim() ||
            webInput?.value.trim(),
        );

        const emailValid =
            !emailInput?.value.trim() || emailInput.checkValidity();

        if (contactContinueButton) {
            contactContinueButton.toggleAttribute(
                "disabled",
                !(
                    addressInput?.value.trim() &&
                    hasContact &&
                    emailValid
                ),
            );
        }
    }

    function updateDescriptionPreview() {
        if (shortDescriptionCount && shortDescription) {
            shortDescriptionCount.textContent =
                `${shortDescription.value.length} / 160`;
        }

        if (longDescriptionCount && longDescription) {
            longDescriptionCount.textContent =
                `${longDescription.value.length} / 900`;
        }

        if (descriptionPreviewShort && shortDescription) {
            descriptionPreviewShort.textContent =
                shortDescription.value.trim() ||
                shortDescription.placeholder ||
                "";
        }

        if (descriptionPreviewLong && longDescription) {
            descriptionPreviewLong.textContent =
                longDescription.value.trim() ||
                longDescription.placeholder ||
                "";
        }

        if (descriptionContinueButton) {
            descriptionContinueButton.toggleAttribute(
                "disabled",
                !(
                    shortDescription?.value.trim() &&
                    longDescription?.value.trim()
                ),
            );
        }
    }

    startButton?.addEventListener("click", () => {
        showScreen(
            business,
            welcome,
            checkpoint,
            description,
            descriptionCheckpoint,
        );

        window.setTimeout(() => {
            nameInput?.focus();
        }, 250);
    });

    nameInput?.addEventListener("input", updatePreview);

    categoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
            categoryButtons.forEach((item) =>
                item.setAttribute("aria-pressed", "false"),
            );

            button.setAttribute("aria-pressed", "true");

            const categoryId = button.dataset.categoryId ?? "";
            categoryLabel = button.dataset.categoryLabel ?? "";

            if (categoryInput) {
                categoryInput.value = categoryId;
            }

            if (subcategoryInput) {
                subcategoryInput.value = "";
            }

            subcategoryLabel = "";

            subcategoryButtons.forEach((item) => {
                item.setAttribute("aria-pressed", "false");
                item.hidden =
                    item.dataset.parentId !== categoryId;
            });

            if (subcategoryBlock) {
                subcategoryBlock.hidden = false;
            }

            updatePreview();
        });
    });

    subcategoryButtons.forEach((button) => {
        button.addEventListener("click", () => {
            subcategoryButtons.forEach((item) =>
                item.setAttribute("aria-pressed", "false"),
            );

            button.setAttribute("aria-pressed", "true");

            if (subcategoryInput) {
                subcategoryInput.value =
                    button.dataset.subcategoryId ?? "";
            }

            subcategoryLabel =
                button.dataset.subcategoryLabel ?? "";

            updatePreview();
        });
    });

    continueButton?.addEventListener("click", () => {
        if (continueButton.hasAttribute("disabled")) return;

        showScreen(
            checkpoint,
            welcome,
            business,
            description,
            descriptionCheckpoint,
        );
    });

    backButton?.addEventListener("click", () => {
        showScreen(
            business,
            welcome,
            checkpoint,
            description,
            descriptionCheckpoint,
        );
    });

    checkpointNextButton?.addEventListener("click", () => {
        updatePreview();
        updateDescriptionPreview();

        showScreen(
            description,
            welcome,
            business,
            checkpoint,
            descriptionCheckpoint,
        );

        window.setTimeout(() => {
            shortDescription?.focus();
        }, 250);
    });

    shortDescription?.addEventListener(
        "input",
        updateDescriptionPreview,
    );

    longDescription?.addEventListener(
        "input",
        updateDescriptionPreview,
    );

    descriptionBackButton?.addEventListener("click", () => {
        showScreen(
            checkpoint,
            welcome,
            business,
            description,
            descriptionCheckpoint,
        );
    });

    descriptionContinueButton?.addEventListener("click", () => {
        if (
            descriptionContinueButton.hasAttribute("disabled")
        ) {
            return;
        }

        showScreen(
            descriptionCheckpoint,
            welcome,
            business,
            checkpoint,
            description,
        );
    });

    descriptionCheckpointBackButton?.addEventListener(
        "click",
        () => {
            showScreen(
                description,
                welcome,
                business,
                checkpoint,
                descriptionCheckpoint,
                contact,
                contactCheckpoint,
            );
        },
    );

    descriptionCheckpointNextButton?.addEventListener(
        "click",
        () => {
            updatePreview();
            updateDescriptionPreview();
            updateContactPreview();

            showScreen(
                contact,
                welcome,
                business,
                checkpoint,
                description,
                descriptionCheckpoint,
                contactCheckpoint,
            );

            window.setTimeout(() => {
                addressInput?.focus();
            }, 250);
        },
    );

    [
        addressInput,
        phoneInput,
        whatsappInput,
        emailInput,
        webInput,
    ].forEach((input) => {
        input?.addEventListener("input", updateContactPreview);
    });

    whatsappSamePhone?.addEventListener("change", () => {
        if (!whatsappInput || !phoneInput) return;

        if (whatsappSamePhone.checked) {
            whatsappInput.value = phoneInput.value;
            whatsappInput.disabled = true;
        } else {
            whatsappInput.disabled = false;
        }

        updateContactPreview();
    });

    phoneInput?.addEventListener("input", () => {
        if (
            whatsappSamePhone?.checked &&
            whatsappInput
        ) {
            whatsappInput.value = phoneInput.value;
        }

        updateContactPreview();
    });

    contactBackButton?.addEventListener("click", () => {
        showScreen(
            descriptionCheckpoint,
            welcome,
            business,
            checkpoint,
            description,
            contact,
            contactCheckpoint,
        );
    });

    contactContinueButton?.addEventListener("click", () => {
        if (
            contactContinueButton.hasAttribute("disabled")
        ) {
            return;
        }

        showScreen(
            contactCheckpoint,
            welcome,
            business,
            checkpoint,
            description,
            descriptionCheckpoint,
            contact,
        );
    });

    contactCheckpointBackButton?.addEventListener(
        "click",
        () => {
            showScreen(
                contact,
                welcome,
                business,
                checkpoint,
                description,
                descriptionCheckpoint,
                contactCheckpoint,
                hours,
                hoursCheckpoint,
            );
        },
    );

    contactCheckpointNextButton?.addEventListener(
        "click",
        () => {
            updateHours();

            showScreen(
                hours,
                welcome,
                business,
                checkpoint,
                description,
                descriptionCheckpoint,
                contact,
                contactCheckpoint,
                hoursCheckpoint,
            );
        },
    );

    scheduleRows.forEach((row) => {
        const closed =
            row.querySelector<HTMLInputElement>(
                ".schedule-closed",
            );

        const second =
            row.querySelector<HTMLElement>(
                ".schedule-second",
            );

        const secondToggle =
            row.querySelector<HTMLButtonElement>(
                ".schedule-second-toggle",
            );

        closed?.addEventListener("change", () => {
            setClosedState(row);
        });

        row.querySelectorAll<HTMLInputElement>(
            'input[type="time"]',
        ).forEach((input) => {
            input.addEventListener("input", updateHours);
        });

        secondToggle?.addEventListener("click", () => {
            if (!second) return;

            second.hidden = !second.hidden;

            if (second.hidden) {
                second
                    .querySelectorAll<HTMLInputElement>("input")
                    .forEach((input) => {
                        input.value = "";
                    });
            }

            secondToggle.textContent = second.hidden
                ? secondToggle.dataset.addLabel ?? ""
                : secondToggle.dataset.removeLabel ?? "";

            updateHours();
        });
    });

    attentionButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const selected =
                button.getAttribute("aria-pressed") === "true";

            button.setAttribute(
                "aria-pressed",
                String(!selected),
            );

            updateHours();
        });
    });

    copyMondayWeekdays?.addEventListener("click", () => {
        copyMonday(
            scheduleRows.filter((row) =>
                [
                    "lunes",
                    "martes",
                    "miercoles",
                    "jueves",
                    "viernes",
                ].includes(row.dataset.day ?? ""),
            ),
        );
    });

    copyMondayAll?.addEventListener("click", () => {
        copyMonday(scheduleRows);
    });

    hoursBackButton?.addEventListener("click", () => {
        showScreen(
            contactCheckpoint,
            welcome,
            business,
            checkpoint,
            description,
            descriptionCheckpoint,
            contact,
            hours,
            hoursCheckpoint,
        );
    });

    hoursContinueButton?.addEventListener("click", () => {
        if (
            hoursContinueButton.hasAttribute("disabled")
        ) {
            return;
        }

        showScreen(
            hoursCheckpoint,
            welcome,
            business,
            checkpoint,
            description,
            descriptionCheckpoint,
            contact,
            contactCheckpoint,
            hours,
        );
    });

    hoursCheckpointBackButton?.addEventListener(
        "click",
        () => {
            showScreen(
                hours,
                welcome,
                business,
                checkpoint,
                description,
                descriptionCheckpoint,
                contact,
                contactCheckpoint,
                hoursCheckpoint,
            );
        },
    );

    updateHours();
</script>
