---
import { getStrapiMediaUrl } from "../lib/strapi";

const {
    fotoMesImagen,
    fotoMesTitulo,
    fotoMesAutor,
    fotoMesLugar,
    lang = "ca",
    t,
} = Astro.props;

const formUrl =
    lang === "ca" ? "/foto-del-mes" : `/${lang}/foto-del-mes`;

const rules = [
    t.fotoMes.rule1,
    t.fotoMes.rule2,
    t.fotoMes.rule3,
    t.fotoMes.rule4,
    t.fotoMes.rule5,
];
---

<article
    class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(22rem,0.75fr)]"
>
    <div
        class="aspect-[4/3] overflow-hidden bg-slate-200 lg:aspect-auto lg:min-h-[34rem]"
    >
        <img
            src={getStrapiMediaUrl(fotoMesImagen.url)}
            alt={fotoMesTitulo || t.fotoMes.pageTitle}
            width="1400"
            height="1050"
            loading="lazy"
            decoding="async"
            class="size-full object-cover"
        />
    </div>

    <div class="flex flex-col justify-center p-6 sm:p-9 lg:p-12">
        <div class="flex items-center gap-3">
            <span
                aria-hidden="true"
                class="h-px w-10 bg-cyan-600"
            ></span>

            <p
                class="text-sm font-black uppercase tracking-wider text-cyan-800"
            >
                {t.fotoMes.pageTitle}
            </p>
        </div>

        <h2
            id="photo-month-section-title"
            class="mt-6 text-3xl font-black leading-tight tracking-tight text-slate-950 sm:text-4xl"
        >
            {fotoMesTitulo || t.fotoMes.pageTitle}
        </h2>

        <p class="mt-5 text-base leading-7 text-slate-600">
            {t.fotoMes.homeIntro}
        </p>

        {
            (fotoMesAutor || fotoMesLugar) && (
                <div class="mt-7 space-y-3 border-t border-slate-200 pt-6 text-sm text-slate-600">
                    {fotoMesAutor && (
                        <p class="flex items-start gap-3">
                            <svg
                                aria-hidden="true"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="mt-0.5 size-5 shrink-0 text-cyan-700"
                            >
                                <circle cx="12" cy="8" r="4" />
                                <path d="M4 21a8 8 0 0 1 16 0" />
                            </svg>

                            <span>
                                <strong
                                    class="font-semibold text-slate-900"
                                >
                                    {t.fotoMes.authorLabel}
                                </strong>{" "}
                                {fotoMesAutor}
                            </span>
                        </p>
                    )}

                    {fotoMesLugar && (
                        <p class="flex items-start gap-3">
                            <svg
                                aria-hidden="true"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="mt-0.5 size-5 shrink-0 text-cyan-700"
                            >
                                <path
                                    d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"
                                />
                                <circle cx="12" cy="10" r="2" />
                            </svg>

                            <span>
                                <strong
                                    class="font-semibold text-slate-900"
                                >
                                    {t.fotoMes.placeLabel}
                                </strong>{" "}
                                {fotoMesLugar}
                            </span>
                        </p>
                    )}
                </div>
            )
        }

        <button
            type="button"
            id="open-photo-month-modal"
            aria-haspopup="dialog"
            class="mt-8 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-cyan-700 px-6 py-3 text-sm font-bold text-white shadow-sm outline-none transition-colors duration-200 hover:bg-cyan-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
        >
            {t.fotoMes.submitButton}

            <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
            >
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>
        </button>
    </div>
</article>

<dialog
    id="photo-month-modal"
    aria-labelledby="photo-month-modal-title"
    aria-describedby="photo-month-modal-description"
    class="m-auto w-[calc(100%-2rem)] max-w-2xl rounded-3xl border border-slate-200 bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/70"
>
    <div class="max-h-[calc(100dvh-2rem)] overflow-y-auto p-5 sm:p-8">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-sm font-bold text-cyan-700">
                    {t.fotoMes.pageTitle}
                </p>

                <h2
                    id="photo-month-modal-title"
                    class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl"
                >
                    {t.fotoMes.modalTitle}
                </h2>
            </div>

            <button
                type="button"
                data-close-photo-month-modal
                aria-label={t.fotoMes.closeButton}
                class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl border border-slate-300 text-slate-700 outline-none transition-colors duration-200 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600"
            >
                <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="size-5"
                >
                    <path d="M6 6l12 12" />
                    <path d="M18 6 6 18" />
                </svg>
            </button>
        </div>

        <p
            id="photo-month-modal-description"
            class="mt-5 text-lg leading-8 text-slate-700"
        >
            {t.fotoMes.modalIntro}
        </p>

        <ul class="mt-6 space-y-3">
            {
                rules.map((rule: string) => (
                    <li
                        class="flex gap-3 rounded-xl bg-stone-100 p-3 text-base font-medium leading-7 text-slate-800"
                    >
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-0.5 size-5 shrink-0 text-lime-700"
                        >
                            <path d="m5 12 4 4L19 6" />
                        </svg>

                        <span>{rule}</span>
                    </li>
                ))
            }
        </ul>

        <div class="mt-7">
            <a
                href={formUrl}
                class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-cyan-700 px-5 py-3 text-center text-sm font-bold text-white outline-none transition-colors duration-200 hover:bg-cyan-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
            >
                {t.fotoMes.goToForm}
            </a>
        </div>
    </div>
</dialog>

<script>
    const modal = document.getElementById("photo-month-modal");
    const openButton = document.getElementById(
        "open-photo-month-modal",
    );

    if (
        modal instanceof HTMLDialogElement &&
        openButton instanceof HTMLButtonElement
    ) {
        const closeButtons = modal.querySelectorAll(
            "[data-close-photo-month-modal]",
        );

        let lastFocusedElement = null;

        openButton.addEventListener("click", () => {
            lastFocusedElement =
                document.activeElement instanceof HTMLElement
                    ? document.activeElement
                    : null;

            modal.showModal();
        });

        closeButtons.forEach((button) => {
            button.addEventListener("click", () => {
                modal.close();
            });
        });

        modal.addEventListener("click", (event) => {
            if (event.target === modal) {
                modal.close();
            }
        });

        modal.addEventListener("close", () => {
            lastFocusedElement?.focus();
        });
    }
</script>
