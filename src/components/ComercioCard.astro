---
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";
import { getPrimaryMediaUrl } from "../lib/primaryMedia";
import {
    formatCommerceScheduleSummary,
    getCommerceAttentionModes,
} from "../lib/commercePresentation";
import type { Commerce } from "../types/commerce";

interface Props {
    comercio: Commerce;
    categoriaSlug: string;
    subcategoriaSlug?: string;
    lang: "ca" | "es" | "en";
}

const {
    comercio,
    categoriaSlug,
    subcategoriaSlug,
    lang,
} = Astro.props;

const t = getTranslations(lang);

const localizedName = getLocalizedName(comercio, lang);

const descripcion =
    lang === "en"
        ? comercio.descripcion_corta_en ||
          comercio.descripcion_corta
        : comercio.descripcion_corta;

const primaryMedia = Array.isArray(comercio.imagen_principal)
    ? comercio.imagen_principal[0]
    : comercio.imagen_principal;

const imagePath = getPrimaryMediaUrl(comercio.imagen_principal);
const imageUrl = imagePath
    ? getStrapiMediaUrl(imagePath)
    : null;

const imageAlt =
    primaryMedia?.alternativeText?.trim() ||
    localizedName;

const detalleUrl =
    lang === "es"
        ? subcategoriaSlug
            ? `/es/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
            : `/es/${categoriaSlug}/${comercio.slug}`
        : lang === "en"
          ? subcategoriaSlug
              ? `/en/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
              : `/en/${categoriaSlug}/${comercio.slug}`
          : subcategoriaSlug
            ? `/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
            : `/${categoriaSlug}/${comercio.slug}`;

const locationText = [
    comercio.zona?.trim(),
    comercio.direccion?.trim(),
]
    .filter(Boolean)
    .join(" · ");

const highlightedServices = [
    ...(comercio.servicios || []),
]
    .filter((service) => service.destacado)
    .sort(
        (first, second) =>
            (first.orden ?? Number.MAX_SAFE_INTEGER) -
            (second.orden ?? Number.MAX_SAFE_INTEGER),
    )
    .slice(0, 3)
    .map((service) =>
        lang === "en"
            ? service.nombre_en || service.nombre
            : service.nombre,
    );

const scheduleSummary =
    formatCommerceScheduleSummary(
        comercio.horario_semanal,
        lang,
        2,
    );

const attentionModes =
    getCommerceAttentionModes(comercio, lang);
---

<li class="h-full">
    <a
        href={detalleUrl}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm outline-none transition-[border-color,box-shadow] duration-200 hover:border-cyan-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
    >
        <div class="aspect-video overflow-hidden bg-stone-100">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={imageAlt}
                        width="720"
                        height="540"
                        loading="lazy"
                        class="size-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-[1.02]"
                    />
                ) : (
                    <div class="flex size-full flex-col items-center justify-center gap-3 p-6 text-center text-slate-500">
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-10 text-slate-400"
                        >
                            <path d="M3 9h18" />
                            <path d="M5 9v11h14V9" />
                            <path d="m4 9 2-5h12l2 5" />
                            <path d="M9 20v-6h6v6" />
                        </svg>

                        <span class="text-xs font-semibold uppercase tracking-wider">
                            {t.comercios.noImage}
                        </span>
                    </div>
                )
            }
        </div>

        <div class="flex flex-1 flex-col p-4 sm:p-5">
            <h3 class="text-xl font-black leading-tight tracking-tight text-slate-950">
                {localizedName}
            </h3>

            {
                locationText && (
                    <p class="mt-3 flex items-start gap-2 text-sm leading-6 text-slate-600">
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-0.5 size-4 shrink-0 text-cyan-700"
                        >
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2" />
                        </svg>

                        <span>{locationText}</span>
                    </p>
                )
            }

            <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">
                {descripcion || t.common.noDescription}
            </p>

            {
                highlightedServices.length > 0 && (
                    <div class="mt-4 border-t border-slate-100 pt-4">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
                            {t.comercios.servicesLabel}
                        </p>

                        <p class="mt-2 line-clamp-2 text-sm font-semibold leading-6 text-slate-800">
                            {highlightedServices.join(" · ")}
                        </p>
                    </div>
                )
            }

            {
                scheduleSummary.length > 0 && (
                    <div class="mt-3 flex items-start gap-2.5 sm:gap-3">
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-0.5 size-4 shrink-0 text-cyan-700"
                        >
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>

                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
                                {t.comercios.scheduleLabel}
                            </p>

                            <div class="mt-1 space-y-1 text-sm leading-5 text-slate-700">
                                {scheduleSummary.map((summary) => (
                                    <p>{summary}</p>
                                ))}
                            </div>
                        </div>
                    </div>
                )
            }

            {
                attentionModes.length > 0 && (
                    <div class="mt-3 flex items-start gap-2.5 sm:gap-3">
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-0.5 size-4 shrink-0 text-cyan-700"
                        >
                            <path d="M4 20V10l8-6 8 6v10" />
                            <path d="M9 20v-6h6v6" />
                        </svg>

                        <div>
                            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
                                {t.comercios.attentionLabel}
                            </p>

                            <p class="mt-1 text-sm leading-5 text-slate-700">
                                {attentionModes.join(" · ")}
                            </p>
                        </div>
                    </div>
                )
            }

            <span class="mt-auto inline-flex min-h-11 items-end gap-2 border-t border-slate-100 pt-4 text-sm font-bold text-cyan-700">
                {t.common.viewMore}

                <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mb-0.5 size-4 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                >
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </span>
        </div>
    </a>
</li>
