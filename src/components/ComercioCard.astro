---
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";
import { getPrimaryMediaUrl } from "../lib/primaryMedia";
import {
    formatCommerceScheduleSummary,
} from "../lib/commercePresentation";
import type { Commerce } from "../types/commerce";

interface Props {
    comercio: Commerce;
    categoriaSlug: string;
    subcategoriaSlug?: string;
    lang: "ca" | "es" | "en";
}

const {
    comercio,
    categoriaSlug,
    subcategoriaSlug,
    lang,
} = Astro.props;

const t = getTranslations(lang);

const localizedName = getLocalizedName(comercio, lang);

const descripcion =
    lang === "en"
        ? comercio.descripcion_corta_en ||
          comercio.descripcion_corta
        : comercio.descripcion_corta;

const primaryMedia = Array.isArray(comercio.imagen_principal)
    ? comercio.imagen_principal[0]
    : comercio.imagen_principal;

const imagePath = getPrimaryMediaUrl(
    comercio.imagen_principal,
);

const imageUrl = imagePath
    ? getStrapiMediaUrl(imagePath)
    : null;

const imageAlt =
    primaryMedia?.alternativeText?.trim() ||
    localizedName;

const logoMedia = Array.isArray(comercio.logo)
    ? comercio.logo[0]
    : comercio.logo;

const logoUrl =
    logoMedia?.url
        ? getStrapiMediaUrl(logoMedia.url)
        : null;

const logoAlt =
    logoMedia?.alternativeText?.trim() ||
    `Logo ${localizedName}`;

const detalleUrl =
    lang === "es"
        ? subcategoriaSlug
            ? `/es/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
            : `/es/${categoriaSlug}/${comercio.slug}`
        : lang === "en"
          ? subcategoriaSlug
              ? `/en/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
              : `/en/${categoriaSlug}/${comercio.slug}`
          : subcategoriaSlug
            ? `/${categoriaSlug}/${subcategoriaSlug}/${comercio.slug}`
            : `/${categoriaSlug}/${comercio.slug}`;

const locationText = [
    comercio.zona?.trim(),
    comercio.direccion?.trim(),
]
    .filter(Boolean)
    .join(" · ");

const telephone =
    comercio.telefono?.trim() || null;

const scheduleSummary =
    formatCommerceScheduleSummary(
        comercio.horario_semanal,
        lang,
        7,
    );

const phoneLabel =
    lang === "ca"
        ? "Telèfon"
        : lang === "es"
          ? "Teléfono"
          : "Phone";

const scheduleLabel =
    lang === "ca"
        ? "Horari"
        : lang === "es"
          ? "Horario"
          : "Opening hours";
---

<li class="h-full">
    <a
        href={detalleUrl}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md outline-none transition-[transform,border-color,box-shadow] duration-300 motion-safe:hover:-translate-y-1 hover:border-cyan-300 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
    >
        <div class="relative aspect-video overflow-hidden border-b-4 border-amber-500 bg-stone-100">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={imageAlt}
                        width="720"
                        height="405"
                        loading="lazy"
                        class="size-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
                    />
                ) : (
                    <div class="flex size-full items-center justify-center p-6 text-center">
                        <span class="text-sm font-bold uppercase tracking-wider text-slate-500">
                            {t.comercios.noImage}
                        </span>
                    </div>
                )
            }

            {
                logoUrl && (
                    <div class="absolute bottom-4 left-4 flex size-[4.5rem] items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-white p-2 shadow-lg sm:size-20">
                        <img
                            src={logoUrl}
                            alt={logoAlt}
                            loading="lazy"
                            class="size-full object-contain"
                        />
                    </div>
                )
            }
        </div>

        <div class="flex flex-1 flex-col px-5 py-4 sm:px-6">
            <h3 class="text-2xl font-black leading-tight tracking-tight text-slate-950">
                {localizedName}
            </h3>

            {
                locationText && (
                    <p class="mt-2 text-sm font-bold leading-5 text-cyan-700">
                        {locationText}
                    </p>
                )
            }

            {
                telephone && (
                    <div class="mt-3">
                        <p class="text-xs font-black uppercase tracking-wider text-cyan-800">
                            {phoneLabel}
                        </p>

                        <p class="mt-1 text-sm font-bold leading-5 text-slate-800">
                            {telephone}
                        </p>
                    </div>
                )
            }

            <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-600 sm:text-base">
                {descripcion || t.common.noDescription}
            </p>

            {
                scheduleSummary.length > 0 && (
                    <div class="mt-3 border-t border-slate-200 pt-3">
                        <p class="text-xs font-black uppercase tracking-wider text-cyan-800">
                            {scheduleLabel}
                        </p>

                        <div class="mt-1 space-y-0.5 text-sm font-semibold leading-5 text-slate-700">
                            {scheduleSummary.map((summary) => (
                                <p>{summary}</p>
                            ))}
                        </div>
                    </div>
                )
            }
        </div>

        <span class="flex min-h-12 items-center justify-center bg-cyan-700 px-5 py-3 text-center text-sm font-black uppercase tracking-wide text-white transition-colors duration-200 group-hover:bg-cyan-800">
            {t.common.viewMore}
        </span>
    </a>
</li>
