---
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";

interface Props {
    nombre?: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    categoriaSlug: string;
    subcategoriaSlug?: string;
    lang: "ca" | "es" | "en";
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
}

const {
    nombre,
    nombre_es,
    nombre_en,
    slug,
    categoriaSlug,
    subcategoriaSlug,
    lang,
    descripcion_corta,
    descripcion_corta_en,
    direccion,
    imagen_principal,
} = Astro.props;

const localizedName = getLocalizedName(
    {
        nombre,
        nombre_es,
        nombre_en,
    },
    lang,
);

const descripcion =
    lang === "en"
        ? descripcion_corta_en || descripcion_corta
        : descripcion_corta;

const imageUrl = imagen_principal?.[0]?.url
    ? `http://localhost:1337${imagen_principal[0].url}`
    : null;

const detalleUrl =
    lang === "es"
        ? subcategoriaSlug
            ? `/es/${categoriaSlug}/${subcategoriaSlug}/${slug}`
            : `/es/${categoriaSlug}/${slug}`
        : lang === "en"
          ? subcategoriaSlug
              ? `/en/${categoriaSlug}/${subcategoriaSlug}/${slug}`
              : `/en/${categoriaSlug}/${slug}`
          : subcategoriaSlug
            ? `/${categoriaSlug}/${subcategoriaSlug}/${slug}`
            : `/${categoriaSlug}/${slug}`;

const t = getTranslations(lang);
---

<li style="margin-bottom: 30px; border: 1px solid #ccc; padding: 16px;">
    {
        imageUrl && (
            <img
                src={imageUrl}
                alt={localizedName}
                style="max-width:200px; display:block; margin-bottom:10px;"
            />
        )
    }

    <h2>{localizedName}</h2>

    {direccion && <p>{direccion}</p>}

    <p>{descripcion ?? t.common.noDescription}</p>

    <a href={detalleUrl}>{t.common.viewMore}</a>
</li>
