---
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";

interface Props {
    nombre?: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    categoriaSlug: string;
    subcategoriaSlug?: string;
    lang: "ca" | "es" | "en";
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
}

const {
    nombre,
    nombre_es,
    nombre_en,
    slug,
    categoriaSlug,
    subcategoriaSlug,
    lang,
    descripcion_corta,
    descripcion_corta_en,
    direccion,
    imagen_principal,
} = Astro.props;

const localizedName = getLocalizedName(
    {
        nombre,
        nombre_es,
        nombre_en,
    },
    lang,
);

const descripcion =
    lang === "en"
        ? descripcion_corta_en || descripcion_corta
        : descripcion_corta;

const imageUrl = imagen_principal?.[0]?.url
    ? getStrapiMediaUrl(imagen_principal[0].url)
    : null;

const detalleUrl =
    lang === "es"
        ? subcategoriaSlug
            ? `/es/${categoriaSlug}/${subcategoriaSlug}/${slug}`
            : `/es/${categoriaSlug}/${slug}`
        : lang === "en"
          ? subcategoriaSlug
              ? `/en/${categoriaSlug}/${subcategoriaSlug}/${slug}`
              : `/en/${categoriaSlug}/${slug}`
          : subcategoriaSlug
            ? `/${categoriaSlug}/${subcategoriaSlug}/${slug}`
            : `/${categoriaSlug}/${slug}`;

const t = getTranslations(lang);
---

<li class="h-full">
    <a
        href={detalleUrl}
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm outline-none transition-[border-color,box-shadow] duration-200 hover:border-cyan-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
    >
        <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={localizedName}
                        width="720"
                        height="540"
                        loading="lazy"
                        class="size-full object-cover"
                    />
                ) : (
                    <div
                        class="flex size-full flex-col items-center justify-center gap-3 p-6 text-center text-slate-500"
                    >
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-10 text-slate-400"
                        >
                            <path d="M3 9h18" />
                            <path d="M5 9v11h14V9" />
                            <path d="m4 9 2-5h12l2 5" />
                            <path d="M9 20v-6h6v6" />
                        </svg>

                        <span class="text-xs font-semibold uppercase tracking-wider">
                            {t.comercios.noImage}
                        </span>
                    </div>
                )
            }
        </div>

        <div class="flex flex-1 flex-col p-5">
            <h3
                class="text-xl font-black leading-tight tracking-tight text-slate-950"
            >
                {localizedName}
            </h3>

            {
                direccion && (
                    <p class="mt-3 flex items-start gap-2 text-sm leading-6 text-slate-600">
                        <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-0.5 size-4 shrink-0 text-cyan-700"
                        >
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2" />
                        </svg>

                        <span>{direccion}</span>
                    </p>
                )
            }

            <p class="mt-4 text-sm leading-6 text-slate-600">
                {descripcion || t.common.noDescription}
            </p>

            <span
                class="mt-auto inline-flex min-h-11 items-end gap-2 pt-5 text-sm font-bold text-cyan-700"
            >
                {t.common.viewMore}

                <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mb-0.5 size-4 transition-transform duration-200 motion-safe:group-hover:translate-x-1"
                >
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                </svg>
            </span>
        </div>
    </a>
</li>
