---
import brandMark from "../assets/images/marca.svg?url";
import logoDark from "../assets/images/guiapinedaInv.svg?url";

interface Props {
    href: string;
    tone?: "light" | "dark";
}

const { href, tone = "light" } = Astro.props;

const logoSrc = tone === "dark" ? logoDark : brandMark;

const logoClass =
    tone === "dark"
        ? "block h-8 w-auto sm:h-9"
        : "block h-8 w-auto lg:h-9";

const focusClass =
    tone === "dark"
        ? "focus-visible:outline-orange-400"
        : "focus-visible:outline-cyan-600";
---

<a
    href={href}
    aria-label="GUIAPINEDA"
    class:list={[
        "inline-flex min-h-11 items-center rounded-md outline-none focus-visible:outline-2 focus-visible:outline-offset-4",
        focusClass,
    ]}
>
    <img
        src={logoSrc}
        alt=""
        decoding="async"
        class={logoClass}
    />
</a>
