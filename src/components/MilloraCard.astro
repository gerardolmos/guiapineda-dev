---
import { formatDate } from "../lib/formatDate";
import { getReadingTime } from "../lib/readingTime";
import { getStrapiMediaUrl } from "../lib/strapi";

const {
    item,
    href,
    lang = "ca",
    readingSuffix = "",
    category = "",
    zone = "",
} = Astro.props as {
    item: any;
    href: string;
    lang?: "ca" | "es" | "en";
    readingSuffix?: string;
    category?: string;
    zone?: string;
};

const hasImage = Boolean(item.imatge?.url);

const categoryStyles: Record<string, string> = {
    incidencies: "border-amber-200 bg-amber-50 text-amber-800",
    civisme: "border-emerald-200 bg-emerald-50 text-emerald-800",
    propostes: "border-violet-200 bg-violet-50 text-violet-800",
};

const fallbackStyles: Record<string, string> = {
    incidencies: "from-amber-100 via-white to-stone-100",
    civisme: "from-emerald-100 via-white to-stone-100",
    propostes: "from-violet-100 via-white to-stone-100",
};

const categoryStyle =
    categoryStyles[item.categoria] ??
    "border-slate-200 bg-slate-50 text-slate-700";

const fallbackStyle =
    fallbackStyles[item.categoria] ??
    "from-slate-100 via-white to-stone-100";
---

<article
    class="group h-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:border-sky-200 hover:shadow-md"
>
    <a
        href={href}
        class="block h-full focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-300 sm:grid sm:grid-cols-[11rem_minmax(0,1fr)]"
    >
        {
            hasImage ? (
                <div class="aspect-[16/8] overflow-hidden bg-slate-100 sm:aspect-auto sm:min-h-[14rem]">
                    <img
                        src={getStrapiMediaUrl(item.imatge.url)}
                        alt=""
                        width="550"
                        height="440"
                        loading="lazy"
                        class="size-full object-cover transition duration-300 group-hover:scale-[1.025]"
                    />
                </div>
            ) : (
                <div
                    class={`flex aspect-[16/8] items-end bg-gradient-to-br ${fallbackStyle} p-5 sm:aspect-auto sm:min-h-[14rem]`}
                    aria-hidden="true"
                >
                    <span class="text-[0.65rem] font-black uppercase tracking-[0.18em] text-slate-600">
                        GUIAPINEDA
                    </span>
                </div>
            )
        }

        <div class="flex min-w-0 flex-col p-5">
            <div class="flex flex-wrap gap-2">
                <span
                    class={`rounded-full border px-2.5 py-1 text-[0.68rem] font-black uppercase tracking-[0.08em] ${categoryStyle}`}
                >
                    {category}
                </span>

                <span
                    class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[0.68rem] font-black uppercase tracking-[0.08em] text-slate-600"
                >
                    {zone}
                </span>
            </div>

            <h2
                class="mt-3 line-clamp-2 text-xl font-black leading-tight tracking-tight text-slate-950 transition group-hover:text-sky-800"
            >
                {item.titol}
            </h2>

            {
                item.resum && (
                    <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600">
                        {item.resum}
                    </p>
                )
            }

            <div class="mt-auto pt-5">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold text-slate-500">
                    <span class="text-sky-700">{item.autor}</span>

                    <span aria-hidden="true">·</span>

                    <span>{formatDate(item.data_publicacio, lang)}</span>

                    <span aria-hidden="true">·</span>

                    <span>
                        {getReadingTime(item.contingut)} {readingSuffix}
                    </span>
                </div>

                <div class="mt-4 flex justify-end">
                    <span
                        aria-hidden="true"
                        class="flex size-8 items-center justify-center rounded-full bg-sky-950 text-sm font-bold text-white transition group-hover:bg-sky-700"
                    >
                        →
                    </span>
                </div>
            </div>
        </div>
    </a>
</article>
