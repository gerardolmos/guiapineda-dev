---
import Layout from "../layouts/Layout.astro";
import StrapiBlocks from "../components/StrapiBlocks.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";
import {
    getEmailHref,
    getTelephoneHref,
    getWebsiteHref,
} from "../lib/contactLinks";
import type { StrapiBlock } from "../lib/strapiBlocks";
import {
    getPrimaryMediaUrl,
    type PrimaryMedia,
} from "../lib/primaryMedia";

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activo?: boolean;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    descripcion_completa?: StrapiBlock[] | null;
    descripcion_completa_en?: StrapiBlock[] | null;
    direccion?: string | null;
    telefono?: string | null;
    email?: string | null;
    web?: string | null;
    horario?: StrapiBlock[] | null;
    categoria?: {
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
        slug: string;
    };
    subcategoria?: {
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
        slug: string;
    } | null;
    imagen_principal?: PrimaryMedia;
};

const { slug, lang } = Astro.props;

const t = getTranslations(lang);

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data;

const comercio = todos.find(
    (item) => item.slug === slug && item.activo === true,
);

if (!comercio) {
    throw new Error(
        `No se encontró el comercio necesario para generar el slug: ${slug}`,
    );
}

const descripcionCorta =
    lang === "en"
        ? comercio.descripcion_corta_en ||
          comercio.descripcion_corta
        : comercio.descripcion_corta;

const descripcionCompleta =
    lang === "en"
        ? comercio.descripcion_completa_en ||
          comercio.descripcion_completa
        : comercio.descripcion_completa;

const telephoneHref = getTelephoneHref(comercio.telefono);
const emailHref = getEmailHref(comercio.email);
const websiteHref = getWebsiteHref(comercio.web);

const imagePath = getPrimaryMediaUrl(comercio.imagen_principal);
const imageUrl = imagePath ? getStrapiMediaUrl(imagePath) : null;

const comercioNombre = getLocalizedName(comercio, lang);

const categoriaNombre = comercio.categoria
    ? getLocalizedName(comercio.categoria, lang)
    : "";

const subcategoriaNombre = comercio.subcategoria
    ? getLocalizedName(comercio.subcategoria, lang)
    : "";

const homeUrl =
    lang === "es" ? "/es" : lang === "en" ? "/en" : "/";

const categoriaUrl =
    lang === "es"
        ? `/es/${comercio.categoria?.slug}`
        : lang === "en"
          ? `/en/${comercio.categoria?.slug}`
          : `/${comercio.categoria?.slug}`;

const subcategoriaUrl =
    comercio.subcategoria && comercio.categoria
        ? lang === "es"
            ? `/es/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
            : lang === "en"
              ? `/en/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
              : `/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
        : "";

const description =
    lang === "es"
        ? `Descubre ${comercioNombre} en Pineda de Mar: dirección, contacto y más información.`
        : lang === "en"
          ? `Discover ${comercioNombre} in Pineda de Mar: address, contact and more information.`
          : `Descobreix ${comercioNombre} a Pineda de Mar: adreça, contacte i més informació.`;
---

<Layout
    title={`${comercioNombre} | GUIAPINEDA`}
    description={description}
    lang={lang}
>
    <nav>
        <a href={homeUrl}>{t.common.home}</a>
        {" > "}

        {
            comercio.categoria && (
                <a href={categoriaUrl}>{categoriaNombre}</a>
            )
        }

        {
            comercio.subcategoria && (
                <>
                    {" > "}
                    <a href={subcategoriaUrl}>
                        {subcategoriaNombre}
                    </a>
                </>
            )
        }

        {" > "}
        <span>{comercioNombre}</span>
    </nav>

    <h1>{comercioNombre}</h1>

    {imageUrl && <img src={imageUrl} alt={comercioNombre} />}

    {descripcionCorta && <p>{descripcionCorta}</p>}

    {
        Array.isArray(descripcionCompleta) &&
            descripcionCompleta.length > 0 && (
                <StrapiBlocks blocks={descripcionCompleta} />
            )
    }

    {comercio.direccion && <p>{comercio.direccion}</p>}

    {
        comercio.telefono && (
            <p>
                {
                    telephoneHref ? (
                        <a href={telephoneHref}>
                            {comercio.telefono}
                        </a>
                    ) : (
                        comercio.telefono
                    )
                }
            </p>
        )
    }

    {
        comercio.email && (
            <p>
                {
                    emailHref ? (
                        <a href={emailHref}>{comercio.email}</a>
                    ) : (
                        comercio.email
                    )
                }
            </p>
        )
    }

    {
        comercio.web && (
            <p>
                {
                    websiteHref ? (
                        <a href={websiteHref}>{comercio.web}</a>
                    ) : (
                        comercio.web
                    )
                }
            </p>
        )
    }

    {
        Array.isArray(comercio.horario) &&
            comercio.horario.length > 0 && (
                <StrapiBlocks blocks={comercio.horario} />
            )
    }
</Layout>
