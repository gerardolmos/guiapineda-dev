---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";

type RichTextChild = {
    text?: string;
};

type RichTextBlock = {
    children?: RichTextChild[];
};

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activo?: boolean;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    descripcion_completa?: RichTextBlock[] | null;
    descripcion_completa_en?: RichTextBlock[] | null;
    direccion?: string | null;
    telefono?: string | null;
    email?: string | null;
    web?: string | null;
    horario?: RichTextBlock[] | null;
    categoria?: {
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
        slug: string;
    };
    subcategoria?: {
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
        slug: string;
    } | null;
    imagen_principal?: {
        url: string;
    }[];
};

const { slug, lang } = Astro.props;

const t = getTranslations(lang);

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data;

const comercio = todos.find((c) => c.slug === slug && c.activo === true);

if (!comercio) {
    return Astro.redirect("/404");
}

function richTextToPlainText(blocks?: RichTextBlock[] | null) {
    if (!blocks || !Array.isArray(blocks)) return "";

    return blocks
        .map((block) =>
            (block.children || []).map((child) => child.text || "").join(""),
        )
        .filter(Boolean)
        .join("\n");
}

const descripcionCorta =
    lang === "en"
        ? comercio.descripcion_corta_en || comercio.descripcion_corta
        : comercio.descripcion_corta;

const descripcionCompleta =
    lang === "en"
        ? richTextToPlainText(
              comercio.descripcion_completa_en || comercio.descripcion_completa,
          )
        : richTextToPlainText(comercio.descripcion_completa);

const horarioTexto = richTextToPlainText(comercio.horario);

const imageUrl = comercio.imagen_principal?.[0]?.url
    ? getStrapiMediaUrl(comercio.imagen_principal[0].url)
    : null;

const comercioNombre = getLocalizedName(comercio, lang);

const categoriaNombre = comercio.categoria
    ? getLocalizedName(comercio.categoria, lang)
    : "";

const subcategoriaNombre = comercio.subcategoria
    ? getLocalizedName(comercio.subcategoria, lang)
    : "";

const homeUrl = lang === "es" ? "/es" : lang === "en" ? "/en" : "/";

const categoriaUrl =
    lang === "es"
        ? `/es/${comercio.categoria?.slug}`
        : lang === "en"
          ? `/en/${comercio.categoria?.slug}`
          : `/${comercio.categoria?.slug}`;

const subcategoriaUrl =
    comercio.subcategoria && comercio.categoria
        ? lang === "es"
            ? `/es/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
            : lang === "en"
              ? `/en/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
              : `/${comercio.categoria.slug}/${comercio.subcategoria.slug}`
        : "";

const description =
    lang === "es"
        ? `Descubre ${comercioNombre} en Pineda de Mar: dirección, contacto y más información.`
        : lang === "en"
          ? `Discover ${comercioNombre} in Pineda de Mar: address, contact and more information.`
          : `Descobreix ${comercioNombre} a Pineda de Mar: adreça, contacte i més informació.`;
---

<Layout
    title={`${comercioNombre} | GUIAPINEDA`}
    description={description}
    lang={lang}
>
    <nav>
        <a href={homeUrl}>{t.common.home}</a>
        {" > "}

        {comercio.categoria && <a href={categoriaUrl}>{categoriaNombre}</a>}

        {
            comercio.subcategoria && (
                <>
                    {" > "}
                    <a href={subcategoriaUrl}>{subcategoriaNombre}</a>
                </>
            )
        }

        {" > "}
        <span>{comercioNombre}</span>
    </nav>
    <h1>{comercioNombre}</h1>

    {imageUrl && <img src={imageUrl} alt={comercioNombre} />}

    {descripcionCorta && <p>{descripcionCorta}</p>}

    {
        descripcionCompleta && (
            <div>
                {descripcionCompleta.split("\n").map((linea) => (
                    <p>{linea}</p>
                ))}
            </div>
        )
    }

    {comercio.direccion && <p>{comercio.direccion}</p>}
    {comercio.telefono && <p>{comercio.telefono}</p>}
    {comercio.email && <p>{comercio.email}</p>}
    {comercio.web && <p>{comercio.web}</p>}

    {
        horarioTexto && (
            <div>
                {horarioTexto.split("\n").map((linea) => (
                    <p>{linea}</p>
                ))}
            </div>
        )
    }
</Layout>
