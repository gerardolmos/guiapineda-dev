---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getTranslations } from "../i18n/getTranslations";
import ComercioCard from "../components/ComercioCard.astro";
import { getLocalizedName } from "../lib/getLocalizedName";

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    activo?: boolean;
    fecha_publicacion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
    subcategoria?: {
        slug: string;
    };
};

type Subcategoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    categoria?: {
        slug: string;
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
    };
};

const { slug, lang } = Astro.props;

const t = getTranslations(lang);

const sortOrder = Astro.url.searchParams.get("orden") || "recientes";
const currentPage = Number(Astro.url.searchParams.get("page") || "1");
const itemsPerPage = 10;

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data;

const subData = await fetchAPI(endpoints.subcategorias);
const todasLasSubcategorias: Subcategoria[] = subData.data;

const subcategoriaActual = todasLasSubcategorias.find(
    (sub) => sub.slug === slug,
);

const subcategoryName = subcategoriaActual
    ? getLocalizedName(subcategoriaActual, lang)
    : "";

const basePath =
    lang === "es"
        ? `/es/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`
        : lang === "en"
          ? `/en/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`
          : `/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`;

const comercios = todos
    .filter((c) => c.subcategoria?.slug === slug && c.activo === true)
    .sort((a, b) => {
        if (sortOrder === "az") {
            return getLocalizedName(a, lang).localeCompare(
                getLocalizedName(b, lang),
            );
        }

        if (sortOrder === "za") {
            return getLocalizedName(b, lang).localeCompare(
                getLocalizedName(a, lang),
            );
        }

        return (
            new Date(b.fecha_publicacion || "").getTime() -
            new Date(a.fecha_publicacion || "").getTime()
        );
    });

const totalPages = Math.max(1, Math.ceil(comercios.length / itemsPerPage));
const safeCurrentPage = Math.min(Math.max(currentPage, 1), totalPages);

const startIndex = (safeCurrentPage - 1) * itemsPerPage;
const paginatedComercios = comercios.slice(
    startIndex,
    startIndex + itemsPerPage,
);

function buildUrl(params: { orden?: string; page?: number }) {
    const searchParams = new URLSearchParams();

    const orden = params.orden ?? sortOrder;
    const page = params.page ?? safeCurrentPage;

    if (orden !== "recientes") {
        searchParams.set("orden", orden);
    }

    if (page > 1) {
        searchParams.set("page", String(page));
    }

    const query = searchParams.toString();

    return query ? `${basePath}?${query}` : basePath;
}

const description =
    lang === "es"
        ? `Encuentra ${subcategoryName} en Pineda de Mar dentro de la guía GUIAPINEDA.`
        : lang === "en"
          ? `Find ${subcategoryName} in Pineda de Mar in the GUIAPINEDA guide.`
          : `Troba ${subcategoryName} a Pineda de Mar dins de la guia GUIAPINEDA.`;
---

<Layout
    title={subcategoriaActual
        ? `${getLocalizedName(subcategoriaActual, lang)} en Pineda de Mar | GUIAPINEDA`
        : t.pages.subcategoryTitle}
    description={description}
    lang={lang}
>
    <nav>
        <a href={lang === "es" ? "/es" : lang === "en" ? "/en" : "/"}>
            {t.common.home}
        </a>
        {" > "}
        <a
            href={lang === "es"
                ? `/es/${subcategoriaActual?.categoria?.slug}`
                : lang === "en"
                  ? `/en/${subcategoriaActual?.categoria?.slug}`
                  : `/${subcategoriaActual?.categoria?.slug}`}
        >
            {
                subcategoriaActual?.categoria
                    ? getLocalizedName(subcategoriaActual.categoria, lang)
                    : ""
            }
        </a>
        {" > "}
        <span>
            {
                subcategoriaActual
                    ? getLocalizedName(subcategoriaActual, lang)
                    : ""
            }
        </span>
    </nav>

    <h1>
        {
            subcategoriaActual
                ? getLocalizedName(subcategoriaActual, lang)
                : t.pages.subcategoryTitle
        }
    </h1>

    {
        comercios.length > 0 && (
            <form method="get" action={basePath}>
                <label>
                    {t.comercios.sortLabel}
                    <select name="orden">
                        <option
                            value="recientes"
                            selected={sortOrder === "recientes"}
                        >
                            {t.comercios.sortNewest}
                        </option>
                        <option value="az" selected={sortOrder === "az"}>
                            {t.comercios.sortAZ}
                        </option>
                        <option value="za" selected={sortOrder === "za"}>
                            {t.comercios.sortZA}
                        </option>
                    </select>
                </label>

                <button type="submit">{t.comercios.applySort}</button>
            </form>
        )
    }

    {
        comercios.length > 0 ? (
            <>
                <ul>
                    {paginatedComercios.map((c: Comercio) => (
                        <ComercioCard
                            nombre={c.nombre}
                            nombre_es={c.nombre_es}
                            nombre_en={c.nombre_en}
                            slug={c.slug}
                            categoriaSlug={
                                subcategoriaActual?.categoria?.slug ?? ""
                            }
                            subcategoriaSlug={subcategoriaActual?.slug ?? ""}
                            lang={lang}
                            descripcion_corta={c.descripcion_corta}
                            descripcion_corta_en={c.descripcion_corta_en}
                            direccion={c.direccion}
                            imagen_principal={c.imagen_principal}
                        />
                    ))}
                </ul>

                {totalPages > 1 && (
                    <nav aria-label={t.comercios.paginationLabel}>
                        {safeCurrentPage > 1 && (
                            <a href={buildUrl({ page: safeCurrentPage - 1 })}>
                                {t.comercios.previousPage}
                            </a>
                        )}

                        <span>
                            {t.comercios.pageLabel} {safeCurrentPage} /{" "}
                            {totalPages}
                        </span>

                        {safeCurrentPage < totalPages && (
                            <a href={buildUrl({ page: safeCurrentPage + 1 })}>
                                {t.comercios.nextPage}
                            </a>
                        )}
                    </nav>
                )}
            </>
        ) : (
            <section>
                <h2>{t.comercios.emptyTitle}</h2>

                <p>{t.comercios.emptyText}</p>

                <p>
                    {t.comercios.contactText}
                    <a href="mailto:info@guiapineda.com">info@guiapineda.com</a>
                </p>
            </section>
        )
    }
</Layout>
