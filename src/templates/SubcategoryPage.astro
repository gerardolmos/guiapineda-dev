---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getTranslations } from "../i18n/getTranslations";
import ComercioCard from "../components/ComercioCard.astro";
import { getLocalizedName } from "../lib/getLocalizedName";

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    activo?: boolean;
    fecha_publicacion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
    subcategoria?: {
        slug: string;
    };
};

type Subcategoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    categoria?: {
        slug: string;
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
    };
};

const { slug, lang } = Astro.props;

const t = getTranslations(lang);
const itemsPerPage = 24;

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data;

const subData = await fetchAPI(endpoints.subcategorias);
const todasLasSubcategorias: Subcategoria[] = subData.data;

const subcategoriaActual = todasLasSubcategorias.find(
    (sub) => sub.slug === slug,
);

const subcategoryName = subcategoriaActual
    ? getLocalizedName(subcategoriaActual, lang)
    : "";

const basePath =
    lang === "es"
        ? `/es/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`
        : lang === "en"
          ? `/en/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`
          : `/${subcategoriaActual?.categoria?.slug}/${subcategoriaActual?.slug}`;

const comercios = todos.filter(
    (comercio) =>
        comercio.subcategoria?.slug === slug &&
        comercio.activo === true,
);

const comerciosMeta = comercios.map((comercio) => ({
    nombre: getLocalizedName(comercio, lang),
    fecha: comercio.fecha_publicacion || "",
}));

const description =
    lang === "es"
        ? `Encuentra ${subcategoryName} en Pineda de Mar dentro de la guía GUIAPINEDA.`
        : lang === "en"
          ? `Find ${subcategoryName} in Pineda de Mar in the GUIAPINEDA guide.`
          : `Troba ${subcategoryName} a Pineda de Mar dins de la guia GUIAPINEDA.`;
---

<Layout
    title={subcategoriaActual
        ? `${getLocalizedName(subcategoriaActual, lang)} en Pineda de Mar | GUIAPINEDA`
        : t.pages.subcategoryTitle}
    description={description}
    lang={lang}
>
    <nav>
        <a href={lang === "es" ? "/es" : lang === "en" ? "/en" : "/"}>
            {t.common.home}
        </a>
        {" > "}
        <a
            href={lang === "es"
                ? `/es/${subcategoriaActual?.categoria?.slug}`
                : lang === "en"
                  ? `/en/${subcategoriaActual?.categoria?.slug}`
                  : `/${subcategoriaActual?.categoria?.slug}`}
        >
            {
                subcategoriaActual?.categoria
                    ? getLocalizedName(subcategoriaActual.categoria, lang)
                    : ""
            }
        </a>
        {" > "}
        <span>
            {
                subcategoriaActual
                    ? getLocalizedName(subcategoriaActual, lang)
                    : ""
            }
        </span>
    </nav>

    <h1>
        {
            subcategoriaActual
                ? getLocalizedName(subcategoriaActual, lang)
                : t.pages.subcategoryTitle
        }
    </h1>

    {
        comercios.length > 0 && (
            <form
                id="comercios-controls"
                method="get"
                action={basePath}
            >
                <label>
                    {t.comercios.sortLabel}
                    <select name="orden" id="comercios-order">
                        <option value="recientes">
                            {t.comercios.sortNewest}
                        </option>
                        <option value="az">
                            {t.comercios.sortAZ}
                        </option>
                        <option value="za">
                            {t.comercios.sortZA}
                        </option>
                    </select>
                </label>

                <button type="submit">
                    {t.comercios.applySort}
                </button>
            </form>
        )
    }

    {
        comercios.length > 0 ? (
            <>
                <ul id="comercios-list">
                    {comercios.map((comercio: Comercio) => (
                        <ComercioCard
                            nombre={comercio.nombre}
                            nombre_es={comercio.nombre_es}
                            nombre_en={comercio.nombre_en}
                            slug={comercio.slug}
                            categoriaSlug={
                                subcategoriaActual?.categoria?.slug ?? ""
                            }
                            subcategoriaSlug={
                                subcategoriaActual?.slug ?? ""
                            }
                            lang={lang}
                            descripcion_corta={
                                comercio.descripcion_corta
                            }
                            descripcion_corta_en={
                                comercio.descripcion_corta_en
                            }
                            direccion={comercio.direccion}
                            imagen_principal={
                                comercio.imagen_principal
                            }
                        />
                    ))}
                </ul>

                <nav
                    id="comercios-pagination"
                    aria-label={t.comercios.paginationLabel}
                    hidden
                >
                    <button type="button" id="comercios-prev">
                        {t.comercios.previousPage}
                    </button>

                    <span
                        id="comercios-page-info"
                        aria-live="polite"
                    ></span>

                    <button type="button" id="comercios-next">
                        {t.comercios.nextPage}
                    </button>
                </nav>

                <script
                    define:vars={{
                        itemsPerPage,
                        basePath,
                        lang,
                        comerciosMeta,
                        pageLabel: t.comercios.pageLabel,
                    }}
                >
                    const form =
                        document.getElementById("comercios-controls");

                    const orderSelect =
                        document.getElementById("comercios-order");

                    const list =
                        document.getElementById("comercios-list");

                    const pagination =
                        document.getElementById("comercios-pagination");

                    const prevButton =
                        document.getElementById("comercios-prev");

                    const nextButton =
                        document.getElementById("comercios-next");

                    const pageInfo =
                        document.getElementById("comercios-page-info");

                    if (
                        form &&
                        orderSelect &&
                        list &&
                        pagination &&
                        prevButton &&
                        nextButton &&
                        pageInfo
                    ) {
                        const elements = Array.from(
                            list.querySelectorAll(":scope > li"),
                        );

                        const metadata = Array.isArray(comerciosMeta)
                            ? comerciosMeta
                            : [];

                        const rows = elements.map((element, index) => ({
                            element,
                            nombre: metadata[index]?.nombre || "",
                            fecha: metadata[index]?.fecha || "",
                        }));

                        const validOrders = new Set([
                            "recientes",
                            "az",
                            "za",
                        ]);

                        const params = new URLSearchParams(
                            window.location.search,
                        );

                        const requestedOrder = params.get("orden");

                        let sortOrder = validOrders.has(requestedOrder)
                            ? requestedOrder
                            : "recientes";

                        const requestedPage = Number.parseInt(
                            params.get("page") || "1",
                            10,
                        );

                        let currentPage =
                            Number.isFinite(requestedPage) &&
                            requestedPage > 0
                                ? requestedPage
                                : 1;

                        orderSelect.value = sortOrder;

                        function compareNames(a, b, direction = 1) {
                            return (
                                direction *
                                a.nombre.localeCompare(
                                    b.nombre,
                                    lang,
                                    { sensitivity: "base" },
                                )
                            );
                        }

                        function getSortedRows() {
                            return [...rows].sort((a, b) => {
                                if (sortOrder === "az") {
                                    return compareNames(a, b);
                                }

                                if (sortOrder === "za") {
                                    return compareNames(a, b, -1);
                                }

                                const aTime =
                                    Date.parse(a.fecha) || 0;

                                const bTime =
                                    Date.parse(b.fecha) || 0;

                                return (
                                    bTime -
                                        aTime ||
                                    compareNames(a, b)
                                );
                            });
                        }

                        function updateUrl() {
                            const newParams =
                                new URLSearchParams();

                            if (sortOrder !== "recientes") {
                                newParams.set(
                                    "orden",
                                    sortOrder,
                                );
                            }

                            if (currentPage > 1) {
                                newParams.set(
                                    "page",
                                    String(currentPage),
                                );
                            }

                            const query = newParams.toString();

                            const newUrl = query
                                ? `${basePath}?${query}`
                                : basePath;

                            window.history.replaceState(
                                {},
                                "",
                                newUrl,
                            );
                        }

                        function render() {
                            const sortedRows = getSortedRows();

                            sortedRows.forEach((row) => {
                                list.appendChild(row.element);
                                row.element.hidden = true;
                            });

                            const totalPages = Math.max(
                                1,
                                Math.ceil(
                                    sortedRows.length /
                                        itemsPerPage,
                                ),
                            );

                            currentPage = Math.min(
                                Math.max(currentPage, 1),
                                totalPages,
                            );

                            const start =
                                (currentPage - 1) *
                                itemsPerPage;

                            sortedRows
                                .slice(
                                    start,
                                    start + itemsPerPage,
                                )
                                .forEach((row) => {
                                    row.element.hidden = false;
                                });

                            pagination.hidden =
                                sortedRows.length <=
                                itemsPerPage;

                            prevButton.disabled =
                                currentPage <= 1;

                            nextButton.disabled =
                                currentPage >= totalPages;

                            pageInfo.textContent =
                                `${pageLabel} ` +
                                `${currentPage} / ${totalPages}`;

                            updateUrl();
                        }

                        form.addEventListener(
                            "submit",
                            (event) => {
                                event.preventDefault();

                                sortOrder = validOrders.has(
                                    orderSelect.value,
                                )
                                    ? orderSelect.value
                                    : "recientes";

                                currentPage = 1;
                                render();
                            },
                        );

                        prevButton.addEventListener(
                            "click",
                            () => {
                                currentPage -= 1;
                                render();
                            },
                        );

                        nextButton.addEventListener(
                            "click",
                            () => {
                                currentPage += 1;
                                render();
                            },
                        );

                        render();
                    }
                </script>
            </>
        ) : (
            <section>
                <h2>{t.comercios.emptyTitle}</h2>

                <p>{t.comercios.emptyText}</p>

                <p>
                    {t.comercios.contactText}
                    <a href="mailto:info@guiapineda.com">
                        info@guiapineda.com
                    </a>
                </p>
            </section>
        )
    }
</Layout>
