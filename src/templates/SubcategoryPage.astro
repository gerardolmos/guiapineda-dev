---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ComercioCard from "../components/ComercioCard.astro";
import { getTranslations } from "../i18n/getTranslations";
import Layout from "../layouts/Layout.astro";
import { endpoints, fetchAPI } from "../lib/api";
import { getLocalizedName } from "../lib/getLocalizedName";

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    activo?: boolean;
    fecha_publicacion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
    categoria?: {
        slug: string;
    };
    subcategoria?: {
        slug: string;
    };
};

type Subcategoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activa?: boolean;
    categoria?: {
        slug: string;
        activa?: boolean;
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
    };
};

const { slug, categoriaSlug, lang = "ca" } = Astro.props;

const t = getTranslations(lang);
const itemsPerPage = 24;

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data || [];

const subData = await fetchAPI(endpoints.subcategorias);
const todasLasSubcategorias: Subcategoria[] = subData.data || [];

const subcategoriaActual = todasLasSubcategorias.find(
    (subcategoria) =>
        subcategoria.activa === true &&
        subcategoria.slug === slug &&
        subcategoria.categoria?.activa === true &&
        subcategoria.categoria?.slug === categoriaSlug,
);

if (!subcategoriaActual) {
    throw new Error(
        `No se encontró la subcategoría activa "${slug}" dentro de la categoría "${categoriaSlug}".`,
    );
}

const subcategoryName = getLocalizedName(subcategoriaActual, lang);
const categoryName = subcategoriaActual.categoria
    ? getLocalizedName(subcategoriaActual.categoria, lang)
    : "";

const languagePrefix =
    lang === "es" ? "/es" : lang === "en" ? "/en" : "";

const homeUrl = languagePrefix || "/";
const categoryPath = `${languagePrefix}/${categoriaSlug}`;
const basePath = `${categoryPath}/${slug}`;

const comercios = todos.filter(
    (comercio) =>
        comercio.activo === true &&
        comercio.categoria?.slug === categoriaSlug &&
        comercio.subcategoria?.slug === slug,
);

const comerciosMeta = comercios.map((comercio) => ({
    nombre: getLocalizedName(comercio, lang),
    fecha: comercio.fecha_publicacion || "",
}));

const description =
    lang === "es"
        ? `Encuentra ${subcategoryName} en Pineda de Mar dentro de la guía GUIAPINEDA.`
        : lang === "en"
          ? `Find ${subcategoryName} in Pineda de Mar in the GUIAPINEDA guide.`
          : `Troba ${subcategoryName} a Pineda de Mar dins de la guia GUIAPINEDA.`;

const subcategoryIntro = t.pages.subcategoryIntro
    .replace("{subcategory}", subcategoryName)
    .replace("{category}", categoryName);

const resultCount =
    comercios.length === 1
        ? t.comercios.resultSingular.replace(
              "{count}",
              String(comercios.length),
          )
        : t.comercios.resultPlural.replace(
              "{count}",
              String(comercios.length),
          );
---

<Layout
    title={`${subcategoryName} en Pineda de Mar | GUIAPINEDA`}
    description={description}
    lang={lang}
>
    <header class="border-b border-stone-200 bg-stone-100">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
            <Breadcrumbs
                label={t.common.breadcrumbLabel}
                back={{
                    label: t.pages.backToCategory.replace(
                        "{category}",
                        categoryName,
                    ),
                    href: categoryPath,
                }}
                items={[
                    {
                        label: t.common.home,
                        href: homeUrl,
                    },
                    {
                        label: categoryName,
                        href: categoryPath,
                    },
                    {
                        label: subcategoryName,
                    },
                ]}
            />

            <div class="mt-7 max-w-3xl">
                <h1
                    class="text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl"
                >
                    {subcategoryName}
                </h1>

                <p class="mt-4 text-lg leading-8 text-slate-600">
                    {subcategoryIntro}
                </p>
            </div>
        </div>
    </header>

    <div
        class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8"
    >
        {
            comercios.length > 0 ? (
                <section aria-labelledby="comercios-results-title">
                    <div class="flex flex-col gap-6 border-b border-slate-200 pb-7 sm:flex-row sm:items-end sm:justify-between">
                        <div>
                            <h2
                                id="comercios-results-title"
                                tabindex="-1"
                                class="scroll-mt-28 text-3xl font-black tracking-tight text-slate-950 outline-none"
                            >
                                {t.comercios.resultsHeading}
                            </h2>

                            <p class="mt-2 text-sm font-medium text-slate-600">
                                {resultCount}
                            </p>
                        </div>

                        <form
                            id="comercios-controls"
                            method="get"
                            action={basePath}
                            class="flex flex-col gap-3 sm:flex-row sm:items-end"
                        >
                            <label
                                for="comercios-order"
                                class="text-sm font-semibold text-slate-700"
                            >
                                <span class="mb-2 block">
                                    {t.comercios.sortLabel}
                                </span>

                                <select
                                    name="orden"
                                    id="comercios-order"
                                    class="min-h-12 min-w-52 rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-900 outline-none focus-visible:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600"
                                >
                                    <option value="recientes">
                                        {t.comercios.sortNewest}
                                    </option>
                                    <option value="az">
                                        {t.comercios.sortAZ}
                                    </option>
                                    <option value="za">
                                        {t.comercios.sortZA}
                                    </option>
                                </select>
                            </label>

                            <button
                                type="submit"
                                class="inline-flex min-h-12 items-center justify-center rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white outline-none transition-colors duration-200 hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-500"
                            >
                                {t.comercios.applySort}
                            </button>
                        </form>
                    </div>

                    <ul
                        id="comercios-list"
                        class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3"
                    >
                        {comercios.map((comercio: Comercio) => (
                            <ComercioCard
                                nombre={comercio.nombre}
                                nombre_es={comercio.nombre_es}
                                nombre_en={comercio.nombre_en}
                                slug={comercio.slug}
                                categoriaSlug={categoriaSlug}
                                subcategoriaSlug={slug}
                                lang={lang}
                                descripcion_corta={
                                    comercio.descripcion_corta
                                }
                                descripcion_corta_en={
                                    comercio.descripcion_corta_en
                                }
                                direccion={comercio.direccion}
                                imagen_principal={
                                    comercio.imagen_principal
                                }
                            />
                        ))}
                    </ul>

                    <nav
                        id="comercios-pagination"
                        aria-label={t.comercios.paginationLabel}
                        class="mt-10 flex items-center justify-center gap-3 border-t border-slate-200 pt-8"
                        hidden
                    >
                        <button
                            type="button"
                            id="comercios-prev"
                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-bold text-slate-800 outline-none transition-colors duration-200 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
                        >
                            {t.comercios.previousPage}
                        </button>

                        <span
                            id="comercios-page-info"
                            aria-live="polite"
                            class="min-w-28 text-center text-sm font-semibold text-slate-600"
                        />

                        <button
                            type="button"
                            id="comercios-next"
                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-bold text-slate-800 outline-none transition-colors duration-200 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
                        >
                            {t.comercios.nextPage}
                        </button>
                    </nav>

                    <script
                        define:vars={{
                            itemsPerPage,
                            basePath,
                            lang,
                            comerciosMeta,
                            pageLabel: t.comercios.pageLabel,
                        }}
                    >
                        const form = document.getElementById(
                            "comercios-controls",
                        );
                        const orderSelect = document.getElementById(
                            "comercios-order",
                        );
                        const list = document.getElementById(
                            "comercios-list",
                        );
                        const pagination = document.getElementById(
                            "comercios-pagination",
                        );
                        const prevButton = document.getElementById(
                            "comercios-prev",
                        );
                        const nextButton = document.getElementById(
                            "comercios-next",
                        );
                        const pageInfo = document.getElementById(
                            "comercios-page-info",
                        );
                        const resultsHeading = document.getElementById(
                            "comercios-results-title",
                        );

                        if (
                            form instanceof HTMLFormElement &&
                            orderSelect instanceof HTMLSelectElement &&
                            list instanceof HTMLElement &&
                            pagination instanceof HTMLElement &&
                            prevButton instanceof HTMLButtonElement &&
                            nextButton instanceof HTMLButtonElement &&
                            pageInfo instanceof HTMLElement
                        ) {
                            const elements = Array.from(
                                list.querySelectorAll(":scope > li"),
                            );

                            const metadata = Array.isArray(comerciosMeta)
                                ? comerciosMeta
                                : [];

                            const rows = elements.map(
                                (element, index) => ({
                                    element,
                                    nombre:
                                        metadata[index]?.nombre || "",
                                    fecha:
                                        metadata[index]?.fecha || "",
                                }),
                            );

                            const validOrders = new Set([
                                "recientes",
                                "az",
                                "za",
                            ]);

                            const params = new URLSearchParams(
                                window.location.search,
                            );

                            const requestedOrder =
                                params.get("orden");

                            let sortOrder = validOrders.has(
                                requestedOrder,
                            )
                                ? requestedOrder
                                : "recientes";

                            const requestedPage = Number.parseInt(
                                params.get("page") || "1",
                                10,
                            );

                            let currentPage =
                                Number.isFinite(requestedPage) &&
                                requestedPage > 0
                                    ? requestedPage
                                    : 1;

                            const reducedMotion = window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            );

                            orderSelect.value = sortOrder;

                            function compareNames(
                                a,
                                b,
                                direction = 1,
                            ) {
                                return (
                                    direction *
                                    a.nombre.localeCompare(
                                        b.nombre,
                                        lang,
                                        {
                                            sensitivity: "base",
                                        },
                                    )
                                );
                            }

                            function getSortedRows() {
                                return [...rows].sort((a, b) => {
                                    if (sortOrder === "az") {
                                        return compareNames(a, b);
                                    }

                                    if (sortOrder === "za") {
                                        return compareNames(
                                            a,
                                            b,
                                            -1,
                                        );
                                    }

                                    const aTime =
                                        Date.parse(a.fecha) || 0;
                                    const bTime =
                                        Date.parse(b.fecha) || 0;

                                    return (
                                        bTime -
                                            aTime ||
                                        compareNames(a, b)
                                    );
                                });
                            }

                            function updateUrl() {
                                const newParams =
                                    new URLSearchParams();

                                if (
                                    sortOrder !== "recientes"
                                ) {
                                    newParams.set(
                                        "orden",
                                        sortOrder,
                                    );
                                }

                                if (currentPage > 1) {
                                    newParams.set(
                                        "page",
                                        String(currentPage),
                                    );
                                }

                                const query =
                                    newParams.toString();

                                window.history.replaceState(
                                    {},
                                    "",
                                    query
                                        ? `${basePath}?${query}`
                                        : basePath,
                                );
                            }

                            function focusResults() {
                                if (
                                    !(
                                        resultsHeading instanceof
                                        HTMLElement
                                    )
                                ) {
                                    return;
                                }

                                requestAnimationFrame(() => {
                                    resultsHeading.focus({
                                        preventScroll: true,
                                    });

                                    resultsHeading.scrollIntoView({
                                        behavior:
                                            reducedMotion.matches
                                                ? "auto"
                                                : "smooth",
                                        block: "start",
                                    });
                                });
                            }

                            function render(
                                shouldFocus = false,
                            ) {
                                const sortedRows =
                                    getSortedRows();

                                sortedRows.forEach((row) => {
                                    list.appendChild(row.element);
                                    row.element.hidden = true;
                                });

                                const totalPages = Math.max(
                                    1,
                                    Math.ceil(
                                        sortedRows.length /
                                            itemsPerPage,
                                    ),
                                );

                                currentPage = Math.min(
                                    Math.max(currentPage, 1),
                                    totalPages,
                                );

                                const start =
                                    (currentPage - 1) *
                                    itemsPerPage;

                                sortedRows
                                    .slice(
                                        start,
                                        start + itemsPerPage,
                                    )
                                    .forEach((row) => {
                                        row.element.hidden = false;
                                    });

                                pagination.hidden =
                                    sortedRows.length <=
                                    itemsPerPage;

                                prevButton.disabled =
                                    currentPage <= 1;

                                nextButton.disabled =
                                    currentPage >= totalPages;

                                pageInfo.textContent =
                                    `${pageLabel} ` +
                                    `${currentPage} / ${totalPages}`;

                                updateUrl();

                                if (shouldFocus) {
                                    focusResults();
                                }
                            }

                            form.addEventListener(
                                "submit",
                                (event) => {
                                    event.preventDefault();

                                    sortOrder = validOrders.has(
                                        orderSelect.value,
                                    )
                                        ? orderSelect.value
                                        : "recientes";

                                    currentPage = 1;
                                    render(true);
                                },
                            );

                            prevButton.addEventListener(
                                "click",
                                () => {
                                    currentPage -= 1;
                                    render(true);
                                },
                            );

                            nextButton.addEventListener(
                                "click",
                                () => {
                                    currentPage += 1;
                                    render(true);
                                },
                            );

                            render();
                        }
                    </script>
                </section>
            ) : (
                <section
                    class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
                >
                    <h2 class="text-2xl font-black text-slate-950">
                        {t.comercios.emptyTitle}
                    </h2>

                    <p class="mt-4 max-w-2xl leading-7 text-slate-600">
                        {t.comercios.emptyText}
                    </p>

                    <p class="mt-5 text-sm text-slate-600">
                        {t.comercios.contactText}{" "}
                        <a
                            href="mailto:info@guiapineda.com"
                            class="font-semibold text-cyan-700 underline underline-offset-4 outline-none hover:text-cyan-800 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600"
                        >
                            info@guiapineda.com
                        </a>
                    </p>
                </section>
            )
        }
    </div>
</Layout>
