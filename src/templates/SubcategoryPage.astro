---
import chevronDownIcon from "../assets/icons/chevron-down.svg";
import ComercioCard from "../components/ComercioCard.astro";
import { getTranslations } from "../i18n/getTranslations";
import Layout from "../layouts/Layout.astro";
import { endpoints, fetchAPI } from "../lib/api";
import { getLocalizedName } from "../lib/getLocalizedName";
import type { Commerce as Comercio } from "../types/commerce";

type Subcategoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activa?: boolean;
    categoria?: {
        slug: string;
        activa?: boolean;
        nombre: string;
        nombre_es?: string | null;
        nombre_en?: string | null;
    };
};

const { slug, categoriaSlug, lang = "ca" } = Astro.props;

const t = getTranslations(lang);

const businessSignupHref =
    lang === "ca"
        ? "/alta-comerc/"
        : lang === "es"
          ? "/es/alta-comercio/"
          : null;
const itemsPerPage = 24;

const data = await fetchAPI(endpoints.comercios);
const todos: Comercio[] = data.data || [];

const subData = await fetchAPI(endpoints.subcategorias);
const todasLasSubcategorias: Subcategoria[] = subData.data || [];

const subcategoriaActual = todasLasSubcategorias.find(
    (subcategoria) =>
        subcategoria.activa === true &&
        subcategoria.slug === slug &&
        subcategoria.categoria?.activa === true &&
        subcategoria.categoria?.slug === categoriaSlug,
);

if (!subcategoriaActual) {
    throw new Error(
        `No se encontró la subcategoría activa "${slug}" dentro de la categoría "${categoriaSlug}".`,
    );
}

const subcategoryName = getLocalizedName(subcategoriaActual, lang);
const categoryName = subcategoriaActual.categoria
    ? getLocalizedName(subcategoriaActual.categoria, lang)
    : "";

const languagePrefix =
    lang === "es" ? "/es" : lang === "en" ? "/en" : "";

const homeUrl = languagePrefix || "/";
const categoryPath = `${languagePrefix}/${categoriaSlug}`;
const basePath = `${categoryPath}/${slug}`;

const comercios = todos.filter(
    (comercio) =>
        comercio.activo === true &&
        comercio.categoria?.slug === categoriaSlug &&
        comercio.subcategoria?.slug === slug,
);

const comerciosMeta = comercios.map((comercio) => ({
    nombre: getLocalizedName(comercio, lang),
    fecha: comercio.fecha_publicacion || "",
}));

const description =
    lang === "es"
        ? `Encuentra ${subcategoryName} en Pineda de Mar dentro de la guía GUIAPINEDA.`
        : lang === "en"
          ? `Find ${subcategoryName} in Pineda de Mar in the GUIAPINEDA guide.`
          : `Troba ${subcategoryName} a Pineda de Mar dins de la guia GUIAPINEDA.`;

const resultCount =
    comercios.length === 1
        ? t.comercios.resultSingular.replace(
              "{count}",
              String(comercios.length),
          )
        : t.comercios.resultPlural.replace(
              "{count}",
              String(comercios.length),
          );
---

<Layout
    title={`${subcategoryName} en Pineda de Mar | GUIAPINEDA`}
    description={description}
    lang={lang}
>
    <!-- Breadcrumbs de subcategoría -->
    <div class="bg-blue-950">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <nav
                aria-label={t.common.breadcrumbLabel}
                class="overflow-x-auto py-1.5 sm:py-2"
            >
                <ol class="flex min-w-max items-center text-sm font-bold">
                    <li>
                        <a
                            href={homeUrl}
                            class="inline-flex min-h-8 items-center text-white outline-none transition hover:text-sky-200 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                        >
                            {t.common.home}
                        </a>
                    </li>

                    <li aria-hidden="true" class="mx-2 text-slate-500">
                        ›
                    </li>

                    <li>
                        <a
                            href={categoryPath}
                            class="inline-flex min-h-8 items-center text-emerald-400 outline-none transition hover:text-emerald-300 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400"
                        >
                            {categoryName}
                        </a>
                    </li>

                    <li aria-hidden="true" class="mx-2 text-slate-500">
                        ›
                    </li>

                    <li>
                        <span
                            aria-current="page"
                            class="text-amber-300"
                        >
                            {subcategoryName}
                        </span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>



    <!-- Resultados y ordenación -->
    <div class="bg-blue-900">
        <div
            class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
        >
            <p class="text-base font-black text-white">
                {resultCount}
            </p>

            {
                comercios.length > 0 && (
                    <form
                        id="comercios-controls"
                        method="get"
                        action={basePath}
                        class="w-full sm:w-auto"
                    >
                        <label
                            for="comercios-order"
                            class="flex flex-col gap-2 text-sm font-semibold text-blue-100 sm:flex-row sm:items-center sm:gap-3"
                        >
                            <span>
                                {t.comercios.sortLabel}
                            </span>

                            <div class="relative">
                                <select
                                    name="orden"
                                    id="comercios-order"
                                    class="min-h-12 w-full min-w-52 appearance-none rounded-xl border border-blue-200 bg-white pl-4 pr-12 text-sm font-semibold text-slate-900 outline-none focus-visible:border-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-400 sm:w-auto"
                                    onchange="this.form.requestSubmit()"
                                >
                                    <option value="recientes">
                                        {t.comercios.sortNewest}
                                    </option>

                                    <option value="az">
                                        {t.comercios.sortAZ}
                                    </option>

                                    <option value="za">
                                        {t.comercios.sortZA}
                                    </option>
                                </select>

                                <img
                                    src={chevronDownIcon.src}
                                    alt=""
                                    aria-hidden="true"
                                    class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2"
                                />
                            </div>
                        </label>
                    </form>
                )
            }
        </div>
    </div>

    <!-- Referencia de subcategoría -->
    <section class="border-b border-amber-200 bg-amber-300/20">
        <div
            class="mx-auto max-w-7xl px-4 py-7 sm:px-6 sm:py-8 lg:px-8"
        >
            <h1
                class="text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl"
            >
                {subcategoryName}
            </h1>
        </div>
    </section>



    <div
        class="mx-auto max-w-7xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8"
    >
        {
            comercios.length > 0 ? (
                <section aria-labelledby="comercios-results-title">
                    <h2
                        id="comercios-results-title"
                        tabindex="-1"
                        class="sr-only scroll-mt-28 outline-none"
                    >
                        {t.comercios.resultsHeading}
                    </h2>



                    <ul
                        id="comercios-list"
                        class="mt-0 grid gap-5 md:grid-cols-2 lg:grid-cols-3"
                    >
                        {comercios.map((comercio: Comercio) => (
                            <ComercioCard
                                comercio={comercio}
                                categoriaSlug={categoriaSlug}
                                subcategoriaSlug={slug}
                                lang={lang}
                            />
                        ))}
                    </ul>

                    <nav
                        id="comercios-pagination"
                        aria-label={t.comercios.paginationLabel}
                        class="mt-10 flex items-center justify-center gap-3 border-t border-slate-200 pt-8"
                        hidden
                    >
                        <button
                            type="button"
                            id="comercios-prev"
                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-bold text-slate-800 outline-none transition-colors duration-200 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
                        >
                            {t.comercios.previousPage}
                        </button>

                        <span
                            id="comercios-page-info"
                            aria-live="polite"
                            class="min-w-28 text-center text-sm font-semibold text-slate-600"
                        />

                        <button
                            type="button"
                            id="comercios-next"
                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-4 text-sm font-bold text-slate-800 outline-none transition-colors duration-200 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-600"
                        >
                            {t.comercios.nextPage}
                        </button>
                    </nav>

                    <script
                        define:vars={{
                            itemsPerPage,
                            basePath,
                            lang,
                            comerciosMeta,
                            pageLabel: t.comercios.pageLabel,
                        }}
                    >
                        const form = document.getElementById(
                            "comercios-controls",
                        );
                        const orderSelect = document.getElementById(
                            "comercios-order",
                        );
                        const list = document.getElementById(
                            "comercios-list",
                        );
                        const pagination = document.getElementById(
                            "comercios-pagination",
                        );
                        const prevButton = document.getElementById(
                            "comercios-prev",
                        );
                        const nextButton = document.getElementById(
                            "comercios-next",
                        );
                        const pageInfo = document.getElementById(
                            "comercios-page-info",
                        );
                        const resultsHeading = document.getElementById(
                            "comercios-results-title",
                        );

                        if (
                            form instanceof HTMLFormElement &&
                            orderSelect instanceof HTMLSelectElement &&
                            list instanceof HTMLElement &&
                            pagination instanceof HTMLElement &&
                            prevButton instanceof HTMLButtonElement &&
                            nextButton instanceof HTMLButtonElement &&
                            pageInfo instanceof HTMLElement
                        ) {
                            const elements = Array.from(
                                list.querySelectorAll(":scope > li"),
                            );

                            const metadata = Array.isArray(comerciosMeta)
                                ? comerciosMeta
                                : [];

                            const rows = elements.map(
                                (element, index) => ({
                                    element,
                                    nombre:
                                        metadata[index]?.nombre || "",
                                    fecha:
                                        metadata[index]?.fecha || "",
                                }),
                            );

                            const validOrders = new Set([
                                "recientes",
                                "az",
                                "za",
                            ]);

                            const params = new URLSearchParams(
                                window.location.search,
                            );

                            const requestedOrder =
                                params.get("orden");

                            let sortOrder = validOrders.has(
                                requestedOrder,
                            )
                                ? requestedOrder
                                : "recientes";

                            const requestedPage = Number.parseInt(
                                params.get("page") || "1",
                                10,
                            );

                            let currentPage =
                                Number.isFinite(requestedPage) &&
                                requestedPage > 0
                                    ? requestedPage
                                    : 1;

                            const reducedMotion = window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            );

                            orderSelect.value = sortOrder;

                            function compareNames(
                                a,
                                b,
                                direction = 1,
                            ) {
                                return (
                                    direction *
                                    a.nombre.localeCompare(
                                        b.nombre,
                                        lang,
                                        {
                                            sensitivity: "base",
                                        },
                                    )
                                );
                            }

                            function getSortedRows() {
                                return [...rows].sort((a, b) => {
                                    if (sortOrder === "az") {
                                        return compareNames(a, b);
                                    }

                                    if (sortOrder === "za") {
                                        return compareNames(
                                            a,
                                            b,
                                            -1,
                                        );
                                    }

                                    const aTime =
                                        Date.parse(a.fecha) || 0;
                                    const bTime =
                                        Date.parse(b.fecha) || 0;

                                    return (
                                        bTime -
                                            aTime ||
                                        compareNames(a, b)
                                    );
                                });
                            }

                            function updateUrl() {
                                const newParams =
                                    new URLSearchParams();

                                if (
                                    sortOrder !== "recientes"
                                ) {
                                    newParams.set(
                                        "orden",
                                        sortOrder,
                                    );
                                }

                                if (currentPage > 1) {
                                    newParams.set(
                                        "page",
                                        String(currentPage),
                                    );
                                }

                                const query =
                                    newParams.toString();

                                window.history.replaceState(
                                    {},
                                    "",
                                    query
                                        ? `${basePath}?${query}`
                                        : basePath,
                                );
                            }

                            function focusResults() {
                                if (
                                    !(
                                        resultsHeading instanceof
                                        HTMLElement
                                    )
                                ) {
                                    return;
                                }

                                requestAnimationFrame(() => {
                                    resultsHeading.focus({
                                        preventScroll: true,
                                    });

                                    resultsHeading.scrollIntoView({
                                        behavior:
                                            reducedMotion.matches
                                                ? "auto"
                                                : "smooth",
                                        block: "start",
                                    });
                                });
                            }

                            function render(
                                shouldFocus = false,
                            ) {
                                const sortedRows =
                                    getSortedRows();

                                sortedRows.forEach((row) => {
                                    list.appendChild(row.element);
                                    row.element.hidden = true;
                                });

                                const totalPages = Math.max(
                                    1,
                                    Math.ceil(
                                        sortedRows.length /
                                            itemsPerPage,
                                    ),
                                );

                                currentPage = Math.min(
                                    Math.max(currentPage, 1),
                                    totalPages,
                                );

                                const start =
                                    (currentPage - 1) *
                                    itemsPerPage;

                                sortedRows
                                    .slice(
                                        start,
                                        start + itemsPerPage,
                                    )
                                    .forEach((row) => {
                                        row.element.hidden = false;
                                    });

                                pagination.hidden =
                                    sortedRows.length <=
                                    itemsPerPage;

                                prevButton.disabled =
                                    currentPage <= 1;

                                nextButton.disabled =
                                    currentPage >= totalPages;

                                pageInfo.textContent =
                                    `${pageLabel} ` +
                                    `${currentPage} / ${totalPages}`;

                                updateUrl();

                                if (shouldFocus) {
                                    focusResults();
                                }
                            }

                            form.addEventListener(
                                "submit",
                                (event) => {
                                    event.preventDefault();

                                    sortOrder = validOrders.has(
                                        orderSelect.value,
                                    )
                                        ? orderSelect.value
                                        : "recientes";

                                    currentPage = 1;
                                    render(true);
                                },
                            );

                            prevButton.addEventListener(
                                "click",
                                () => {
                                    currentPage -= 1;
                                    render(true);
                                },
                            );

                            nextButton.addEventListener(
                                "click",
                                () => {
                                    currentPage += 1;
                                    render(true);
                                },
                            );

                            render();
                        }
                    </script>
                </section>
            ) : (
                <section
                    class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
                >
                    <h2 class="text-2xl font-black text-slate-950">
                        {t.comercios.emptyTitle}
                    </h2>

                    <p class="mt-4 max-w-2xl leading-7 text-slate-600">
                        {t.comercios.emptyText}
                    </p>

                    {
                        businessSignupHref && (
                            <a
                                href={businessSignupHref}
                                class="mt-6 inline-flex min-h-14 items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-4 text-sm font-black text-slate-950 shadow-lg transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300 sm:text-base"
                            >
                                {t.home.businessCtaButton}
                                <span aria-hidden="true">→</span>
                            </a>
                        )
                    }
                </section>
            )
        }
    </div>
</Layout>
