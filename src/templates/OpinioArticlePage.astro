---
import Layout from "../layouts/Layout.astro";
import { getReadingTime } from "../lib/readingTime";
import { getTranslations } from "../i18n/getTranslations";
import { formatDate } from "../lib/formatDate";

const { lang = "ca", opinio } = Astro.props as {
    lang: string;
    opinio: any;
};

const t = getTranslations(lang as "ca" | "es" | "en");

const backUrl = lang === "ca" ? "/opinio" : `/${lang}/opinio`;
const sectionTitle =
    lang === "es" ? "Opinión" : lang === "en" ? "Opinion" : "Opinió";
const backText =
    lang === "es"
        ? "← Volver a Opinión"
        : lang === "en"
          ? "← Back to Opinion"
          : "← Tornar a Opinió";
---

<Layout lang={lang} title={`${opinio.titol} | ${sectionTitle} | GUIAPINEDA`}>
    <main>
        <a href={backUrl}>{backText}</a>

        <article>
            {
                opinio.imatge?.url && (
                    <img
                        src={`http://localhost:1337${opinio.imatge.url}`}
                        alt={opinio.titol}
                        width="800"
                    />
                )
            }

            <h1>{opinio.titol}</h1>

            <p>
                <p>
                    {opinio.autor} — {
                        formatDate(
                            opinio.data_publicacio,
                            lang as "ca" | "es" | "en",
                        )
                    }
                </p>
            </p>

            <p>
                {getReadingTime(opinio.contingut)}
                {t.opinio.readingSuffix}
            </p>

            <div>
                {
                    opinio.contingut?.map((block: any) => (
                        <p>
                            {block.children
                                ?.map((child: any) => child.text)
                                .join("")}
                        </p>
                    ))
                }
            </div>
        </article>
    </main>
</Layout>
