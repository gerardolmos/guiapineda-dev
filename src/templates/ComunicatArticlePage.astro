---
import Layout from "../layouts/Layout.astro";
import { getReadingTime } from "../lib/readingTime";
import { getTranslations } from "../i18n/getTranslations";
import { formatDate } from "../lib/formatDate";
import { getStrapiMediaUrl } from "../lib/strapi";

const { lang = "ca", comunicat } = Astro.props as {
    lang: string;
    comunicat: any;
};

const t = getTranslations(lang as "ca" | "es" | "en");

const backUrl = lang === "ca" ? "/comunicats" : `/${lang}/comunicats`;
const sectionTitle = t.comunicats.title;
---

<Layout lang={lang} title={`${comunicat.titol} | ${sectionTitle} | GUIAPINEDA`}>
    <main>
        <a href={backUrl}>{t.comunicats.backToList}</a>

        <article>
            {
                comunicat.imatge?.url && (
                    <img
                        src={getStrapiMediaUrl(comunicat.imatge.url)}
                        alt={comunicat.titol}
                        width="800"
                    />
                )
            }

            <h1>{comunicat.titol}</h1>

            <p>
                {comunicat.autor} —{" "}
                {
                    formatDate(
                        comunicat.data_publicacio,
                        lang as "ca" | "es" | "en",
                    )
                }
            </p>

            <p>
                {getReadingTime(comunicat.contingut)}{" "}
                {t.comunicats.readingSuffix}
            </p>

            <div>
                {
                    comunicat.contingut?.map((block: any) => (
                        <p>
                            {block.children
                                ?.map((child: any) => child.text)
                                .join("")}
                        </p>
                    ))
                }
            </div>
        </article>
    </main>
</Layout>
