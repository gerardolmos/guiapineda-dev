---
import Layout from "../layouts/Layout.astro";
import CommunicatSubmissionFlow from "../components/CommunicatSubmissionFlow.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";

interface Props {
    lang: "ca" | "es" | "en";
}

const { lang } = Astro.props;

const metadata = {
    ca: {
        title: "Envia un comunicat | GUIAPINEDA",
        description:
            "Envia una activitat, iniciativa o informació d'interès per a Pineda de Mar.",
    },
    es: {
        title: "Enviar un comunicado | GUIAPINEDA",
        description:
            "Envía una actividad, iniciativa o información de interés para Pineda de Mar.",
    },
    en: {
        title: "Send an announcement | GUIAPINEDA",
        description:
            "Send an activity, initiative or information of interest to Pineda de Mar.",
    },
} as const;

const { title, description } = metadata[lang];
const languageLinks = {
    ca: "/envia-un-comunicat",
    es: "/es/enviar-comunicado",
    en: "/en/comunicats/send-an-announcement",
};
---

<Layout
    lang={lang}
    title={title}
    description={description}
    showLanguageSwitcher={false}
>
    <div
        data-comunicat-language-switch
        class="border-b border-slate-200 bg-white px-5 py-4 sm:px-8"
    >
        <div class="mx-auto flex max-w-6xl justify-end">
            <LanguageSwitcher
                currentLang={lang}
                links={languageLinks}
                label={lang === "en" ? "Language" : "Idioma"}
            />
        </div>
    </div>
    <CommunicatSubmissionFlow lang={lang} />
</Layout>
