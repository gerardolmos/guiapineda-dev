---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getTranslations } from "../i18n/getTranslations";
import { getLocalizedName } from "../lib/getLocalizedName";
import ComercioCard from "../components/ComercioCard.astro";

type Subcategoria = {
    nombre: string;
    slug: string;
    activa?: boolean;
    categoria?: {
        slug: string;
    };
};

type Categoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
};

type Comercio = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activo?: boolean;
    categoria?: {
        slug: string;
    };
    subcategoria?: {
        slug: string;
    } | null;
    descripcion_corta?: string | null;
    descripcion_corta_en?: string | null;
    direccion?: string | null;
    imagen_principal?: {
        url: string;
    }[];
};

const { slug, lang } = Astro.props;

const t = getTranslations(lang);

const data = await fetchAPI(endpoints.subcategorias);
const todasLasSubcategorias: Subcategoria[] = data.data;

const categoriasData = await fetchAPI(endpoints.categorias);
const todasLasCategorias: Categoria[] = categoriasData.data;

const comerciosData = await fetchAPI(endpoints.comercios);
const todosLosComercios: Comercio[] = comerciosData.data;

const categoriaActual = todasLasCategorias.find(
    (categoria) => categoria.slug === slug,
);

const subcategorias = todasLasSubcategorias.filter((sub: any) => {
    const categoriaSlug =
        sub.categoria?.slug || sub.categoria?.data?.attributes?.slug;

    return sub.activa === true && categoriaSlug === slug;
});

const comerciosDirectos = todosLosComercios.filter(
    (comercio) =>
        comercio.activo === true &&
        comercio.categoria?.slug === slug &&
        !comercio.subcategoria,
);

const baseCategoriaUrl = lang === "es" ? "/es" : lang === "en" ? "/en" : "";

const categoryName = categoriaActual
    ? getLocalizedName(categoriaActual, lang)
    : "";

const description =
    lang === "es"
        ? `Descubre comercios y servicios de la categoría ${categoryName} en Pineda de Mar.`
        : lang === "en"
          ? `Discover businesses and services in the ${categoryName} category in Pineda de Mar.`
          : `Descobreix comerços i serveis de la categoria ${categoryName} a Pineda de Mar.`;
---

<Layout
    title={categoriaActual
        ? `${getLocalizedName(categoriaActual, lang)} | GUIAPINEDA`
        : t.pages.categoryTitle}
    description={description}
    lang={lang}
>
    <nav>
        <a href={lang === "es" ? "/es" : lang === "en" ? "/en" : "/"}>
            {t.common.home}
        </a>
        {" > "}
        <span>
            {categoriaActual ? getLocalizedName(categoriaActual, lang) : ""}
        </span>
    </nav>

    <h1>
        {
            categoriaActual
                ? getLocalizedName(categoriaActual, lang)
                : t.pages.categoryTitle
        }
    </h1>

    <p>{t.comercios.missingInfo}</p>

    <ul>
        {
            subcategorias.map((subcategoria: Subcategoria) => (
                <li>
                    <a
                        href={`${baseCategoriaUrl}/${slug}/${subcategoria.slug}`}
                    >
                        {getLocalizedName(subcategoria, lang)}
                    </a>
                </li>
            ))
        }
    </ul>
    {
        comerciosDirectos.length > 0 ? (
            <ul>
                {comerciosDirectos.map((comercio: Comercio) => (
                    <ComercioCard
                        nombre={comercio.nombre}
                        nombre_es={comercio.nombre_es}
                        nombre_en={comercio.nombre_en}
                        slug={comercio.slug}
                        categoriaSlug={slug}
                        lang={lang}
                        descripcion_corta={comercio.descripcion_corta}
                        descripcion_corta_en={comercio.descripcion_corta_en}
                        direccion={comercio.direccion}
                        imagen_principal={comercio.imagen_principal}
                    />
                ))}
            </ul>
        ) : (
            subcategorias.length === 0 && (
                <section>
                    <h2>{t.comercios.emptyTitle}</h2>

                    <p>{t.comercios.emptyText}</p>

                    <p>
                        {t.comercios.contactText}
                        <a href="mailto:info@guiapineda.com">
                            info@guiapineda.com
                        </a>
                    </p>
                </section>
            )
        )
    }
</Layout>
