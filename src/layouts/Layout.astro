---
import "../styles/global.css";
import { getTranslations } from "../i18n/getTranslations";
import { getLanguageLinks } from "../lib/languageSwitcher";

const {
    lang = "ca",
    title = "GUIAPINEDA",
    description,
    robots,
    showLanguageSwitcher = true,
} = Astro.props;

const t = getTranslations(lang);
const pathname = Astro.url.pathname;
const { currentLang, links } = getLanguageLinks(pathname);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        {robots && <meta name="robots" content={robots} />}
    </head>
    <body class="min-h-screen bg-stone-50 font-sans text-slate-950 antialiased">
        <nav>
            <a href={lang === "ca" ? "/" : `/${lang}`}>
                {t.common.home}
            </a>

            <a href={lang === "ca" ? "/comunicats" : `/${lang}/comunicats`}>
                {t.comunicats.title}
            </a>
            <a
                href={lang === "ca"
                    ? "/millorem-pineda"
                    : `/${lang}/millorem-pineda`}
            >
                {t.millores.title}
            </a>

            {
                showLanguageSwitcher && (
                    <div style="margin-top: 1rem;">
                        {
                            "ca" in links &&
                                (currentLang === "ca" ? (
                                    <strong>CA</strong>
                                ) : (
                                    <a href={links.ca}>CA</a>
                                ))
                        }

                        {
                            "es" in links && (
                                <>
                                    {" | "}
                                    {currentLang === "es" ? (
                                        <strong>ES</strong>
                                    ) : (
                                        <a href={links.es}>ES</a>
                                    )}
                                </>
                            )
                        }

                        {
                            "en" in links && (
                                <>
                                    {" | "}
                                    {currentLang === "en" ? (
                                        <strong>EN</strong>
                                    ) : (
                                        <a href={links.en}>EN</a>
                                    )}
                                </>
                            )
                        }
                    </div>
                )
            }
        </nav>

        <slot />
    </body>
</html>
