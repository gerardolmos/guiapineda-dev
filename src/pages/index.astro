---
import heroLogo from "../assets/images/guiapineda.svg?url";
import CategoryIcon from "../components/CategoryIcon.astro";
import FotoMesCard from "../components/FotoMesCard.astro";
import { getTranslations } from "../i18n/getTranslations";
import Layout from "../layouts/Layout.astro";
import { endpoints, fetchAPI } from "../lib/api";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getCategoryColor } from "../lib/categoryColors";
import { getStrapiMediaUrl } from "../lib/strapi";

type Categoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activa?: boolean;
};

const { lang = "ca" } = Astro.props;
const t = getTranslations(lang);

const homeData = await fetchAPI(endpoints.home);
const home = homeData.data;

const heroTitulo =
    lang === "es"
        ? home?.hero_titulo_es || home?.hero_titulo || "GUIAPINEDA"
        : lang === "en"
          ? home?.hero_titulo_en || home?.hero_titulo || "GUIAPINEDA"
          : home?.hero_titulo || "GUIAPINEDA";

const heroSubtitulo =
    lang === "es"
        ? home?.hero_subtitulo_es ||
          home?.hero_subtitulo ||
          t.home.heroSubtitleFallback
        : lang === "en"
          ? home?.hero_subtitulo_en ||
            home?.hero_subtitulo ||
            t.home.heroSubtitleFallback
          : home?.hero_subtitulo || t.home.heroSubtitleFallback;

const heroImagen = home?.hero_imagen;
const heroVideo = home?.hero_video;

const heroImageUrl = heroImagen?.url
    ? getStrapiMediaUrl(heroImagen.url)
    : null;

const heroVideoUrl = heroVideo?.url
    ? getStrapiMediaUrl(heroVideo.url)
    : null;

const fotoMesImagen = home?.foto_mes_imagen;
const fotoMesTitulo = home?.foto_mes_titulo;
const fotoMesAutor = home?.foto_mes_autor;
const fotoMesLugar = home?.foto_mes_lugar;
const fotoMesActiva = home?.foto_mes_activa;

const mostrarFotoMes = fotoMesActiva && fotoMesImagen?.url;

const data = await fetchAPI(endpoints.categorias);
const categoryCollator = new Intl.Collator(lang, {
    sensitivity: "base",
});

const categorias: Categoria[] = (data.data || [])
    .filter(
        (categoria: Categoria) =>
            categoria.activa === true && Boolean(categoria.slug),
    )
    .sort((a: Categoria, b: Categoria) =>
        categoryCollator.compare(
            getLocalizedName(a, lang),
            getLocalizedName(b, lang),
        ),
    );

const categoriaBasePath =
    lang === "es" ? "/es" : lang === "en" ? "/en" : "";

const businessSignupHref =
    lang === "ca"
        ? "/alta-comerc/"
        : lang === "es"
          ? "/es/alta-comercio/"
          : null;

const categoryStyles = [
    {
        hover: "hover:border-orange-300 hover:bg-orange-50",
        arrow: "text-orange-600",
        focus: "focus-visible:outline-orange-600",
    },
    {
        hover: "hover:border-lime-300 hover:bg-lime-50",
        arrow: "text-lime-700",
        focus: "focus-visible:outline-lime-600",
    },
    {
        hover: "hover:border-cyan-300 hover:bg-cyan-50",
        arrow: "text-cyan-700",
        focus: "focus-visible:outline-cyan-600",
    },
    {
        hover: "hover:border-purple-300 hover:bg-purple-50",
        arrow: "text-purple-700",
        focus: "focus-visible:outline-purple-600",
    },
    {
        hover: "hover:border-rose-300 hover:bg-rose-50",
        arrow: "text-rose-700",
        focus: "focus-visible:outline-rose-600",
    },
];

---

<style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Petit+Formal+Script&display=swap");

    .hero-manuscript {
        font-family: "Petit Formal Script", cursive;
    }

    @keyframes hero-arrow-bounce {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(6px);
        }
    }

    .hero-arrow-bounce {
        animation: hero-arrow-bounce 1.5s ease-in-out infinite;
    }
</style>

<Layout
    title="GUIAPINEDA"
    description={heroSubtitulo}
    lang={lang}
>
    <section
        class="relative isolate h-[700px] overflow-hidden border-b border-white/10 bg-slate-950"
    >
        <div class="absolute inset-0 -z-30">
            {
                heroVideoUrl ? (
                    <video
                        data-home-hero-video
                        src={heroVideoUrl}
                        poster={heroImageUrl || undefined}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-hidden="true"
                        tabindex="-1"
                        width="1920"
                        height="1080"
                        class="size-full object-cover"
                    />
                ) : heroImageUrl ? (
                    <img
                        src={heroImageUrl}
                        alt=""
                        width="1920"
                        height="1080"
                        loading="eager"
                        fetchpriority="high"
                        class="size-full object-cover"
                    />
                ) : (
                    <div
                        aria-hidden="true"
                        class="size-full bg-slate-900"
                    ></div>
                )
            }
        </div>

        <div
            aria-hidden="true"
            class="absolute inset-0 -z-20 bg-slate-950/35"
        ></div>

        <div
            aria-hidden="true"
            class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-950/15 via-slate-950/20 to-slate-950/60"
        ></div>

        <div
            aria-hidden="true"
            class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950/55 via-transparent to-slate-950/20"
        ></div>

        <div
            class="mx-auto flex h-full max-w-7xl items-center justify-center px-4 py-16 sm:px-6 lg:px-8"
        >
            <div class="mx-auto max-w-5xl text-center">
                <h1 class="mx-auto max-w-xl">
                    <img
                        src={heroLogo}
                        alt={heroTitulo}
                        width="807"
                        height="147"
                        decoding="async"
                        class="mx-auto block h-auto w-full drop-shadow-lg"
                    />
                </h1>

                <p
                    class="hero-manuscript mt-4 text-2xl leading-none text-white sm:mt-5 sm:text-4xl"
                >
                    {heroSubtitulo}
                </p>

                <div
                    class="mx-auto mt-7 max-w-5xl text-center text-white/95"
                >
                    <p
                        class="text-2xl font-black leading-tight sm:text-3xl"
                    >
                        {t.home.welcomeText}
                    </p>

                    <p
                        class="mt-2 text-xl font-semibold leading-tight sm:text-2xl"
                    >
                        {t.home.welcomeTextSecondary}
                    </p>
                </div>

                <a
                    href="#categories"
                    class="mt-10 inline-flex flex-col items-center justify-center gap-1.5 text-xl font-black text-white outline-none transition-opacity duration-200 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    {t.home.exploreCategories}

                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="hero-arrow-bounce size-6"
                    >
                        <path d="M12 4v16"></path>
                        <path d="m18 14-6 6-6-6"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <section
        id="categories"
        class="scroll-mt-24 bg-slate-950 py-14 sm:py-18 lg:py-24"
    >
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h2
                    class="text-4xl font-black tracking-tight text-white sm:text-5xl"
                >
                    {t.nav.categories}
                </h2>

                <p
                    class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8"
                >
                    {t.home.categoriesIntro}
                </p>
            </div>

            <ul
                class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-5"
            >
                {
                    categorias.map(
                        (categoria: Categoria, index: number) => {
                            const style =
                                categoryStyles[
                                    index % categoryStyles.length
                                ];

                            const cardColor =
                                getCategoryColor(categoria.slug);

                            const categoryName = getLocalizedName(
                                categoria,
                                lang,
                            );

                            return (
                                <li>
                                    <a
                                        href={`${categoriaBasePath}/${categoria.slug}`}
                                        class:list={[
                                            "group flex h-full min-h-40 flex-col overflow-hidden rounded-2xl bg-white p-0 shadow-lg outline-none transition-[transform,background-color,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 sm:min-h-44",
                                            style.hover,
                                            style.focus,
                                        ]}
                                    >
                                        <span
                                            class="flex flex-1 items-start px-3 pt-3 sm:px-4 sm:pt-4"
                                            style={`background-color: ${cardColor.background};`}
                                        >
                                            <CategoryIcon
                                                slug={categoria.slug}
                                                className="size-[3.875rem] sm:size-[4.375rem]"
                                            />
                                        </span>

                                        <span
                                            class="flex min-h-[3rem] items-center justify-between gap-3 bg-white px-4 py-2.5 sm:min-h-[3.5rem] sm:px-5 sm:py-2.5"
                                        >
                                            <span
                                                class="text-sm font-black leading-snug text-slate-950 sm:text-lg"
                                            >
                                                {categoryName}
                                            </span>

                                            <svg
                                                aria-hidden="true"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class:list={[
                                                    "size-5 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1",
                                                    style.arrow,
                                                ]}
                                                style="color: #0f172a;"
                                            >
                                                <path d="M5 12h14" />
                                                <path d="m13 6 6 6-6 6" />
                                            </svg>
                                        </span>
                                    </a>
                                </li>
                            );
                        },
                    )
                }
            </ul>

            {lang !== "en" && (
    <div
                    data-business-cta
                    class="mt-14 border-t border-white/15 pt-10 sm:mt-16 sm:pt-12"
                >
                    <div
                        class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
                    >
                        <div
                            class="max-w-3xl border-l-4 border-cyan-400 pl-5 sm:pl-7"
                        >
                            <h3
                                class="text-2xl font-black leading-tight tracking-tight text-white sm:text-3xl"
                            >
                                {t.home.businessCtaTitle}
                            </h3>

                            <p
                                class="mt-4 max-w-2xl text-base leading-7 text-slate-300"
                            >
                                {t.home.businessCtaText}
                            </p>
                        </div>

                        <div
                            class="flex flex-col items-start gap-3 lg:items-end"
                        >
                            {
                                businessSignupHref ? (
                                    <a
                                        href={businessSignupHref}
                                        class="inline-flex min-h-14 items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-4 text-center text-sm font-black text-slate-950 shadow-lg transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300 sm:text-base"
                                    >
                                        {t.home.businessCtaButton}

                                        <svg
                                            aria-hidden="true"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="size-5 shrink-0"
                                        >
                                            <path d="M5 12h14" />
                                            <path d="m13 6 6 6-6 6" />
                                        </svg>
                                    </a>
                                ) : (
                                    <>
                                        <span
                                            class="inline-flex min-h-14 items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-4 text-center text-sm font-black text-slate-950 shadow-lg sm:text-base"
                                        >
                                            {t.home.businessCtaButton}

                                            <svg
                                                aria-hidden="true"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="size-5 shrink-0"
                                            >
                                                <path d="M5 12h14" />
                                                <path d="m13 6 6 6-6 6" />
                                            </svg>
                                        </span>

                                        <span
                                            class="text-xs font-bold uppercase tracking-widest text-cyan-200"
                                        >
                                            {t.home.businessCtaSoon}
                                        </span>
                                    </>
                                )
                            }
                        </div>
                    </div>
                </div>
            )}
        </div>
    </section>

    {
        mostrarFotoMes && (
            <section
                aria-labelledby="photo-month-section-title"
                class="border-b border-stone-200 bg-stone-100 py-14 sm:py-18 lg:py-24"
            >
                <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                    <FotoMesCard
                        fotoMesImagen={fotoMesImagen}
                        fotoMesTitulo={fotoMesTitulo}
                        fotoMesAutor={fotoMesAutor}
                        fotoMesLugar={fotoMesLugar}
                        lang={lang}
                        t={t}
                    />
                </div>
            </section>
        )
    }
</Layout>

<script>
    const heroVideo = document.querySelector("[data-home-hero-video]");

    if (heroVideo instanceof HTMLVideoElement) {
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        const syncVideoWithMotionPreference = () => {
            if (reducedMotion.matches) {
                heroVideo.pause();
                heroVideo.currentTime = 0;
                return;
            }

            heroVideo.play().catch(() => {
                // El vídeo es ambiental. No se fuerza la reproducción.
            });
        };

        syncVideoWithMotionPreference();

        reducedMotion.addEventListener(
            "change",
            syncVideoWithMotionPreference,
        );
    }
</script>
