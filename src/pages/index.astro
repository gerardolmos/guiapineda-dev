---
import heroLogo from "../assets/images/guiapineda.svg?url";
import CategoryIcon from "../components/CategoryIcon.astro";
import FotoMesCard from "../components/FotoMesCard.astro";
import { getTranslations } from "../i18n/getTranslations";
import Layout from "../layouts/Layout.astro";
import { endpoints, fetchAPI } from "../lib/api";
import { getLocalizedName } from "../lib/getLocalizedName";
import { getStrapiMediaUrl } from "../lib/strapi";

type Categoria = {
    nombre: string;
    nombre_es?: string | null;
    nombre_en?: string | null;
    slug: string;
    activa?: boolean;
};

const { lang = "ca" } = Astro.props;
const t = getTranslations(lang);

const homeData = await fetchAPI(endpoints.home);
const home = homeData.data;

const heroTitulo =
    lang === "es"
        ? home?.hero_titulo_es || home?.hero_titulo || "GUIAPINEDA"
        : lang === "en"
          ? home?.hero_titulo_en || home?.hero_titulo || "GUIAPINEDA"
          : home?.hero_titulo || "GUIAPINEDA";

const heroSubtitulo =
    lang === "es"
        ? home?.hero_subtitulo_es ||
          home?.hero_subtitulo ||
          t.home.heroSubtitleFallback
        : lang === "en"
          ? home?.hero_subtitulo_en ||
            home?.hero_subtitulo ||
            t.home.heroSubtitleFallback
          : home?.hero_subtitulo || t.home.heroSubtitleFallback;

const heroImagen = home?.hero_imagen;
const heroVideo = home?.hero_video;

const heroImageUrl = heroImagen?.url
    ? getStrapiMediaUrl(heroImagen.url)
    : null;

const heroVideoUrl = heroVideo?.url
    ? getStrapiMediaUrl(heroVideo.url)
    : null;

const fotoMesImagen = home?.foto_mes_imagen;
const fotoMesTitulo = home?.foto_mes_titulo;
const fotoMesAutor = home?.foto_mes_autor;
const fotoMesLugar = home?.foto_mes_lugar;
const fotoMesActiva = home?.foto_mes_activa;

const mostrarFotoMes = fotoMesActiva && fotoMesImagen?.url;

const data = await fetchAPI(endpoints.categorias);
const categorias: Categoria[] = (data.data || []).filter(
    (categoria: Categoria) =>
        categoria.activa === true && Boolean(categoria.slug),
);

const categoriaBasePath =
    lang === "es" ? "/es" : lang === "en" ? "/en" : "";

const categoryStyles = [
    {
        hover: "hover:border-orange-300 hover:bg-orange-50",
        arrow: "text-orange-600",
        focus: "focus-visible:outline-orange-600",
    },
    {
        hover: "hover:border-lime-300 hover:bg-lime-50",
        arrow: "text-lime-700",
        focus: "focus-visible:outline-lime-600",
    },
    {
        hover: "hover:border-cyan-300 hover:bg-cyan-50",
        arrow: "text-cyan-700",
        focus: "focus-visible:outline-cyan-600",
    },
    {
        hover: "hover:border-purple-300 hover:bg-purple-50",
        arrow: "text-purple-700",
        focus: "focus-visible:outline-purple-600",
    },
    {
        hover: "hover:border-rose-300 hover:bg-rose-50",
        arrow: "text-rose-700",
        focus: "focus-visible:outline-rose-600",
    },
];
---

<Layout
    title="GUIAPINEDA"
    description={heroSubtitulo}
    lang={lang}
>
    <section
        class="relative overflow-hidden border-b border-stone-200 bg-stone-100"
    >
        <div
            class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14 lg:px-8 lg:py-20"
        >
            <div class="order-2 max-w-2xl lg:order-1">
                <h1 class="max-w-lg">
                    <img
                        src={heroLogo}
                        alt={heroTitulo}
                        width="807"
                        height="147"
                        decoding="async"
                        class="block h-auto w-full"
                    />
                </h1>

                <p
                    class="mt-5 max-w-xl text-xl font-semibold leading-8 text-slate-700 sm:text-2xl"
                >
                    {heroSubtitulo}
                </p>

                <p class="mt-6 max-w-xl text-base leading-7 text-slate-600">
                    {t.home.welcomeText}
                </p>

                <a
                    href="#categories"
                    class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-sm outline-none transition-colors duration-200 hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-500"
                >
                    {t.home.exploreCategories}

                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-5"
                    >
                        <path d="M12 5v14"></path>
                        <path d="m19 12-7 7-7-7"></path>
                    </svg>
                </a>
            </div>

            <div class="relative order-1 lg:order-2">
                <div
                    class="overflow-hidden rounded-3xl border border-slate-200 bg-slate-200 shadow-xl"
                >
                    <div class="aspect-[4/3] overflow-hidden">
                        {
                            heroVideoUrl ? (
                                <video
                                    data-home-hero-video
                                    src={heroVideoUrl}
                                    poster={heroImageUrl || undefined}
                                    autoplay
                                    muted
                                    loop
                                    playsinline
                                    preload="metadata"
                                    aria-hidden="true"
                                    tabindex="-1"
                                    width="1200"
                                    height="900"
                                    class="size-full object-cover"
                                />
                            ) : heroImageUrl ? (
                                <img
                                    src={heroImageUrl}
                                    alt=""
                                    width="1200"
                                    height="900"
                                    loading="eager"
                                    fetchpriority="high"
                                    class="size-full object-cover"
                                />
                            ) : (
                                <div
                                    aria-hidden="true"
                                    class="size-full bg-stone-200"
                                ></div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section
        id="categories"
        class="scroll-mt-24 bg-slate-950 py-14 sm:py-18 lg:py-24"
    >
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <h2
                    class="text-4xl font-black tracking-tight text-white sm:text-5xl"
                >
                    {t.nav.categories}
                </h2>

                <p
                    class="mt-5 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg sm:leading-8"
                >
                    {t.home.categoriesIntro}
                </p>
            </div>

            <ul
                class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4 xl:grid-cols-6"
            >
                {
                    categorias.map(
                        (categoria: Categoria, index: number) => {
                            const style =
                                categoryStyles[
                                    index % categoryStyles.length
                                ];

                            const categoryName = getLocalizedName(
                                categoria,
                                lang,
                            );

                            return (
                                <li>
                                    <a
                                        href={`${categoriaBasePath}/${categoria.slug}`}
                                        class:list={[
                                            "group flex h-full min-h-40 flex-col justify-between rounded-2xl border border-white/10 bg-white p-4 shadow-lg outline-none transition-[transform,border-color,background-color,box-shadow] duration-200 hover:-translate-y-1 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 sm:min-h-44 sm:p-5",
                                            style.hover,
                                            style.focus,
                                        ]}
                                    >
                                        <CategoryIcon
                                            slug={categoria.slug}
                                            className="size-14 sm:size-16"
                                        />

                                        <span
                                            class="mt-8 flex items-end justify-between gap-3"
                                        >
                                            <span
                                                class="text-sm font-black leading-snug text-slate-950 sm:text-base"
                                            >
                                                {categoryName}
                                            </span>

                                            <svg
                                                aria-hidden="true"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class:list={[
                                                    "size-5 shrink-0 transition-transform duration-200 motion-safe:group-hover:translate-x-1",
                                                    style.arrow,
                                                ]}
                                            >
                                                <path d="M5 12h14" />
                                                <path d="m13 6 6 6-6 6" />
                                            </svg>
                                        </span>
                                    </a>
                                </li>
                            );
                        },
                    )
                }
            </ul>

            <div
                data-business-cta
                class="mt-14 border-t border-white/15 pt-10 sm:mt-16 sm:pt-12"
            >
                <div
                    class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
                >
                    <div
                        class="max-w-3xl border-l-4 border-cyan-400 pl-5 sm:pl-7"
                    >
                        <h3
                            class="text-2xl font-black leading-tight tracking-tight text-white sm:text-3xl"
                        >
                            {t.home.businessCtaTitle}
                        </h3>

                        <p
                            class="mt-4 max-w-2xl text-base leading-7 text-slate-300"
                        >
                            {t.home.businessCtaText}
                        </p>
                    </div>

                    <div
                        class="flex flex-col items-start gap-3 lg:items-end"
                    >
                        <span
                            class="inline-flex min-h-14 items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-4 text-center text-sm font-black text-slate-950 shadow-lg sm:text-base"
                        >
                            {t.home.businessCtaButton}

                            <svg
                                aria-hidden="true"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="size-5 shrink-0"
                            >
                                <path d="M5 12h14" />
                                <path d="m13 6 6 6-6 6" />
                            </svg>
                        </span>

                        <span
                            class="text-xs font-bold uppercase tracking-widest text-cyan-200"
                        >
                            {t.home.businessCtaSoon}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {
        mostrarFotoMes && (
            <section
                aria-labelledby="photo-month-section-title"
                class="border-b border-stone-200 bg-stone-100 py-14 sm:py-18 lg:py-24"
            >
                <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                    <FotoMesCard
                        fotoMesImagen={fotoMesImagen}
                        fotoMesTitulo={fotoMesTitulo}
                        fotoMesAutor={fotoMesAutor}
                        fotoMesLugar={fotoMesLugar}
                        lang={lang}
                        t={t}
                    />
                </div>
            </section>
        )
    }
</Layout>

<script>
    const heroVideo = document.querySelector("[data-home-hero-video]");

    if (heroVideo instanceof HTMLVideoElement) {
        const reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        const syncVideoWithMotionPreference = () => {
            if (reducedMotion.matches) {
                heroVideo.pause();
                heroVideo.currentTime = 0;
                return;
            }

            heroVideo.play().catch(() => {
                // El vídeo es ambiental. No se fuerza la reproducción.
            });
        };

        syncVideoWithMotionPreference();

        reducedMotion.addEventListener(
            "change",
            syncVideoWithMotionPreference,
        );
    }
</script>
