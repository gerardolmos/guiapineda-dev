---
import { fetchAPI, endpoints } from "../../lib/api";
import ComunicatArticlePage from "../../templates/ComunicatArticlePage.astro";

export async function getStaticPaths() {
    const comunicatsData = await fetchAPI(endpoints.comunicats);
    const comunicats = comunicatsData.data || [];

    return comunicats
        .filter(
            (comunicat: any) =>
                typeof comunicat.slug === "string" &&
                comunicat.slug.trim().length > 0,
        )
        .map((comunicat: any) => ({
            params: {
                slug: comunicat.slug,
            },
            props: {
                comunicat,
                lang: "ca",
            },
        }));
}

const { comunicat, lang } = Astro.props;
---

<ComunicatArticlePage comunicat={comunicat} lang={lang} />
