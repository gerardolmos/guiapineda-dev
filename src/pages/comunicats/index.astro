---
import Layout from "../../layouts/Layout.astro";
import CommunicatCard from "../../components/CommunicatCard.astro";
import SubmissionCta from "../../components/SubmissionCta.astro";
import { fetchAPI, endpoints } from "../../lib/api";
import { getTranslations } from "../../i18n/getTranslations";
import { filterVisibleComunicats } from "../../lib/comunicats";

const { lang = "ca" } = Astro.props;

const t = getTranslations(lang);

const [introTitleLead, ...introTitleRest] =
    t.comunicats.introTitle.split(",");
const introTitleAccent = introTitleRest.join(",").trim();

const comunicatsData = await fetchAPI(endpoints.comunicats);

const comunicats = filterVisibleComunicats(
    comunicatsData.data || [],
);

const sortedComunicats = [...comunicats].sort(
    (a: any, b: any) =>
        new Date(b.data_publicacio).getTime() -
        new Date(a.data_publicacio).getTime(),
);

const submitUrl =
    lang === "ca"
        ? "/envia-un-comunicat/"
        : lang === "es"
          ? "/es/enviar-comunicado/"
          : null;

const itemsPerPage = 10;

const basePath =
    lang === "ca"
        ? "/comunicats/"
        : `/${lang}/comunicats/`;
---

<Layout
    lang={lang}
    title={`${t.comunicats.title} | GUIAPINEDA`}
    description={t.comunicats.introText}
>
    <div class="bg-stone-50">
        <!-- Hero editorial de sección -->
        <section
            class="relative overflow-hidden bg-violet-950 px-5 py-14 sm:px-8 sm:py-16 lg:py-20"
        >
            <div class="mx-auto max-w-6xl">
                <div
                    class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16"
                >
                    <div class="flex flex-col justify-center">
                        <h1
                            class="max-w-4xl text-5xl font-black leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl"
                        >
                            {t.comunicats.title}
                        </h1>

                        <p
                            class="mt-2 text-2xl font-black tracking-[0.01em] text-fuchsia-500 sm:text-3xl"
                        >
                            {t.comunicats.eyebrow}
                        </p>
                    </div>

                    <div
                        class="border-l-4 border-fuchsia-400 pl-5 sm:pl-6"
                    >
                        <h2
                            class="text-3xl font-black leading-tight text-white sm:text-4xl"
                        >
                            {introTitleLead}
                            {
                                introTitleAccent && (
                                    <>
                                        {","}<br />
                                        <span class="text-emerald-500">
                                            {introTitleAccent}
                                        </span>
                                    </>
                                )
                            }
                        </h2>

                        <p
                            class="mt-4 max-w-2xl text-lg leading-8 text-violet-100 sm:text-xl sm:leading-9"
                        >
                            {t.comunicats.introText}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <div
            aria-hidden="true"
            class="grid h-2 grid-cols-6"
        >
            <span class="bg-sky-500"></span>
            <span class="bg-fuchsia-500"></span>
            <span class="bg-amber-400"></span>
            <span class="bg-emerald-500"></span>
            <span class="bg-violet-500"></span>
            <span class="bg-cyan-500"></span>
        </div>

        <!-- Los comunicados son el contenido principal -->
        <section
            id="comunicats-list"
            class="border-t border-slate-200 bg-white px-5 py-10 sm:px-8 sm:py-12"
        >
            <div class="mx-auto max-w-6xl">
                <div>
                    <p
                        class="text-xs font-black uppercase tracking-[0.18em] text-sky-700"
                    >
                        GUIAPINEDA
                    </p>

                    <h2
                        class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl"
                    >
                        {t.comunicats.latestTitle}
                    </h2>
                </div>

                {
                    sortedComunicats.length === 0 ? (
                        <div
                            class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-stone-50 p-8 text-slate-600"
                        >
                            {t.comunicats.empty}
                        </div>
                    ) : (
                        <div
                            id="comunicats-grid"
                            class="mt-8 grid gap-5 md:grid-cols-2"
                        >
                            {
                                sortedComunicats.map(
                                    (comunicat: any, index: number) => (
                                        <div
                                            class="comunicat-list-item"
                                            hidden={index >= itemsPerPage}
                                        >
                                            <CommunicatCard
                                                item={comunicat}
                                                href={
                                                    lang === "ca"
                                                        ? `/comunicats/${comunicat.slug}`
                                                        : `/${lang}/comunicats/${comunicat.slug}`
                                                }
                                                lang={
                                                    lang as
                                                        | "ca"
                                                        | "es"
                                                        | "en"
                                                }
                                                readingSuffix={
                                                    t.comunicats
                                                        .readingSuffix
                                                }
                                            />
                                        </div>
                                    ),
                                )
                            }
                        </div>
                    )
                }

                {
                    sortedComunicats.length > itemsPerPage && (
                        <nav
                            id="comunicats-pagination"
                            aria-label={t.comunicats.paginationLabel}
                            class="mt-10 flex items-center justify-center gap-4 border-t border-slate-200 pt-7"
                        >
                            <button
                                type="button"
                                id="comunicats-prev-page"
                                class="min-h-10 rounded-full border border-slate-300 bg-white px-5 py-2 text-sm font-black text-slate-700 transition hover:border-sky-300 hover:text-sky-800 disabled:cursor-not-allowed disabled:opacity-35"
                            >
                                {t.comunicats.previousPage}
                            </button>

                            <span
                                id="comunicats-page-info"
                                aria-live="polite"
                                class="min-w-24 text-center text-sm font-bold text-slate-500"
                            ></span>

                            <button
                                type="button"
                                id="comunicats-next-page"
                                class="min-h-10 rounded-full border border-slate-300 bg-white px-5 py-2 text-sm font-black text-slate-700 transition hover:border-sky-300 hover:text-sky-800 disabled:cursor-not-allowed disabled:opacity-35"
                            >
                                {t.comunicats.nextPage}
                            </button>
                        </nav>
                    )
                }

                {
                    submitUrl && (
                        <SubmissionCta
                            title={t.comunicats.ctaTitle}
                            text={t.comunicats.ctaText}
                            note={t.comunicats.ctaNote}
                            button={t.comunicats.ctaButton}
                            href={submitUrl}
                            variant="comunicats"
                        />
                    )
                }
            </div>
        </section>
    </div>

    {
        sortedComunicats.length > itemsPerPage && (
            <script
                define:vars={{
                    itemsPerPage,
                    basePath,
                    pageLabel: t.comunicats.pageLabel,
                }}
            >
                const items = Array.from(
                    document.querySelectorAll(".comunicat-list-item"),
                );

                const list = document.getElementById("comunicats-list");
                const prevButton = document.getElementById(
                    "comunicats-prev-page",
                );
                const nextButton = document.getElementById(
                    "comunicats-next-page",
                );
                const pageInfo = document.getElementById(
                    "comunicats-page-info",
                );

                const params = new URLSearchParams(
                    window.location.search,
                );

                let currentPage = Number(
                    params.get("page") || "1",
                );

                const totalPages = Math.max(
                    1,
                    Math.ceil(items.length / itemsPerPage),
                );

                currentPage = Math.min(
                    Math.max(currentPage, 1),
                    totalPages,
                );

                function updateUrl() {
                    const newParams = new URLSearchParams();

                    if (currentPage > 1) {
                        newParams.set(
                            "page",
                            String(currentPage),
                        );
                    }

                    const query = newParams.toString();

                    window.history.replaceState(
                        {},
                        "",
                        query
                            ? `${basePath}?${query}`
                            : basePath,
                    );
                }

                function render() {
                    const start =
                        (currentPage - 1) * itemsPerPage;

                    const end = start + itemsPerPage;

                    items.forEach((item, index) => {
                        item.hidden =
                            index < start || index >= end;
                    });

                    prevButton.disabled = currentPage <= 1;
                    nextButton.disabled =
                        currentPage >= totalPages;

                    pageInfo.textContent =
                        `${pageLabel} ${currentPage} / ${totalPages}`;

                    updateUrl();
                }

                function goToPage(page) {
                    currentPage = Math.min(
                        Math.max(page, 1),
                        totalPages,
                    );

                    render();

                    const reduceMotion =
                        window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;

                    list?.scrollIntoView({
                        behavior: reduceMotion
                            ? "auto"
                            : "smooth",
                        block: "start",
                    });
                }

                prevButton?.addEventListener(
                    "click",
                    () => {
                        goToPage(currentPage - 1);
                    },
                );

                nextButton?.addEventListener(
                    "click",
                    () => {
                        goToPage(currentPage + 1);
                    },
                );

                render();
            </script>
        )
    }
</Layout>
