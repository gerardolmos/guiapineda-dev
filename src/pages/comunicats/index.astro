---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { fetchAPI, endpoints } from "../../lib/api";
import { getTranslations } from "../../i18n/getTranslations";

const { lang = "ca" } = Astro.props;
const t = getTranslations(lang);

const comunicatsData = await fetchAPI(endpoints.comunicats);
const comunicats = comunicatsData.data || [];

const sortedComunicats = [...comunicats].sort(
        (a: any, b: any) =>
            new Date(b.data_publicacio).getTime() -
            new Date(a.data_publicacio).getTime(),
    );
---

<Layout lang={lang} title={`${t.comunicats.title} | GUIAPINEDA`}>
    <main>
        <h1>{t.comunicats.title}</h1>

        <section>
            <h2>{t.comunicats.submitTitle}</h2>

            <p>{t.comunicats.submitText1}</p>

            <p>{t.comunicats.submitText2}</p>

            <p>
                {t.comunicats.submitEmailText}
                <a href="mailto:info@guiapineda.com"> info@guiapineda.com </a>
            </p>
        </section>

        {
            sortedComunicats.length === 0 ? (
                <p>{t.comunicats.empty}</p>
            ) : (
                sortedComunicats.map((comunicat: any) => (
                    <ArticleCard
                        item={comunicat}
                        href={
                            lang === "ca"
                                ? `/comunicats/${comunicat.slug}`
                                : `/${lang}/comunicats/${comunicat.slug}`
                        }
                        lang={lang as "ca" | "es" | "en"}
                        readingSuffix={t.comunicats.readingSuffix}
                    />
                ))
            )
        }
    </main>
</Layout>
