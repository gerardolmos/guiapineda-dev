---
import Layout from "../../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../../lib/api";
import { formatDate } from "../../lib/formatDate";
import { getReadingTime } from "../../lib/readingTime";
import { getStrapiMediaUrl } from "../../lib/strapi";
import type { Lang } from "../../lib/languageSwitcher";

const { lang = "ca" } = Astro.props as {
    lang?: Lang;
};

const copy = {
    ca: {
        title: "Veus de Pineda",
        description:
            "Opinions, reflexions i experiències personals vinculades a Pineda de Mar.",
        empty:
            "Ara mateix no hi ha cap veu publicada.",
        view: "Llegir la veu",
        readingSuffix: "min de lectura",
    },
    es: {
        title: "Voces de Pineda",
        description:
            "Opiniones, reflexiones y experiencias personales vinculadas a Pineda de Mar.",
        empty:
            "Ahora mismo no hay ninguna voz publicada.",
        view: "Leer la voz",
        readingSuffix: "min de lectura",
    },
    en: {
        title: "Voices of Pineda",
        description:
            "Opinions, reflections and personal experiences connected to Pineda de Mar.",
        empty:
            "There are currently no voices published.",
        view: "Read this voice",
        readingSuffix: "min read",
    },
}[lang];

const veusData = await fetchAPI(endpoints.veus);

const veus = (veusData.data || [])
    .filter(
        (veu: any) =>
            typeof veu.slug === "string" &&
            veu.slug.trim().length > 0,
    )
    .sort((a: any, b: any) => {
        const dateA = Date.parse(a.data_publicacio || "") || 0;
        const dateB = Date.parse(b.data_publicacio || "") || 0;
        return dateB - dateA;
    });

function getImageUrl(image: unknown): string | null {
    if (!image || typeof image !== "object") {
        return null;
    }

    const url = (image as { url?: unknown }).url;

    if (
        typeof url !== "string" ||
        url.trim().length === 0
    ) {
        return null;
    }

    return getStrapiMediaUrl(url);
}

function getVeuUrl(slug: string): string {
    return lang === "ca"
        ? `/veus/${slug}`
        : `/${lang}/veus/${slug}`;
}
---

<Layout
    lang={lang}
    title={`${copy.title} | GUIAPINEDA`}
    description={copy.description}
>
    <main class="bg-stone-50">
        <section
            class="bg-violet-950 px-5 py-14 sm:px-8 sm:py-16"
        >
            <div class="mx-auto max-w-6xl">
                <p
                    class="text-sm font-black uppercase tracking-[0.18em] text-violet-300"
                >
                    GUIAPINEDA
                </p>

                <h1
                    class="mt-3 text-5xl font-black tracking-tight text-white sm:text-6xl"
                >
                    {copy.title}
                </h1>

                <p
                    class="mt-5 max-w-3xl text-lg leading-8 text-violet-100 sm:text-xl"
                >
                    {copy.description}
                </p>
            </div>
        </section>

        <div
            aria-hidden="true"
            class="grid h-1.5 grid-cols-6"
        >
            <span class="bg-sky-500"></span>
            <span class="bg-fuchsia-500"></span>
            <span class="bg-amber-400"></span>
            <span class="bg-emerald-500"></span>
            <span class="bg-violet-500"></span>
            <span class="bg-cyan-500"></span>
        </div>

        <section class="px-5 py-10 sm:px-8 sm:py-14">
            <div class="mx-auto max-w-6xl">
                {
                    veus.length === 0 ? (
                        <p
                            class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600"
                        >
                            {copy.empty}
                        </p>
                    ) : (
                        <div class="grid gap-5 md:grid-cols-2">
                            {veus.map((veu: any) => {
                                const imageUrl =
                                    getImageUrl(veu.imatge);
                                const url =
                                    getVeuUrl(veu.slug);
                                const readingTime =
                                    getReadingTime(
                                        veu.contingut,
                                    );

                                return (
                                    <article
                                        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
                                    >
                                        {imageUrl && (
                                            <a
                                                href={url}
                                                tabindex="-1"
                                                aria-hidden="true"
                                            >
                                                <img
                                                    src={imageUrl}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="aspect-[16/7] w-full object-cover"
                                                />
                                            </a>
                                        )}

                                        <div class="p-5 sm:p-6">
                                            <div
                                                class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-bold text-violet-700"
                                            >
                                                <span>
                                                    {
                                                        veu.autor_public
                                                    }
                                                </span>

                                                <span
                                                    aria-hidden="true"
                                                    class="text-slate-300"
                                                >
                                                    ·
                                                </span>

                                                <span>
                                                    {
                                                        formatDate(
                                                            veu.data_publicacio,
                                                            lang,
                                                        )
                                                    }
                                                </span>
                                            </div>

                                            <h2
                                                class="mt-3 text-2xl font-black leading-tight tracking-tight text-slate-950"
                                            >
                                                <a
                                                    href={url}
                                                    class="outline-none transition-colors hover:text-violet-700 focus-visible:text-violet-700"
                                                >
                                                    {veu.titol}
                                                </a>
                                            </h2>

                                            <p
                                                class="mt-3 text-sm leading-6 text-slate-600"
                                            >
                                                {veu.resum}
                                            </p>

                                            <div
                                                class="mt-5 flex items-center justify-between gap-4 border-t border-slate-200 pt-4 text-sm"
                                            >
                                                <span
                                                    class="font-semibold text-slate-500"
                                                >
                                                    {
                                                        readingTime
                                                    }{" "}
                                                    {
                                                        copy.readingSuffix
                                                    }
                                                </span>

                                                <a
                                                    href={url}
                                                    class="font-black text-violet-800 transition hover:text-violet-600"
                                                >
                                                    {copy.view} →
                                                </a>
                                            </div>
                                        </div>
                                    </article>
                                );
                            })}
                        </div>
                    )
                }
            </div>
        </section>
    </main>
</Layout>
