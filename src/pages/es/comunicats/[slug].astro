---
import { fetchAPI, endpoints } from "../../../lib/api";
import ComunicatArticlePage from "../../../templates/ComunicatArticlePage.astro";
import {
    filterVisibleComunicats,
    getRelatedComunicats,
} from "../../../lib/comunicats";

export async function getStaticPaths() {
    const comunicatsData = await fetchAPI(endpoints.comunicats);
    const comunicats = filterVisibleComunicats(
        comunicatsData.data || [],
    );

    return comunicats
        .filter(
            (comunicat: any) =>
                typeof comunicat.slug === "string" &&
                comunicat.slug.trim().length > 0,
        )
        .map((comunicat: any) => ({
            params: {
                slug: comunicat.slug,
            },
            props: {
                comunicat,
                relatedComunicats: getRelatedComunicats(
                    comunicat,
                    comunicats,
                ),
                lang: "es",
            },
        }));
}

const {
    comunicat,
    relatedComunicats,
    lang,
} = Astro.props;
---

<ComunicatArticlePage
    comunicat={comunicat}
    relatedComunicats={relatedComunicats}
    lang={lang}
/>
