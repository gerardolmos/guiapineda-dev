---
import SubcategoryPage from "../../../templates/SubcategoryPage.astro";
import { fetchAPI, endpoints } from "../../../lib/api";

type Subcategoria = {
    slug: string;
};

export async function getStaticPaths() {
    const data = await fetchAPI(endpoints.subcategorias);

    const subcategorias: Subcategoria[] = data.data;

    return subcategorias.map((subcategoria: Subcategoria) => ({
        params: { slug: subcategoria.slug },
    }));
}

const { slug } = Astro.params;
---

<SubcategoryPage slug={slug} lang="es" />
