---
import { fetchAPI, endpoints } from "../../../lib/api";
import AgendaArticlePage from "../../../templates/AgendaArticlePage.astro";

export async function getStaticPaths() {
    const agendaData = await fetchAPI(
        endpoints.agendas,
    );

    const events = agendaData.data || [];

    return events
        .filter(
            (event: any) =>
                typeof event.slug === "string" &&
                event.slug.trim().length > 0,
        )
        .map((event: any) => ({
            params: {
                slug: event.slug,
            },
            props: {
                event,
                lang: "es",
            },
        }));
}

const { event, lang } = Astro.props;
---

<AgendaArticlePage
    event={event}
    lang={lang}
/>
