---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getStrapiMediaUrl } from "../lib/strapi";
import {
    buildTaulerItems,
    type TaulerItemType,
    type TaulerLang,
} from "../lib/tauler";

const { lang = "ca" } = Astro.props as {
    lang?: TaulerLang;
};

const copy = {
    ca: {
        title: "El Tauler",
        description:
            "Les últimes aportacions publicades a GUIAPINEDA, reunides en un mateix espai.",
        empty: "Encara no hi ha aportacions publicades.",
        view: "Veure aportació",
        comunicat: "Comunicats",
        millora: "Millorem Pineda",
        locale: "ca-ES",
        filterLabel: "Filtra el tauler",
        all: "Tot",
        noFilteredResults:
            "No hi ha aportacions publicades d’aquest tipus.",
    },
    es: {
        title: "El Tablón",
        description:
            "Las últimas aportaciones publicadas en GUIAPINEDA, reunidas en un mismo espacio.",
        empty: "Todavía no hay aportaciones publicadas.",
        view: "Ver aportación",
        comunicat: "Comunicados",
        millora: "Mejoremos Pineda",
        locale: "es-ES",
        filterLabel: "Filtra el tablón",
        all: "Todo",
        noFilteredResults:
            "No hay aportaciones publicadas de este tipo.",
    },
    en: {
        title: "The Board",
        description:
            "The latest contributions published on GUIAPINEDA, brought together in one place.",
        empty: "There are no published contributions yet.",
        view: "View contribution",
        comunicat: "Notices",
        millora: "Improve Pineda",
        locale: "en-GB",
        filterLabel: "Filter the board",
        all: "All",
        noFilteredResults:
            "There are no published contributions of this type.",
    },
}[lang];

const [comunicatsData, milloresData] = await Promise.all([
    fetchAPI(endpoints.comunicats),
    fetchAPI(endpoints.millores),
]);

const items = buildTaulerItems({
    comunicats: comunicatsData.data || [],
    millores: milloresData.data || [],
    lang,
});

const typeLabels: Record<TaulerItemType, string> = {
    comunicat: copy.comunicat,
    millora: copy.millora,
};

const typeClasses: Record<TaulerItemType, string> = {
    comunicat: "bg-violet-100 text-violet-800",
    millora: "bg-sky-100 text-sky-800",
};

function formatDate(value: string): string {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);

    if (!match) {
        return value;
    }

    const [, year, month, day] = match;

    return new Intl.DateTimeFormat(copy.locale, {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "Europe/Madrid",
    }).format(
        new Date(
            Date.UTC(
                Number(year),
                Number(month) - 1,
                Number(day),
                12,
            ),
        ),
    );
}

function getItemImageUrl(image: unknown): string | null {
    if (!image || typeof image !== "object") {
        return null;
    }

    const url = (image as { url?: unknown }).url;

    if (
        typeof url !== "string" ||
        url.trim().length === 0
    ) {
        return null;
    }

    return getStrapiMediaUrl(url);
}

function getItemImageAlt(
    image: unknown,
    fallback: string,
): string {
    if (!image || typeof image !== "object") {
        return fallback;
    }

    const alternativeText = (
        image as {
            alternativeText?: unknown;
        }
    ).alternativeText;

    if (
        typeof alternativeText === "string" &&
        alternativeText.trim().length > 0
    ) {
        return alternativeText.trim();
    }

    return fallback;
}
---

<Layout
    lang={lang}
    title={`${copy.title} | GUIAPINEDA`}
    description={copy.description}
>
    <main class="bg-stone-50">
        <section
            class="bg-slate-950 px-5 py-14 sm:px-8 sm:py-16"
        >
            <div class="mx-auto max-w-6xl">
                <p
                    class="text-sm font-black uppercase tracking-[0.18em] text-sky-400"
                >
                    GUIAPINEDA
                </p>

                <h1
                    class="mt-3 text-5xl font-black tracking-tight text-white sm:text-6xl"
                >
                    {copy.title}
                </h1>

                <p
                    class="mt-5 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl"
                >
                    {copy.description}
                </p>
            </div>
        </section>

        <div
            aria-hidden="true"
            class="grid h-1.5 grid-cols-6"
        >
            <span class="bg-sky-500"></span>
            <span class="bg-fuchsia-500"></span>
            <span class="bg-amber-400"></span>
            <span class="bg-emerald-500"></span>
            <span class="bg-violet-500"></span>
            <span class="bg-cyan-500"></span>
        </div>

        <section class="px-5 py-10 sm:px-8 sm:py-14">
            <div class="mx-auto max-w-6xl">
                {
                    items.length > 0 && (
                        <div
                            class="mb-8 flex flex-wrap items-center gap-3"
                            aria-label={copy.filterLabel}
                        >
                            <button
                                type="button"
                                data-tauler-filter="all"
                                aria-pressed="true"
                                class="tauler-filter rounded-full bg-slate-950 px-4 py-2 text-sm font-black text-white outline-none transition focus-visible:ring-4 focus-visible:ring-sky-200"
                            >
                                {copy.all}
                            </button>

                            <button
                                type="button"
                                data-tauler-filter="comunicat"
                                aria-pressed="false"
                                class="tauler-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-black text-slate-700 outline-none transition hover:border-violet-300 hover:text-violet-800 focus-visible:ring-4 focus-visible:ring-violet-100"
                            >
                                {copy.comunicat}
                            </button>

                            <button
                                type="button"
                                data-tauler-filter="millora"
                                aria-pressed="false"
                                class="tauler-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-black text-slate-700 outline-none transition hover:border-sky-300 hover:text-sky-800 focus-visible:ring-4 focus-visible:ring-sky-100"
                            >
                                {copy.millora}
                            </button>
                        </div>
                    )
                }

                {
                    items.length === 0 ? (
                        <p
                            class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600"
                        >
                            {copy.empty}
                        </p>
                    ) : (
                        <div class="grid gap-5 md:grid-cols-2">
                            {items.map((item) => {
                                const imageUrl =
                                    getItemImageUrl(item.image);

                                const imageAlt =
                                    getItemImageAlt(
                                        item.image,
                                        item.title,
                                    );

                                return (
                                    <article
                                        data-tauler-item
                                        data-tauler-type={item.type}
                                        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
                                    >
                                        <div
                                            class="grid h-full grid-cols-[8rem_1fr] sm:grid-cols-[9.5rem_1fr]"
                                        >
                                            {
                                                imageUrl ? (
                                                    <a
                                                        href={
                                                            item.url
                                                        }
                                                        class="block min-h-full bg-slate-200"
                                                    >
                                                        <img
                                                            src={
                                                                imageUrl
                                                            }
                                                            alt={
                                                                imageAlt
                                                            }
                                                            loading="lazy"
                                                            decoding="async"
                                                            class="h-full min-h-44 w-full object-cover"
                                                        />
                                                    </a>
                                                ) : (
                                                    <div
                                                        aria-hidden="true"
                                                        class="min-h-44 bg-stone-100"
                                                    />
                                                )
                                            }

                                            <div
                                                class="flex min-w-0 flex-col p-4 sm:p-5"
                                            >
                                                <div
                                                    class="flex flex-wrap items-center gap-2"
                                                >
                                                    <span
                                                        class:list={[
                                                            "rounded-full px-2.5 py-1 text-[0.68rem] font-black uppercase tracking-[0.08em]",
                                                            typeClasses[
                                                                item
                                                                    .type
                                                            ],
                                                        ]}
                                                    >
                                                        {
                                                            typeLabels[
                                                                item
                                                                    .type
                                                            ]
                                                        }
                                                    </span>

                                                    <time
                                                        datetime={
                                                            item.date
                                                        }
                                                        class="text-xs font-semibold text-slate-500"
                                                    >
                                                        {
                                                            formatDate(
                                                                item.date,
                                                            )
                                                        }
                                                    </time>
                                                </div>

                                                <h2
                                                    class="mt-3 text-xl font-black leading-tight tracking-tight text-slate-950"
                                                >
                                                    <a
                                                        href={
                                                            item.url
                                                        }
                                                        class="outline-none transition-colors hover:text-sky-700 focus-visible:text-sky-700"
                                                    >
                                                        {
                                                            item.title
                                                        }
                                                    </a>
                                                </h2>

                                                <p
                                                    class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600"
                                                >
                                                    {item.excerpt}
                                                </p>

                                                <a
                                                    href={item.url}
                                                    class="mt-auto pt-4 text-sm font-black text-sky-700 underline-offset-4 hover:underline"
                                                >
                                                    {copy.view} →
                                                </a>
                                            </div>
                                        </div>
                                    </article>
                                );
                            })}
                        </div>
                    )
                }

                {
                    items.length > 0 && (
                        <p
                            id="tauler-filter-empty"
                            hidden
                            class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600"
                        >
                            {copy.noFilteredResults}
                        </p>
                    )
                }
            </div>
        </section>
    </main>

    {
        items.length > 0 && (
            <script>
                const filterButtons = Array.from(
                    document.querySelectorAll(
                        "[data-tauler-filter]",
                    ),
                );

                const taulerItems = Array.from(
                    document.querySelectorAll(
                        "[data-tauler-item]",
                    ),
                );

                const emptyMessage =
                    document.getElementById(
                        "tauler-filter-empty",
                    );

                function setActiveFilter(filter) {
                    let visibleCount = 0;

                    taulerItems.forEach((item) => {
                        const matches =
                            filter === "all" ||
                            item.dataset.taulerType === filter;

                        item.hidden = !matches;

                        if (matches) {
                            visibleCount += 1;
                        }
                    });

                    filterButtons.forEach((button) => {
                        const active =
                            button.dataset.taulerFilter === filter;

                        button.setAttribute(
                            "aria-pressed",
                            String(active),
                        );

                        button.classList.toggle(
                            "bg-slate-950",
                            active,
                        );

                        button.classList.toggle(
                            "text-white",
                            active,
                        );

                        button.classList.toggle(
                            "border",
                            !active,
                        );

                        button.classList.toggle(
                            "border-slate-300",
                            !active,
                        );

                        button.classList.toggle(
                            "bg-white",
                            !active,
                        );

                        button.classList.toggle(
                            "text-slate-700",
                            !active,
                        );
                    });

                    if (emptyMessage) {
                        emptyMessage.hidden =
                            visibleCount !== 0;
                    }
                }

                filterButtons.forEach((button) => {
                    button.addEventListener(
                        "click",
                        () => {
                            setActiveFilter(
                                button.dataset
                                    .taulerFilter || "all",
                            );
                        },
                    );
                });
            </script>
        )
    }
</Layout>
