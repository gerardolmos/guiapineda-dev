---
import Layout from "../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../lib/api";
import { getStrapiMediaUrl } from "../lib/strapi";
import {
    buildTaulerItems,
    type TaulerItemType,
} from "../lib/tauler";

const [comunicatsData, milloresData] = await Promise.all([
    fetchAPI(endpoints.comunicats),
    fetchAPI(endpoints.millores),
]);

const items = buildTaulerItems({
    comunicats: comunicatsData.data || [],
    millores: milloresData.data || [],
    lang: "ca",
});

const typeLabels: Record<TaulerItemType, string> = {
    comunicat: "Comunicats",
    millora: "Millorem Pineda",
};

const typeClasses: Record<TaulerItemType, string> = {
    comunicat: "bg-violet-100 text-violet-800",
    millora: "bg-sky-100 text-sky-800",
};

function formatDate(value: string): string {
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);

    if (!match) {
        return value;
    }

    const [, year, month, day] = match;

    return new Intl.DateTimeFormat("ca-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "Europe/Madrid",
    }).format(
        new Date(
            Date.UTC(
                Number(year),
                Number(month) - 1,
                Number(day),
                12,
            ),
        ),
    );
}

function getItemImageUrl(image: unknown): string | null {
    if (!image || typeof image !== "object") {
        return null;
    }

    const url = (image as { url?: unknown }).url;

    if (typeof url !== "string" || url.trim().length === 0) {
        return null;
    }

    return getStrapiMediaUrl(url);
}

function getItemImageAlt(image: unknown, fallback: string): string {
    if (!image || typeof image !== "object") {
        return fallback;
    }

    const alternativeText = (image as {
        alternativeText?: unknown;
    }).alternativeText;

    if (
        typeof alternativeText === "string" &&
        alternativeText.trim().length > 0
    ) {
        return alternativeText.trim();
    }

    return fallback;
}
---

<Layout
    lang="ca"
    title="El Tauler | GUIAPINEDA"
    description="Les últimes aportacions publicades a GUIAPINEDA, reunides en un mateix espai."
>
    <main class="bg-stone-50">
        <section class="bg-slate-950 px-5 py-14 sm:px-8 sm:py-16">
            <div class="mx-auto max-w-6xl">
                <p
                    class="text-sm font-black uppercase tracking-[0.18em] text-sky-400"
                >
                    GUIAPINEDA
                </p>

                <h1
                    class="mt-3 text-5xl font-black tracking-tight text-white sm:text-6xl"
                >
                    El Tauler
                </h1>

                <p
                    class="mt-5 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl"
                >
                    Les últimes aportacions publicades a GUIAPINEDA, reunides en un mateix espai.
                </p>
            </div>
        </section>

        <div aria-hidden="true" class="grid h-1.5 grid-cols-6">
            <span class="bg-sky-500"></span>
            <span class="bg-fuchsia-500"></span>
            <span class="bg-amber-400"></span>
            <span class="bg-emerald-500"></span>
            <span class="bg-violet-500"></span>
            <span class="bg-cyan-500"></span>
        </div>

        <section class="px-5 py-10 sm:px-8 sm:py-14">
            <div class="mx-auto max-w-6xl">
                {
                    items.length === 0 ? (
                        <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600">
                            Encara no hi ha aportacions publicades.
                        </p>
                    ) : (
                        <div class="grid gap-5 md:grid-cols-2">
                            {items.map((item) => {
                                const imageUrl = getItemImageUrl(item.image);
                                const imageAlt = getItemImageAlt(
                                    item.image,
                                    item.title,
                                );

                                return (
                                    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                                        <div class="grid h-full grid-cols-[8rem_1fr] sm:grid-cols-[9.5rem_1fr]">
                                            {
                                                imageUrl ? (
                                                    <a
                                                        href={item.url}
                                                        class="block min-h-full bg-slate-200"
                                                    >
                                                        <img
                                                            src={imageUrl}
                                                            alt={imageAlt}
                                                            loading="lazy"
                                                            decoding="async"
                                                            class="h-full min-h-44 w-full object-cover"
                                                        />
                                                    </a>
                                                ) : (
                                                    <div
                                                        aria-hidden="true"
                                                        class="min-h-44 bg-stone-100"
                                                    />
                                                )
                                            }

                                            <div class="flex min-w-0 flex-col p-4 sm:p-5">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span
                                                        class:list={[
                                                            "rounded-full px-2.5 py-1 text-[0.68rem] font-black uppercase tracking-[0.08em]",
                                                            typeClasses[item.type],
                                                        ]}
                                                    >
                                                        {typeLabels[item.type]}
                                                    </span>

                                                    <time
                                                        datetime={item.date}
                                                        class="text-xs font-semibold text-slate-500"
                                                    >
                                                        {formatDate(item.date)}
                                                    </time>
                                                </div>

                                                <h2 class="mt-3 text-xl font-black leading-tight tracking-tight text-slate-950">
                                                    <a
                                                        href={item.url}
                                                        class="outline-none transition-colors hover:text-sky-700 focus-visible:text-sky-700"
                                                    >
                                                        {item.title}
                                                    </a>
                                                </h2>

                                                <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600">
                                                    {item.excerpt}
                                                </p>

                                                <a
                                                    href={item.url}
                                                    class="mt-auto pt-4 text-sm font-black text-sky-700 underline-offset-4 hover:underline"
                                                >
                                                    Veure aportació →
                                                </a>
                                            </div>
                                        </div>
                                    </article>
                                );
                            })}
                        </div>
                    )
                }
            </div>
        </section>
    </main>
</Layout>
