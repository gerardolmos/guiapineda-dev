---
import Layout from "../../layouts/Layout.astro";
import { fetchAPI, endpoints } from "../../lib/api";
import { getUpcomingAgendaItems } from "../../lib/agenda";
import { getStrapiMediaUrl } from "../../lib/strapi";

const agendaData = await fetchAPI(endpoints.agendas);

const events = getUpcomingAgendaItems(
    agendaData.data || [],
);

function formatDate(value: string): string {
    const [year, month, day] =
        value.split("-").map(Number);

    return new Intl.DateTimeFormat("ca-ES", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "Europe/Madrid",
    }).format(
        new Date(
            Date.UTC(year, month - 1, day, 12),
        ),
    );
}

function formatTime(value: unknown): string | null {
    if (typeof value !== "string") {
        return null;
    }

    const match = /^(\d{2}):(\d{2})/.exec(value);

    return match
        ? `${match[1]}:${match[2]}`
        : null;
}

function getImageUrl(image: unknown): string | null {
    if (!image || typeof image !== "object") {
        return null;
    }

    const url = (image as { url?: unknown }).url;

    if (
        typeof url !== "string" ||
        url.trim().length === 0
    ) {
        return null;
    }

    return getStrapiMediaUrl(url);
}
---

<Layout
    lang="ca"
    title="Agenda Oberta | GUIAPINEDA"
    description="Activitats i esdeveniments de Pineda de Mar compartits amb GUIAPINEDA."
>
    <main class="bg-stone-50">
        <section
            class="bg-emerald-950 px-5 py-14 sm:px-8 sm:py-16"
        >
            <div class="mx-auto max-w-6xl">
                <p
                    class="text-sm font-black uppercase tracking-[0.18em] text-emerald-300"
                >
                    GUIAPINEDA
                </p>

                <h1
                    class="mt-3 text-5xl font-black tracking-tight text-white sm:text-6xl"
                >
                    Agenda Oberta
                </h1>

                <p
                    class="mt-5 max-w-3xl text-lg leading-8 text-emerald-100 sm:text-xl"
                >
                    Activitats i esdeveniments que passen
                    a Pineda de Mar.
                </p>
            </div>
        </section>

        <div
            aria-hidden="true"
            class="grid h-1.5 grid-cols-6"
        >
            <span class="bg-sky-500"></span>
            <span class="bg-fuchsia-500"></span>
            <span class="bg-amber-400"></span>
            <span class="bg-emerald-500"></span>
            <span class="bg-violet-500"></span>
            <span class="bg-cyan-500"></span>
        </div>

        <section class="px-5 py-10 sm:px-8 sm:py-14">
            <div class="mx-auto max-w-6xl">
                {
                    events.length === 0 ? (
                        <p
                            class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-slate-600"
                        >
                            Ara mateix no hi ha activitats
                            properes publicades.
                        </p>
                    ) : (
                        <div class="grid gap-5 md:grid-cols-2">
                            {events.map((event: any) => {
                                const imageUrl =
                                    getImageUrl(event.imatge);

                                const startTime =
                                    formatTime(
                                        event.hora_inici,
                                    );

                                return (
                                    <article
                                        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
                                    >
                                        {
                                            imageUrl && (
                                                <img
                                                    src={imageUrl}
                                                    alt=""
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="aspect-[16/7] w-full object-cover"
                                                />
                                            )
                                        }

                                        <div class="p-5 sm:p-6">
                                            <p
                                                class="text-sm font-black text-emerald-700"
                                            >
                                                {
                                                    formatDate(
                                                        event.data_inici,
                                                    )
                                                }
                                                {
                                                    startTime &&
                                                        ` · ${startTime}`
                                                }
                                            </p>

                                            <h2
                                                class="mt-2 text-2xl font-black leading-tight tracking-tight text-slate-950"
                                            >
                                                {event.titol}
                                            </h2>

                                            <p
                                                class="mt-3 text-sm leading-6 text-slate-600"
                                            >
                                                {event.resum}
                                            </p>

                                            <div
                                                class="mt-5 border-t border-slate-200 pt-4 text-sm text-slate-600"
                                            >
                                                <p>
                                                    <strong
                                                        class="text-slate-900"
                                                    >
                                                        Lloc:
                                                    </strong>{" "}
                                                    {event.lloc}
                                                </p>

                                                <p class="mt-1">
                                                    <strong
                                                        class="text-slate-900"
                                                    >
                                                        Organitza:
                                                    </strong>{" "}
                                                    {
                                                        event.organitzador
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </article>
                                );
                            })}
                        </div>
                    )
                }
            </div>
        </section>
    </main>
</Layout>
