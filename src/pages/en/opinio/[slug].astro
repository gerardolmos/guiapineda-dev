---
import { fetchAPI, endpoints } from "../../../lib/api";
import OpinioArticlePage from "../../../templates/OpinioArticlePage.astro";

export async function getStaticPaths() {
    const opinionsData = await fetchAPI(endpoints.opinions);
    const opinions = opinionsData.data || [];

    return opinions
        .filter((opinio: any) => opinio.publicat)
        .map((opinio: any) => ({
            params: {
                slug: opinio.slug,
            },
            props: {
                opinio,
                lang: "en",
            },
        }));
}

const { opinio, lang } = Astro.props;
---

<OpinioArticlePage opinio={opinio} lang={lang} />
